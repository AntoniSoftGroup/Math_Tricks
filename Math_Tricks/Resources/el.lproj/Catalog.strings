"trick_square_number_between_100_and_109_rule" = "trick_square_number_between_100_and_109_rule";
"trick_square_number_between_100_and_109_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>10</font><font color=#7875fd>3</font><small><sup>2</sup></small> = 10609</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Προσθέστε το τελευταίο ψηφίο του αριθμού στον ίδιο τον αριθμό: <br><b><font color=#c27171>10</font><font color=#7875fd>3</font> + <font color=#7875fd>3</font> = <font color=#888800>106</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Υψώστε το τελευταίο ψηφίο του αριθμού στο τετράγωνο (αν το τετράγωνο είναι μονοψήφιος αριθμός τοποθετήστε το 0 αριστερά του): <br><b><font color=#7875fd>3</font><small><sup>2</sup></small> = 0<font color=#008800>9</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Τοποθετήστε το αποτέλεσμα του <font color=#666666><b>βήματος 2</b></font> δεξιά από το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font>: <br><b><font color=#888800>106</font>_0<font color=#008800>9</font> = 10609</b>";
"trick_square_number_between_100_and_109_text" = "Τετράγωνο αριθμού μεταξύ του 100 και του 109";
"trick_square_number_between_10_and_19_rule" = "trick_square_number_between_10_and_19_rule";
"trick_square_number_between_10_and_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1</font><font color=#7875fd>4</font><small><sup>2</sup></small> = 196</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Προσθέστε το τελευταίο ψηφίο του αριθμού στον ίδιο τον αριθμό: <br><b><font color=#c27171>1</font><font color=#7875fd>4</font> + <font color=#7875fd>4</font> = <font color=#008800>18</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Πολλαπλασιάστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> με το 10: <br><b><font color=#008800>18</font> × 10 = <font color=#888800>180</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Υψώστε το τελευταίο ψηφίο του αριθμού στο τετράγωνο: <br><b><font color=#7875fd>4</font><small><sup>2</sup></small> = <font color=#924bd7>16</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 4</b></font> - Αθροίστε το αποτέλεσμα του <font color=#666666><b>βήματος 2</b></font> και του <font color=#666666><b>βήματος 3</b></font>: <br><b><font color=#888800>180</font> + <font color=#924bd7>16</font> = 196</b>";
"trick_square_number_between_10_and_19_text" = "Τετράγωνο αριθμού μεταξύ του 10 και του 19";
"trick_square_number_between_11_and_99_rule" = "trick_square_number_between_11_and_99_rule";
"trick_square_number_between_11_and_99_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>97</font><small><sup>2</sup></small> = 9409</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Αφαιρέστε τον αριθμό από το 100: <br><b>100 - <font color=#c27171>97</font> = <font color=#7875fd>3</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Αφαιρέστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> από τον αρχικό αριθμό: <br><b><font color=#c27171>97</font> - <font color=#7875fd>3</font> = <font color=#008800>94</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Υψώστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> στο τετράγωνο (αν το τετράγωνο είναι μονοψήφιος αριθμός τοποθετήστε το 0 αριστερά του): <br><b><font color=#7875fd>3</font><small><sup>2</sup></small> = <font color=#924bd7>09</font></b>\n\t\t<br>\n        <br><font color=#666666><b>Βήμα 4</b></font> - Τοποθετήστε το αποτέλεσμα του <font color=#666666><b>βήματος 3</b></font> δεξιά από το αποτέλεσμα του <font color=#666666><b>βήματος 2</b></font>: <br><b><font color=#008800>94</font>_<font color=#924bd7>09</font> = 9409</b>";
"trick_square_number_between_11_and_99_text" = "Τετράγωνο αριθμού μεταξύ του 90 και του 99";
"trick_square_number_between_20_and_29_rule" = "trick_square_number_between_20_and_29_rule";
"trick_square_number_between_20_and_29_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>23</font><small><sup>2</sup></small> = 529</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - <b><font color=#c27171>23</font> = 20 + 3 => <font color=#008888>20</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - <b><font color=#c27171>23</font> = 20 + 3 => <font color=#7875fd>3</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Υψώστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> στο τετράγωνο: <br><b><font color=#008888>20</font><small><sup>2</sup></small> = <font color=#008800>400</font></b>\n\t\t<br>\n\t\t<br><font color=#666666><b>Βήμα 4</b></font> - Πολλαπλασιάστε το αποτέλεσμα του <font color=#666666><b>βήματος 2</b></font> με το 40: <br><b><font color=#7875fd>3</font> × 40 = <font color=#888800>120</font></b>\n\t\t<br>\t\t\n        <br><font color=#666666><b>Βήμα 5</b></font> - Υψώστε το αποτέλεσμα του <font color=#666666><b>βήματος 2</b></font> στο τετράγωνο: <br><b><font color=#7875fd>3</font><small><sup>2</sup></small> = <font color=#924bd7>9</font></b>\t\t\n\t\t<br>\n\t\t<br><font color=#666666><b>Βήμα 6</b></font> - Αθροίστε το αποτέλεσμα του <font color=#666666><b>βήματος 3</b></font> και του <font color=#666666><b>βήματος 4</b></font>: <br><b><font color=#008800>400</font> + <font color=#888800>120</font> = <font color=#aa7700>520</font></b>\n\t\t<br>\t\t\n        <br><font color=#666666><b>Βήμα 7</b></font> - Αθροίστε το αποτέλεσμα του <font color=#666666><b>βήματος 5</b></font> και του <font color=#666666><b>βήματος 6</b></font>: <br><b><font color=#aa7700>520</font> + <font color=#924bd7>9</font> = 529</b>";
"trick_square_number_between_20_and_29_text" = "Τετράγωνο αριθμού μεταξύ του 20 και του 29";
"trick_square_number_between_30_and_39_rule" = "trick_square_number_between_30_and_39_rule";
"trick_square_number_between_30_and_39_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>34</font><small><sup>2</sup></small> = 1156</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - <b><font color=#c27171>34</font> = 30 + 4 => <font color=#008888>30</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - <b><font color=#c27171>34</font> = 30 + 4 => <font color=#7875fd>4</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Υψώστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> στο τετράγωνο: <br><b><font color=#008888>30</font><small><sup>2</sup></small> = <font color=#008800>900</font></b>\n\t\t<br>\n\t\t<br><font color=#666666><b>Βήμα 4</b></font> - Πολλαπλασιάστε το αποτέλεσμα του <font color=#666666><b>βήματος 2</b></font> με το 60: <br><b><font color=#7875fd>4</font> × 60 = <font color=#888800>240</font></b>\n\t\t<br>\t\t\n        <br><font color=#666666><b>Βήμα 5</b></font> - Υψώστε το αποτέλεσμα του <font color=#666666><b>βήματος 2</b></font> στο τετράγωνο: <br><b><font color=#7875fd>4</font><small><sup>2</sup></small> = <font color=#924bd7>16</font></b>\t\t\n\t\t<br>\n\t\t<br><font color=#666666><b>Βήμα 6</b></font> - Αθροίστε το αποτέλεσμα του <font color=#666666><b>βήματος 3</b></font> και του <font color=#666666><b>βήματος 4</b></font>: <br><b><font color=#008800>900</font> + <font color=#888800>240</font> = <font color=#aa7700>1140</font></b>\n\t\t<br>\t\t\n        <br><font color=#666666><b>Βήμα 7</b></font> - Αθροίστε το αποτέλεσμα του <font color=#666666><b>βήματος 5</b></font> και του <font color=#666666><b>βήματος 6</b></font>: <br><b><font color=#aa7700>1140</font> + <font color=#924bd7>16</font> = 1156</b>";
"trick_square_number_between_30_and_39_text" = "Τετράγωνο αριθμού μεταξύ του 30 και του 39";
"trick_square_number_between_40_and_49_rule" = "trick_square_number_between_40_and_49_rule";
"trick_square_number_between_40_and_49_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>48</font><small><sup>2</sup></small> = 2304</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Αφαιρέστε τον αριθμό από το 50: <br><b>50 - <font color=#c27171>48</font> = <font color=#7875fd>2</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Αφαιρέστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> από το 25: <br><b>25 - <font color=#7875fd>2</font> = <font color=#888800>23</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Υψώστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> στο τετράγωνο (αν το τετράγωνο είναι μονοψήφιος αριθμός τοποθετήστε το 0 αριστερά του): <br><b><font color=#7875fd>2</font><small><sup>2</sup></small> = 0<font color=#008800>4</font></b>\n\t\t<br>\n        <br><font color=#666666><b>Βήμα 4</b></font> - Τοποθετήστε το αποτέλεσμα του <font color=#666666><b>βήματος 3</b></font> δεξιά από το αποτέλεσμα του <font color=#666666><b>βήματος 2</b></font>: <br><b><font color=#888800>23</font>_0<font color=#008800>4</font> = 2304</b>";
