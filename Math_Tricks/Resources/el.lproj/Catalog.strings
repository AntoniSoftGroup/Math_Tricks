"trick_multiply_by_025_rule" = "trick_multiply_by_025_rule";
"trick_multiply_by_025_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>20</font> × 0.25 = 5</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Διαιρέστε τον αριθμό με το 4: <br><b><font color=#c27171>20</font> / 4 = 5</b>";
"trick_multiply_by_025_text" = "Πολλαπλασιασμός με το 0.25";
"trick_multiply_by_02_rule" = "trick_multiply_by_02_rule";
"trick_multiply_by_02_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>125</font> × 0.2 = 25</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Διαιρέστε τον αριθμό με το 10: <br><b><font color=#c27171>125</font> / 10 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Πολλαπλασιάστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> με το 2: <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
"trick_multiply_by_02_text" = "Πολλαπλασιασμός με το 0.2";
"trick_multiply_by_05_rule" = "trick_multiply_by_05_rule";
"trick_multiply_by_05_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 0.5 = 9</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Διαιρέστε τον αριθμό με το 2: <br><b><font color=#c27171>18</font> / 2 = 9</b>";
"trick_multiply_by_05_text" = "Πολλαπλασιασμός με το 0.5";
"trick_multiply_by_11_2digit_rule" = "trick_multiply_by_11_2digit_rule";
"trick_multiply_by_11_2digit_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>3</font><font color=#7875fd>5</font> × 11 = 385</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Αθροίστε τα ψηφία του διψήφιου αριθμού: <br><b><font color=#c27171>3</font> + <font color=#7875fd>5</font> = <font color=#008800>8</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Τοποθετήστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> μεταξύ των ψηφίων του αριθμού: <br><b><font color=#c27171>3</font>_<font color=#008800>8</font>_<font color=#7875fd>5</font> = 385</b>\n        <br>\n        <br>\n        <br><b><u>-2-</u></b>\n        <br>\n        <br><b><font color=#c27171>7</font><font color=#7875fd>8</font> × 11 = 858</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Αθροίστε τα ψηφία του διψήφιου αριθμού: <br><b><font color=#c27171>7</font> + <font color=#7875fd>8</font> = <font color=#924bd7>1</font><font color=#aa7700>5</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Αν το αποτέλεσμα είναι μεγαλύτερο του 9, τότε προσθέστε το 1 στο πρώτο ψηφίο του αριθμού: <br><b><font color=#c27171>7</font> + <font color=#924bd7>1</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Τοποθετήστε το δεύτερο ψηφίο του αποτελέσματος μεταξύ των δύο ψηφίων: <br><b><font color=#888800>8</font>_<font color=#aa7700>5</font>_<font color=#7875fd>8</font> = 858</b>";
"trick_multiply_by_11_2digit_text" = "Πολλαπλασιασμός διψήφιου αριθμού με το 11";
"trick_multiply_by_125_rule" = "trick_multiply_by_125_rule";
"trick_multiply_by_125_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 125 = 3125</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Διαιρέστε τον αριθμό με το 8: <br><b><font color=#c27171>25</font> / 8 = <font color=#7875fd>3.125</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Πολλαπλασιάστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> με το 1000: <br><b><font color=#7875fd>3.125</font> × 1000 = 3125</b>";
"trick_multiply_by_125_text" = "Πολλαπλασιασμός με το 125";
"trick_multiply_by_12_rule" = "trick_multiply_by_12_rule";
"trick_multiply_by_12_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>12</font> = 192</b>\n        <br>\n        <br><b><font color=#888800>12</font> = <font color=#7875fd>10</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Πολλαπλασιάστε τον αριθμό με το 10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Πολλαπλασιάστε τον αριθμό με το 2: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#924bd7>32</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Αθροίστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> και του <font color=#666666><b>βήματος 2</b></font>: <br><b><font color=#aa7700>160</font> + <font color=#924bd7>32</font> = 192</b>";
"trick_multiply_by_12_text" = "Πολλαπλασιασμός με το 12";
"trick_multiply_by_13_rule" = "trick_multiply_by_13_rule";
"trick_multiply_by_13_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>13</font> = 208</b>\n        <br>\n        <br><b><font color=#888800>13</font> = <font color=#7875fd>10</font> + <font color=#008800>3</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Πολλαπλασιάστε τον αριθμό με το 10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Πολλαπλασιάστε τον αριθμό με το 3: <br><b><font color=#c27171>16</font> × <font color=#008800>3</font> = <font color=#924bd7>48</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Αθροίστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> και του <font color=#666666><b>βήματος 2</b></font>: <br><b><font color=#aa7700>160</font> + <font color=#924bd7>48</font> = 208</b>";
"trick_multiply_by_13_text" = "Πολλαπλασιασμός με το 13";
"trick_multiply_by_14_rule" = "trick_multiply_by_14_rule";
"trick_multiply_by_14_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>14</font> = 224</b>\n        <br>\n        <br><b><font color=#888800>14</font> = <font color=#7875fd>10</font> + <font color=#008800>4</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Πολλαπλασιάστε τον αριθμό με το 10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Πολλαπλασιάστε τον αριθμό με το 4: <br><b><font color=#c27171>16</font> × <font color=#008800>4</font> = <font color=#924bd7>64</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Αθροίστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> και του <font color=#666666><b>βήματος 2</b></font>: <br><b><font color=#aa7700>160</font> + <font color=#924bd7>64</font> = 224</b>";
"trick_multiply_by_14_text" = "Πολλαπλασιασμός με το 14";
"trick_multiply_by_15_rule" = "trick_multiply_by_15_rule";
"trick_multiply_by_15_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 15 = 540</b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Πολλαπλασιάστε τον αριθμό με το 10: <br><b><font color=#c27171>36</font> × 10 = <font color=#7875fd>360</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Διαιρέστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> με το 2: <br><b><font color=#7875fd>360</font> / 2 = <font color=#008800>180</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Αθροίστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font> και του <font color=#666666><b>βήματος 2</b></font>: <br><b><font color=#7875fd>360</font> + <font color=#008800>180</font> = 540</b>";
"trick_multiply_by_15_text" = "Πολλαπλασιασμός με το 15";
"trick_multiply_by_16_rule" = "trick_multiply_by_16_rule";
"trick_multiply_by_16_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>16</font> = 224</b>\n        <br>\n        <br><b><font color=#7875fd>16</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>1</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Πολλαπλασιάστε τον αριθμό με το 10: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Πολλαπλασιάστε τον αριθμό με το 5: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Πολλαπλασιάστε τον αριθμό με το 1: <br><b><font color=#c27171>14</font> × <font color=#b265cf>1</font> = <font color=#c27171>14</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 4</b></font> - Αθροίστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font>, του <font color=#666666><b>βήματος 2</b></font> και του <font color=#666666><b>βήματος 3</b></font>: <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#c27171>14</font> = 224</b>";
"trick_multiply_by_16_text" = "Πολλαπλασιασμός με το 16";
"trick_multiply_by_17_rule" = "trick_multiply_by_17_rule";
"trick_multiply_by_17_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>17</font> = 238</b>\n        <br>\n        <br><b><font color=#7875fd>17</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>2</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Πολλαπλασιάστε τον αριθμό με το 10: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Πολλαπλασιάστε τον αριθμό με το 5: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Πολλαπλασιάστε τον αριθμό με το 2: <br><b><font color=#c27171>14</font> × <font color=#b265cf>2</font> = <font color=#008888>28</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 4</b></font> - Αθροίστε το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font>, του <font color=#666666><b>βήματος 2</b></font> και του <font color=#666666><b>βήματος 3</b></font>: <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#008888>28</font> = 238</b>";
"trick_multiply_by_17_text" = "Πολλαπλασιασμός με το 17";
"trick_multiply_by_18_rule" = "trick_multiply_by_18_rule";
