"trick_multiply_by_18_text" = "Πολλαπλασιασμός με το 18";
"trick_multiply_by_19_rule" = "trick_multiply_by_19_rule";
"trick_multiply_by_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>19</font> = 304</b>\n        <br>\n        <br><b><font color=#888800>19</font> = <font color=#7875fd>20</font> - <font color=#aa7700>1</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 1</b></font> - Πολλαπλασιάστε τον αριθμό με το 20: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 2</b></font> - Πολλαπλασιάστε τον αριθμό με το 1: <br><b><font color=#c27171>16</font> × <font color=#aa7700>1</font> = <font color=#924bd7>16</font></b>\n        <br>\n        <br><font color=#666666><b>Βήμα 3</b></font> - Αφαιρέστε το αποτέλεσμα του <font color=#666666><b>βήματος 2</b></font> από το αποτέλεσμα του <font color=#666666><b>βήματος 1</b></font>: <br><b><font color=#008888>320</font> - <font color=#924bd7>16</font> = 304</b>";
"trick_multiply_by_19_text" = "Πολλαπλασιασμός με το 19";
"trick_multiply_by_20_rule" = "trick_multiply_by_20_rule";
