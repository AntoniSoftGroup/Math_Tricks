"trick_addition_rule_text" = "-1";
"trick_addition_text" = "جمع";
"trick_dividing_by_025_rule" = "trick_dividing_by_025_rule";
"trick_dividing_by_025_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>20</font> / 0.25 = 80</b>\n        <br>\n        <br><font color=#666666><b>گام 1</b></font> -<br>عدد را در 4 ضرب کنید:<br><b><font color=#c27171>20</font> × 4 = 80</b>";
"trick_dividing_by_025_text" = "تقسیم به  0.25";
"trick_dividing_by_02_rule" = "trick_dividing_by_02_rule";
"trick_dividing_by_02_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> / 0.2 = 90</b>\n        <br>\n        <br><font color=#666666><b>گام 1</b></font> -<br>عدد را بر 2 تقسیم کنید:<br><b><font color=#c27171>18</font> / 2 = <font color=#7875fd>9</font></b>\n        <br>\n        <br><font color=#666666><b>گام 2</b></font> -<br>عدد حاصل از <font color=#666666><b>گام 1</b></font> را در 10 ضرب کنید:<br><b><font color=#7875fd>9</font> × 10 = 90</b>";
"trick_dividing_by_02_text" = "تقسیم به  0.2";
"trick_dividing_by_05_rule" = "trick_dividing_by_05_rule";
