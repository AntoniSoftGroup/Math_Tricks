"trick_05_percent_rule" = "trick_05_percent_rule";
"trick_05_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>0.5</font>% → <font color=#7875fd>600</font> = 3</b>\n        <br>\n        <br><font color=#666666><b>گام 1</b></font> -<br>عدد را بر 100 تقسیم کنید:<br><b><font color=#7875fd>600</font> / 100 = <font color=#008800>6</font></b>\n        <br>\n        <br><font color=#666666><b>گام 2</b></font> -<br>عدد حاصل از <font color=#666666><b>گام 1</b></font> بر 2 تقسیم کنید:<br><b><font color=#008800>6</font> / 2 = 3";
"trick_05_percent_text" = "0.5% \\u200F";
"trick_150_percent_rule" = "trick_150_percent_rule";
"trick_150_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>150</font>% → <font color=#888800>60</font> = 90</b>\n        <br><b><font color=#c27171>150</font>% = <font color=#7875fd>100</font>% + <font color=#008800>50</font>%</b>\n        <br>\n        <br><font color=#666666><b>گام 1</b></font> -<br><b><font color=#7875fd>100</font>% → <font color=#888800>60</font> = <font color=#6a379a>60</font></b>\n        <br>\n        <br><font color=#666666><b>گام 2</b></font> -<br><b><font color=#008800>50</font>% = <font color=#7875fd>100</font>% / <font color=#aa7700>2</font></b>\n        <br>عدد را به 2 تقسیک کنید:<br><b><font color=#6a379a>60</font> / <font color=#aa7700>2</font> = <font color=#008888>30</font></b>\n        <br>\n        <br><font color=#666666><b>گام 3</b></font> -<br>عدد حاصل از <font color=#666666><b>گام 1</b></font> را با <font color=#666666><b>گام 2</b></font> جمع کنید:<br><b><font color=#6a379a>60</font> + <font color=#008888>30</font> = 90</b>";
"trick_150_percent_text" = "150% \\u200F";
"trick_15_percent_rule" = "trick_15_percent_rule";
"trick_15_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>15</font>% → <font color=#7875fd>60</font> = 9</b>\n        <br>\n        <br><font color=#666666><b>گام 1</b></font> -<br>عدد را بر 10 تقسیم کنید:<br><b><font color=#7875fd>60</font> / 10 = <font color=#008800>6</font></b>\n        <br>\n        <br><font color=#666666><b>گام 2</b></font> -<br>عدد حاصل از <font color=#666666><b>گام 1</b></font> به 2 تقسیم کنید:<br><b><font color=#008800>6</font> / 2 = <font color=#888800>3</font></b>\n        <br>\n        <br><font color=#666666><b>گام 3</b></font> -<br>عدد حاصل از <font color=#666666><b>گام 1</b></font> را با <font color=#666666><b>گام 2</b></font> جمع کنید:<br><b><font color=#008800>6</font> + <font color=#888800>3</font> = 9</b>";
"trick_15_percent_text" = "15% \\u200F";
"trick_200_percent_rule" = "trick_200_percent_rule";
