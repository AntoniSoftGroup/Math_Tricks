"trick_dividing_by_7_text" = "تقسیم به  7";
"trick_dividing_by_8_rule" = "trick_dividing_by_8_rule";
"trick_dividing_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>128</font> / <font color=#7875fd>8</font> = 16</b>\n        <br>\n        <br><b><font color=#7875fd>8</font> = <font color=#008800>2</font> × <font color=#888800>2</font> × <font color=#6a379a>2</font></b>\n        <br>\n        <br><font color=#666666><b>1 گام</b></font> - <br>عدد را بر 2 تقسیم کنید: <br><b><font color=#c27171>128</font> / <font color=#008800>2</font> = <font color=#aa7700>64</font></b>\n        <br>\n        <br><font color=#666666><b>2 گام</b></font> - <br>عدد حاصل از <font color=#666666><b>گام 1</b></font> را بر 2 تقسیم کنید: <br><b><font color=#aa7700>64</font> / <font color=#888800>2</font> = <font color=#008888>32</font></b>\n        <br>\n        <br><font color=#666666><b>3 گام</b></font> - <br>عدد حاصل از <font color=#666666><b>گام 2</b></font> را بر 2 تقسیم کنید: <br><b><font color=#008888>32</font> / <font color=#6a379a>2</font> = 16";
