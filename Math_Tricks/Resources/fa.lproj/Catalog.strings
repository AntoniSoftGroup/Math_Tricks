"trick_500_percent_rule" = "trick_500_percent_rule";
"trick_500_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>500</font>% → <font color=#7875fd>64</font> = 320</b>\n        <br>\n        <br><font color=#666666><b>1 گام</b></font> - <br><b><font color=#c27171>500</font>% = 100% × <font color=#008800>5</font></b>\n        <br>\n        <br><font color=#666666><b>2 گام</b></font> - <br>عدد را در 5 ضرب کنید: <br><b><font color=#7875fd>64</font> × <font color=#008800>5</font> = 320</b>";
