"trick_50_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>50</font>% → <font color=#7875fd>64</font> = 32</b>\n        <br>\n        <br><font color=#666666><b>گام 1</b></font> -<br><b><font color=#c27171>50</font>% = 100% / <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>گام 2</b></font> -<br>عدد را به 2 تقسیم کنید:<br><b><font color=#7875fd>64</font> / <font color=#008800>2</font> = 32</b>";
