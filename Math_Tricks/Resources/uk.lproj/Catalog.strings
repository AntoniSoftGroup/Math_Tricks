"trick_20_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>20</font>% → <font color=#7875fd>255</font> = 51</b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - <b><font color=#c27171>20</font>% = 100% / <font color=#008800>5</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - <b><font color=#7875fd>255</font> / <font color=#008800>5</font> = 51</b>\n        <br>\n        <br><font color=#666666><b>Крок 3</b></font> - <b><font color=#008800>5</font> = <font color=#aa7700>10</font> / <font color=#6a379a>2</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 4</b></font> - Розділіть вихідне число на 10: <br><b><font color=#7875fd>255</font> / <font color=#aa7700>10</font> = <font color=#888800>25.5</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 5</b></font> - Помножте результат 4 кроку на 2: <br><b><font color=#888800>25.5</font> × <font color=#6a379a>2</font> = 51</b>\n        <br>\n        <br>\n        <b><u>-2-</u></b>\n        <br>\n        <br><b><font color=#c27171>2</font>0% → <font color=#7875fd>255</font> = 51</b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - Розділіть вихідне число на 10: <br><b>10% → <font color=#7875fd>255</font> = <font color=#7875fd>255</font> / 10 = <font color=#888800>25.5</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - Помножте результат 1 кроку на 2: <br><b><font color=#888800>25.5</font> × <font color=#c27171>2</font> = 51</b>";
"trick_20_percent_text" = "20%";
"trick_250_percent_rule" = "trick_250_percent_rule";
