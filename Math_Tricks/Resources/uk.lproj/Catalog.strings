"trick_dividing_by_40_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1280</font> / 40 = 32</b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - Розділіть вихідне число на 10: <br><b><font color=#c27171>1280</font> / 10 = <font color=#7875fd>128</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - Розділіть результат першого кроку на 4: <br><b><font color=#7875fd>128</font> / 4 = 32</b>";
"trick_dividing_by_40_text" = "Поділ на 40";
"trick_dividing_by_4_rule" = "trick_dividing_by_4_rule";
"trick_dividing_by_4_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>64</font> / 4 = 16</b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - Розділіть вихідне число на 2: <br><b><font color=#c27171>64</font> / 2 = <font color=#7875fd>32</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - Розділіть результат першого кроку на 2: <br><b><font color=#7875fd>32</font> / 2 = 16</b>";
"trick_dividing_by_4_text" = "Поділ на 4";
"trick_dividing_by_50_rule" = "trick_dividing_by_50_rule";
"trick_dividing_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1250</font> / 50 = 25</b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - Розділіть вихідне число на 100: <br><b><font color=#c27171>1250</font> / 100 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - Помножте результат першого кроку на 2: <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
"trick_dividing_by_50_text" = "Поділ на 50";
"trick_dividing_by_5_rule" = "trick_dividing_by_5_rule";
"trick_dividing_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1235</font> / 5 = 247</b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - Розділіть вихідне число на 10: <br><b><font color=#c27171>1235</font> / 10 = <font color=#7875fd>123.5</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - Помножте результат першого кроку на 2: <br><b><font color=#7875fd>123.5</font> × 2 = 247</b>";
"trick_dividing_by_5_text" = "Поділ на 5";
"trick_dividing_by_6_rule" = "trick_dividing_by_6_rule";
"trick_dividing_by_6_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>126</font> / <font color=#7875fd>6</font> = 21</b>\n        <br>\n        <br><b><font color=#7875fd>6</font> = <font color=#008800>3</font> × <font color=#888800>2</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - Розділіть вихідне число на 2: <br><b><font color=#c27171>126</font> / <font color=#888800>2</font> = <font color=#aa7700>63</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - Розділіть результат першого кроку на 3: <br><b><font color=#aa7700>63</font> / <font color=#008800>3</font> = 21";
"trick_dividing_by_6_text" = "Поділ на 6";
"trick_dividing_by_7_rule" = "trick_dividing_by_7_rule";
"trick_dividing_by_7_rule_text" = "-1";
"trick_dividing_by_7_text" = "Поділ на 7";
"trick_dividing_by_8_rule" = "trick_dividing_by_8_rule";
"trick_dividing_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>128</font> / <font color=#7875fd>8</font> = 16</b>\n        <br>\n        <br><b><font color=#7875fd>8</font> = <font color=#008800>2</font> × <font color=#888800>2</font> × <font color=#6a379a>2</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - Розділіть вихідне число на 2: <br><b><font color=#c27171>128</font> / <font color=#008800>2</font> = <font color=#aa7700>64</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - Розділіть результат 1 кроку на 2: <br><b><font color=#aa7700>64</font> / <font color=#888800>2</font> = <font color=#008888>32</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 3</b></font> - Розділіть результат 2 кроку на 2: <br><b><font color=#008888>32</font> / <font color=#6a379a>2</font> = 16";
"trick_dividing_by_8_text" = "Поділ на 8";
"trick_dividing_by_9_rule" = "trick_dividing_by_9_rule";
"trick_dividing_by_9_rule_text" = "-1";
