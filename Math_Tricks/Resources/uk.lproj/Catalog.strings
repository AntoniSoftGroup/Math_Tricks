"trick_75_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>75</font>% → <font color=#7875fd>64</font> = 48</b>\n        <br>\n        <br><b><font color=#c27171>75</font>% = (100% / <font color=#008800>4</font>) × <font color=#aa7700>3</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - Розділіть вихідне число на 4: <br><b><font color=#7875fd>64</font> / <font color=#008800>4</font> = <font color=#924bd7>16</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - Помножте результат першого кроку на 3: <br><b><font color=#924bd7>16</font> × <font color=#aa7700>3</font> = 48</b>";
