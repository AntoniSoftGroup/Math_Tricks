"trick_multiply_by_500_rule" = "trick_multiply_by_500_rule";
"trick_multiply_by_500_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 500 = 12500</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Teilen Sie die Zahl durch 2: <br><b><font color=#c27171>25</font> / 2 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Multiplizieren Sie das Ergebnis des <font color=#666666><b>ersten Schrittes</b></font> mit 1000: <br><b><font color=#7875fd>12.5</font> × 1000 = 12500</b>";
"trick_multiply_by_500_text" = "Mit 500 multiplizieren";
"trick_multiply_by_50_rule" = "trick_multiply_by_50_rule";
"trick_multiply_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 50 = 900</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Teilen Sie die Zahl durch 2: <br><b><font color=#c27171>18</font> / 2 = <font color=#7875fd>9</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Multiplizieren Sie das Ergebnis des <font color=#666666><b>ersten Schrittes</b></font> mit 100: <br><b><font color=#7875fd>9</font> × 100 = 900</b>";
"trick_multiply_by_50_text" = "Mit 50 multiplizieren";
"trick_multiply_by_5_rule" = "trick_multiply_by_5_rule";
"trick_multiply_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1234</font> × 5 = 6170</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Teilen Sie die Zahl durch 2: <br><b><font color=#c27171>1234</font> / 2 = <font color=#7875fd>617</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Multiplizieren Sie das Ergebnis des <font color=#666666><b>ersten Schrittes</b></font> mit 10: <br><b><font color=#7875fd>617</font> × 10 = 6170</b>";
"trick_multiply_by_5_text" = "Mit 5 multiplizieren";
"trick_multiply_by_6_rule" = "trick_multiply_by_6_rule";
"trick_multiply_by_6_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>6</font> = 96</b>\n        <br>\n        <br><b><font color=#888800>6</font> = 5 + 1 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>1</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Teilen Sie die Zahl durch 2: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Multiplizieren Sie das Ergebnis des <font color=#666666><b>ersten Schrittes</b></font> mit 10: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 3</b></font> - Multiplizieren Sie die Zahl mit 1: <br><b><font color=#c27171>16</font> × <font color=#008800>1</font> = <font color=#c27171>16</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 4</b></font> - Addieren Sie die Ergebnisse des <font color=#666666><b>zweiten</b></font> und <font color=#666666><b>dritten Schrittes</b></font>: <br><b><font color=#008888>80</font> + <font color=#c27171>16</font> = 96</b>";
"trick_multiply_by_6_text" = "Mit 6 multiplizieren";
"trick_multiply_by_750_rule" = "trick_multiply_by_750_rule";
"trick_multiply_by_750_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 750 = 18750</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Teilen Sie die Zahl durch 4: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Multiplizieren Sie das Ergebnis des <font color=#666666><b>ersten Schrittes</b></font> mit 3: <br><b><font color=#7875fd>6.25</font> × 3 = <font color=#aa7700>18.75</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 3</b></font> - Multiplizieren Sie das Ergebnis des <font color=#666666><b>2 Schrittes</b></font> mit 1000: <br><b><font color=#aa7700>18.75</font> × 1000 = 18750</b>";
"trick_multiply_by_750_text" = "Mit 750 multiplizieren";
"trick_multiply_by_75_rule" = "trick_multiply_by_75_rule";
"trick_multiply_by_75_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>68</font> × 75 = 5100</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Teilen Sie die Zahl durch 4: <br><b><font color=#c27171>68</font> / 4 = <font color=#7875fd>17</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Multiplizieren Sie das Ergebnis des <font color=#666666><b>ersten Schrittes</b></font> mit 3: <br><b><font color=#7875fd>17</font> × 3 = <font color=#aa7700>51</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 3</b></font> - Multiplizieren Sie das Ergebnis des <font color=#666666><b>2 Schrittes</b></font> mit 100: <br><b><font color=#aa7700>51</font> × 100 = 5100</b>";
"trick_multiply_by_75_text" = "Mit 75 multiplizieren";
"trick_multiply_by_7_rule" = "trick_multiply_by_7_rule";
"trick_multiply_by_7_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>7</font> = 112</b>\n        <br>\n        <br><b><font color=#888800>7</font> = 5 + 2 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Teilen Sie die Zahl durch 2: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Multiplizieren Sie das Ergebnis des <font color=#666666><b>1 Schrittes</b></font> mit 10: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 3</b></font> - Multiplizieren Sie die Grundzahl mit 2: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#8c6745>32</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 4</b></font> - Addieren Sie die Ergebnisse des <font color=#666666><b>zweiten</b></font> und <font color=#666666><b>dritten Schrittes</b></font>: <br><b><font color=#008888>80</font> + <font color=#8c6745>32</font> = 112</b>";
"trick_multiply_by_7_text" = "Mit 7 multiplizieren";
"trick_multiply_by_8_rule" = "trick_multiply_by_8_rule";
"trick_multiply_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>8</font> = 128</b>\n        <br>\n        <br><b><font color=#888800>8</font> = <font color=#7875fd>10</font> - <font color=#aa7700>2</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Multiplizieren Sie die Zahl mit 10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#008888>160</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Multiplizieren Sie die Zahl mit 2: <br><b><font color=#c27171>16</font> × <font color=#aa7700>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 3</b></font> - Ziehen Sie das Ergebnis des <font color=#666666><b>2 Schrittes</b></font> von dem <font color=#666666><b>1 Schrittes</b></font> ab: <br><b><font color=#008888>160</font> - <font color=#6a379a>32</font> = 128</b>";
"trick_multiply_by_8_text" = "Mit 8 multiplizieren";
"trick_multiply_by_999_rule" = "trick_multiply_by_999_rule";
"trick_multiply_by_999_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 999 = 24975</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Multiplizieren Sie die Grundzahl mit 1000: <br><b><font color=#c27171>25</font> × 1000 = <font color=#7875fd>25000</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Subtrahieren Sie die Zahl von dem Ergebnis des <font color=#666666><b>ersten Schrittes</b></font>: <br><b><font color=#7875fd>25000</font> - <font color=#c27171>25</font> = 24975</b>";
"trick_multiply_by_999_text" = "Mit 999 multiplizieren";
"trick_multiply_by_99_rule" = "trick_multiply_by_99_rule";
"trick_multiply_by_99_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>15</font> × 99 = 1485</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Multiplizieren Sie die Zahl mit 100: <br><b><font color=#c27171>15</font> × 100 = <font color=#7875fd>1500</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Subtrahieren Sie die Zahl von dem Ergebnis des <font color=#666666><b>ersten Schrittes</b></font>: <br><b><font color=#7875fd>1500</font> - <font color=#c27171>15</font> = 1485</b>";
"trick_multiply_by_99_text" = "Mit 99 multiplizieren";
"trick_multiply_by_9_rule" = "trick_multiply_by_9_rule";
"trick_multiply_by_9_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>56</font> × 9 = 504</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Multiplizieren Sie die Zahl mit 10: <br><b><font color=#c27171>56</font> × 10 = <font color=#7875fd>560</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Ziehen Sie die Zahl von dem Ergebnis des <font color=#666666><b>ersten Schrittes</b></font> ab: <br><b><font color=#7875fd>560</font> - <font color=#c27171>56</font> = 504</b>";
"trick_multiply_by_9_text" = "Mit 9 multiplizieren";
"trick_multiply_numbers_between_11_and_19_rule" = "trick_multiply_numbers_between_11_and_19_rule";
"trick_multiply_numbers_between_11_and_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>1<font color=#c27171>4</font> × <font color=#7875fd>1</font><font color=#008800>8</font> = 252</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Addieren Sie die größte Zahl mit dem rechten Ziffer der anderen Zahl: <br><b><font color=#7875fd>1</font><font color=#008800>8</font> + <font color=#c27171>4</font> = <font color=#6a379a>22</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Setzen Sie 0 am Ende des Ergebnis des <font color=#666666><b>ersten Schrittes</b></font>: <br><b><font color=#6a379a>22</font> × 10 = <font color=#888800>220</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 3</b></font> - Multiplizieren Sie die rechten Ziffern beider Zahlen miteinander: <br><b><font color=#008800>8</font> x <font color=#c27171>4</font> = <font color=#aa7700>32</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 4</b></font> - Addieren Sie die Ergebnisse des <font color=#666666><b>2</b></font> und <font color=#666666><b>3 Schrittes</b></font>: <br><b><font color=#888800>220</font> + <font color=#aa7700>32</font> = 252</b>";
"trick_multiply_numbers_between_11_and_19_text" = "Multiplikation der Zahlen zwischen 11 und 19";
"trick_multiply_two_digit_numbers_editing_in_1_rule" = "trick_multiply_two_digit_numbers_editing_in_1_rule";
"trick_multiply_two_digit_numbers_editing_in_1_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>5</font>1 × <font color=#7875fd>3</font>1 = 1581</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Multiplizieren Sie die ersten ZIffern der Faktoren: <br><b><font color=#c27171>5</font> × <font color=#7875fd>3</font> = <font color=#008800>15</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Addieren Sie erste Ziffern der Faktoren: <br><b><font color=#c27171>5</font> + <font color=#7875fd>3</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 3</b></font> - Setzen Sie das Ergebnis des <font color=#666666><b>zweiten Schrittes</b></font> rechts von dem Ergebnis des <font color=#666666><b>ersten Schrittes</b></font>: <br><b><font color=#008800>15</font>_<font color=#888800>8</font> = 158</b>\n        <br>\n        <br><font color=#666666><b>Schritt 4</b></font> - Schreiben Sie 1 am Ende des Ergebnisses des <font color=#666666><b>dritten Schrittes</b></font>: <br><b><font color=#008800>15</font>_<font color=#888800>8</font>_1 = 1581</b>";
"trick_multiply_two_digit_numbers_editing_in_1_text" = "Multiplikation zweier zweistelligen Zahlen, die mit 1 enden";
"trick_multiply_two_digit_numbers_having_same_tens_rule" = "trick_multiply_two_digit_numbers_having_same_tens_rule";
"trick_multiply_two_digit_numbers_having_same_tens_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>2</font><font color=#7875fd>3</font> × <font color=#c27171>2</font><font color=#008800>7</font> = 621</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Multiplizieren Sie die erste Ziffer mit dem ersten Ziffer plus 1: <br><b><font color=#c27171>2</font> × (<font color=#c27171>2</font> + 1) = <font color=#6a379a>6</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Multiplizieren Sie die rechten Ziffern der Zahlen miteinander (ist das Ergebnis nur eine Ziffer, setzen Sie eine 0 vor): <br><b><font color=#7875fd>3</font> × <font color=#008800>7</font> = <font color=#888800>21</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 3</b></font> - Setzen Sie das Ergebnis des <font color=#666666><b>zweiten Schrittes</b></font> rechts von dem Ergebnis des <font color=#666666><b>ersten Schrittes</b></font>: <br><b><font color=#6a379a>6</font>_<font color=#888800>21</font> = 621</b>";
"trick_multiply_two_digit_numbers_having_same_tens_text" = "Multiplikation der zweistelligen Zahlen, die die gleiche Ziffer in der Zehnerstelle haben, und deren Ziffern von der Einerstelle in der Summe 10 ergeben";
"trick_percent_2_rule" = "trick_percent_2_rule";
"trick_percent_2_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>6</font>% → 350 = 21</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - <font color=#c27171>6</font>% von 100, = <b><font color=#c27171>6</font></b> (<font color=#c27171>6</font> pro Hundert)\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - <font color=#c27171>6</font>% von 300, = <b><font color=#6a379a>18</font></b> (multiplizieren das Ergebnis des <font color=#666666><b>ersten Schrittes</b></font> mit <font color=#7875fd>3</font>)\n        <br>\n        <br><i>[100 × <font color=#7875fd>3</font> = 300] → [<font color=#c27171>6</font> × <font color=#7875fd>3</font> = <font color=#6a379a>18</font>]</i>\n        <br>\n        <br><font color=#666666><b>Schritt 3</b></font> - <font color=#c27171>6</font>% von 50, = <b><font color=#aa7700>3</font></b> (Teilen Sie das Ergebnis des <font color=#666666><b>ersten Schrittes</b></font> durch <font color=#888800>2</font>)\n        <br>\n        <br><i>[100 / <font color=#888800>2</font> = 50] → [<font color=#c27171>6</font> / <font color=#888800>2</font> = <font color=#aa7700>3</font>]</i>\n        <br>\n        <br><font color=#666666><b>Schritt 4</b></font> - Addieren Sie die Ergebnisse des <font color=#666666><b>zweiten</b></font> und <font color=#666666><b>dritten Schrittes</b></font>: <br><b><font color=#6a379a>18</font> + <font color=#aa7700>3</font> = 21</b>";
"trick_percent_2_text" = "Die Durchrechnung des Teegeldes -2-";
"trick_percent_rule" = "trick_percent_rule";
"trick_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>15% → <font color=#c27171>300</font> = 45</b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Rechnen Sie 10% (Teilen Sie die Zahl durch 10): <br><b><font color=#c27171>300</font> / 10 = <font color=#7875fd>30</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Rechnen Sie 5% (Teilen Sie das Ergebnis des <font color=#666666><b>ersten Schrittes</b></font> durch 2): <br><b><font color=#7875fd>30</font> / 2 = <font color=#008800>15</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 3</b></font> - Addieren Sie die Ergebnisse des <font color=#666666><b>ersten</b></font> und <font color=#666666><b>zweiten Schrittes</b></font>: <br><b><font color=#7875fd>30</font> + <font color=#008800>15</font> = 45</b>";
"trick_percent_text" = "Die Durchrechnung des Teegeldes -1-";
