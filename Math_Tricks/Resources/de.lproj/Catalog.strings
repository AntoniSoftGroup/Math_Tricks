"trick_power_2_between_1000_and_9999_rule_text" = "-1";
"trick_power_2_between_1000_and_9999_text" = "<b>a</b><sup><small>2</small></sup><br><small><i>a = 1000 ~ 9999</i></small>";
"trick_power_2_between_100_and_999_rule" = "trick_power_2_between_100_and_999_rule";
