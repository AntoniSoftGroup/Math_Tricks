"trick_power_2_between_100_and_999_text" = "<b>a</b><sup><small>2</small></sup><br><small><i>a = 100 ~ 999</i></small>";
"trick_power_2_rule" = "trick_power_2_rule";
"trick_power_2_rule_text" = "-1";
"trick_power_2_text" = "<b>a</b><sup><small>2</small></sup><br><small><i>a = 10 ~ 99</i></small>";
