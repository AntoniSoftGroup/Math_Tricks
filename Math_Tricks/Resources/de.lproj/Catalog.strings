"trick_dividing_by_7_text" = "Division durch 7";
"trick_dividing_by_8_rule" = "trick_dividing_by_8_rule";
"trick_dividing_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>128</font> / <font color=#7875fd>8</font> = 16</b>\n        <br>\n        <br><b><font color=#7875fd>8</font> = <font color=#008800>2</font> × <font color=#888800>2</font> × <font color=#6a379a>2</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 1</b></font> - Teilen Sie die Zahl durch 2: <br><b><font color=#c27171>128</font> / <font color=#008800>2</font> = <font color=#aa7700>64</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 2</b></font> - Teilen Sie das Ergebnis des <font color=#666666><b>ersten Schrittes</b></font> durch 2: <br><b><font color=#aa7700>64</font> / <font color=#888800>2</font> = <font color=#008888>32</font></b>\n        <br>\n        <br><font color=#666666><b>Schritt 3</b></font> - Teilen Sie das Ergebnis des <font color=#666666><b>zweiten Schrittes</b></font> durch 2: <br><b><font color=#008888>32</font> / <font color=#6a379a>2</font> = 16";
