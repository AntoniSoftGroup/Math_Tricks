"trick_square_numbers_editing_in_25_rule" = "trick_square_numbers_editing_in_25_rule";
"trick_square_numbers_editing_in_25_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>325</font><small><sup>2</sup></small> = 105625</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - <b><font color=#c27171>325</font> = <font color=#7875fd>3</font>_25 => <font color=#7875fd>3</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - ১ম ধাপ হতে প্রাপ্ত সংখ্যাটির বর্গ নির্ণয় করুন: <br><b><font color=#7875fd>3</font><small><sup>2</sup></small> = <font color=#008800>9</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ১ম ধাপ হতে প্রাপ্ত সংখ্যাটিকে 2 দ্বারা ভাগ করুন: <br><b><font color=#7875fd>3</font> / 2 = <font color=#888800>1.5</font></b>\n        <br>\n        <br><font color=#666666><b>৪র্থ ধাপ</b></font> - ২য় ধাপ হতে প্রাপ্ত বর্গের সাথে ৩য় ধাপ হতে প্রাপ্ত ভাগফল যোগ করুন: <br><b><font color=#008800>9</font> + <font color=#888800>1.5</font> = <font color=#6a379a>10.5</font></b>\n        <br>\n        <br><font color=#666666><b>৫ম ধাপ</b></font> - ৪র্থ ধাপ হতে প্রাপ্ত যোগফলকে 10 দ্বারা গুণ করুন: <br><b><font color=#6a379a>10.5</font> × 10 = <font color=#aa7700>105</font></b>\n        <br>\n        <br><font color=#666666><b>৬ষ্ঠ ধাপ</b></font> - ৫ম ধাপ হতে প্রাপ্ত গুণফলের পরে 625 বসিয়ে দিন: <br><b><font color=#aa7700>105</font>_625 = 105625</b>";
"trick_square_numbers_editing_in_25_text" = "শেষে ২৫ যুক্ত সংখ্যার বর্গ নির্ণয় করা";
"trick_square_numbers_editing_in_5_rule" = "trick_square_numbers_editing_in_5_rule";
"trick_square_numbers_editing_in_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>3</font>5<small><sup>2</sup></small> = 1225</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - ১ম অঙ্কটি ও 1 এর যোগফলকে ১ম অঙ্কটি দ্বারা গুণ করুন: <br><b><font color=#c27171>3</font> × (<font color=#c27171>3</font> + 1) = <font color=#7875fd>12</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - ১ম ধাপ থেকে প্রাপ্ত ফলাফলের পর 25 বসিয়ে দিন: <br><b><font color=#7875fd>12</font>_25 = 1225</b>";
"trick_square_numbers_editing_in_5_text" = "শেষে ৫ যুক্ত সংখ্যার বর্গ নির্ণয়";
