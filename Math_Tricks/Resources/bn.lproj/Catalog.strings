"trick_dividing_by_3_rule_text" = "-1";
"trick_dividing_by_3_text" = "৩ দ্বারা ভাগ";
"trick_dividing_by_40_rule" = "trick_dividing_by_40_rule";
"trick_dividing_by_40_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1280</font> / 40 = 32</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 10 দ্বারা ভাগ করুন: <br><b><font color=#c27171>1280</font> / 10 = <font color=#7875fd>128</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 4 দ্বারা ভাগ করুন: <br><b><font color=#7875fd>128</font> / 4 = 32</b>";
"trick_dividing_by_40_text" = "৪০ দ্বারা ভাগ করা";
"trick_dividing_by_4_rule" = "trick_dividing_by_4_rule";
"trick_dividing_by_4_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>64</font> / 4 = 16</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা ভাগ করুন: <br><b><font color=#c27171>64</font> / 2 = <font color=#7875fd>32</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলটি আবার 2 দ্বারা ভাগ করুন: <br><b><font color=#7875fd>32</font> / 2 = 16</b>";
"trick_dividing_by_4_text" = "৪ দ্বারা ভাগ করা";
"trick_dividing_by_50_rule" = "trick_dividing_by_50_rule";
"trick_dividing_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1250</font> / 50 = 25</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 100 দ্বারা ভাগ করুন: <br><b><font color=#c27171>1250</font> / 100 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 2 দ্বারা গুণ করুন: <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
"trick_dividing_by_50_text" = "৫০ দ্বারা ভাগ করা";
"trick_dividing_by_5_rule" = "trick_dividing_by_5_rule";
"trick_dividing_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1235</font> / 5 = 247</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 10 দ্বারা ভাগ করুন: <br><b><font color=#c27171>1235</font> / 10 = <font color=#7875fd>123.5</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 2 দ্বারা গুণ করুন: <br><b><font color=#7875fd>123.5</font> × 2 = 247</b>";
"trick_dividing_by_5_text" = "৫ দ্বারা ভাগ";
"trick_dividing_by_6_rule" = "trick_dividing_by_6_rule";
"trick_dividing_by_6_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>126</font> / <font color=#7875fd>6</font> = 21</b>\n        <br>\n        <br><b><font color=#7875fd>6</font> = <font color=#008800>3</font> × <font color=#888800>2</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা ভাগ করুন: <br><b><font color=#c27171>126</font> / <font color=#888800>2</font> = <font color=#aa7700>63</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলটি আবার 3 দ্বারা ভাগ করুন: <br><b><font color=#aa7700>63</font> / <font color=#008800>3</font> = 21";
"trick_dividing_by_6_text" = "৬ দ্বারা ভাগ";
"trick_dividing_by_7_rule" = "trick_dividing_by_7_rule";
"trick_dividing_by_7_rule_text" = "-1";
"trick_dividing_by_7_text" = "৭ দ্বারা ভাগ";
"trick_dividing_by_8_rule" = "trick_dividing_by_8_rule";
"trick_dividing_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>128</font> / <font color=#7875fd>8</font> = 16</b>\n        <br>\n        <br><b><font color=#7875fd>8</font> = <font color=#008800>2</font> × <font color=#888800>2</font> × <font color=#6a379a>2</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা ভাগ করুন: <br><b><font color=#c27171>128</font> / <font color=#008800>2</font> = <font color=#aa7700>64</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা ভাগ করুন: <br><b><font color=#aa7700>64</font> / <font color=#888800>2</font> = <font color=#008888>32</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা ভাগ করুন: <br><b><font color=#008888>32</font> / <font color=#6a379a>2</font> = 16";
"trick_dividing_by_8_text" = "৮ দ্বারা ভাগ";
"trick_dividing_by_9_rule" = "trick_dividing_by_9_rule";
"trick_dividing_by_9_rule_text" = "-1";
"trick_dividing_by_9_text" = "৯ দ্বারা ভাগ";
"trick_division_rule" = "trick_division_rule";
"trick_division_rule_text" = "-1";
"trick_division_text" = "ভাগ";
"trick_multiplication_rule" = "trick_multiplication_rule";
"trick_multiplication_rule_text" = "-1";
"trick_multiplication_text" = "গুণের ছক";
"trick_multiply_by_025_rule" = "trick_multiply_by_025_rule";
"trick_multiply_by_025_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>20</font> × 0.25 = 5</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 4 দ্বারা ভাগ করুন: <br><b><font color=#c27171>20</font> / 4 = 5</b>";
"trick_multiply_by_025_text" = "০.২৫ দ্বারা গুণ করা";
"trick_multiply_by_02_rule" = "trick_multiply_by_02_rule";
"trick_multiply_by_02_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>125</font> × 0.2 = 25</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 10 দ্বারা ভাগ করুন: <br><b><font color=#c27171>125</font> / 10 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 2 দ্বারা গুণ করুন: <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
"trick_multiply_by_02_text" = "০.২ দ্বারা গুণ করা";
"trick_multiply_by_05_rule" = "trick_multiply_by_05_rule";
"trick_multiply_by_05_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 0.5 = 9</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা ভাগ করুন: <br><b><font color=#c27171>18</font> / 2 = 9</b>";
"trick_multiply_by_05_text" = "০.৫ দ্বারা গুণ করা";
"trick_multiply_by_11_2digit_rule" = "trick_multiply_by_11_2digit_rule";
"trick_multiply_by_11_2digit_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>3</font><font color=#7875fd>5</font> × 11 = 385</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটির অঙ্ক দুটি যোগ করুন: <br><b><font color=#c27171>3</font> + <font color=#7875fd>5</font> = <font color=#008800>8</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - যোগফলটি উক্ত দুটি অঙ্কের মাঝখানে বসিয়ে দিন: <br><b><font color=#c27171>3</font>_<font color=#008800>8</font>_<font color=#7875fd>5</font> = 385</b>\n        <br>\n        <br>\n        <br><b><u>-2-</u></b>\n        <br>\n        <br><b><font color=#c27171>7</font><font color=#7875fd>8</font> × 11 = 858</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটির অঙ্ক দুটি যোগ করুন : <br><b><font color=#c27171>7</font> + <font color=#7875fd>8</font> = <font color=#6a379a>1</font><font color=#aa7700>5</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - যোগফল যদি 9 এর চেয়ে বেশি হয়, তবে ১ম অঙ্কটির সাথে 1 যোগ করুন: <br><b><font color=#c27171>7</font> + <font color=#6a379a>1</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - এবার অঙ্ক দুটির মাঝখানে প্রাপ্ত যোগফলের শেষ সংখ্যাটি বসিয়ে দিন: <br><b><font color=#888800>8</font>_<font color=#aa7700>5</font>_<font color=#7875fd>8</font> = 858</b>";
"trick_multiply_by_11_2digit_text" = "দুটি সংখ্যাকে ১১ দ্বারা গুণ";
"trick_multiply_by_125_rule" = "trick_multiply_by_125_rule";
"trick_multiply_by_125_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 125 = 3125</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 8 দ্বারা ভাগ করুন: <br><b><font color=#c27171>25</font> / 8 = <font color=#7875fd>3.125</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 1000 দ্বারা গুণ করুন: <br><b><font color=#7875fd>3.125</font> × 1000 = 3125</b>";
"trick_multiply_by_125_text" = "১২৫ দ্বারা গুণ";
"trick_multiply_by_12_rule" = "trick_multiply_by_12_rule";
"trick_multiply_by_12_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>12</font> = 192</b>\n        <br>\n        <br><b><font color=#888800>12</font> = <font color=#7875fd>10</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 10 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - সংখ্যাটি 2 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ১ম ধাপ ও ২য় ধাপ যোগ করুন: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>32</font> = 192</b>";
"trick_multiply_by_12_text" = "১২ দ্বারা গুণ";
"trick_multiply_by_13_rule" = "trick_multiply_by_13_rule";
"trick_multiply_by_13_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>13</font> = 208</b>\n        <br>\n        <br><b><font color=#888800>13</font> = <font color=#7875fd>10</font> + <font color=#008800>3</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 10 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - সংখ্যাটি 3 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#008800>3</font> = <font color=#6a379a>48</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ১ম ধাপ ও ২য় ধাপ যোগ করুন: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>48</font> = 208</b>";
"trick_multiply_by_13_text" = "১৩ দ্বারা গুণ";
"trick_multiply_by_14_rule" = "trick_multiply_by_14_rule";
"trick_multiply_by_14_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>14</font> = 224</b>\n        <br>\n        <br><b><font color=#888800>14</font> = <font color=#7875fd>10</font> + <font color=#008800>4</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 10 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - সংখ্যাটি 4 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#008800>4</font> = <font color=#6a379a>64</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ১ম ধাপ ও ২য় ধাপ যোগ করুন: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>64</font> = 224</b>";
"trick_multiply_by_14_text" = "১৪ দ্বারা গুণ";
"trick_multiply_by_15_rule" = "trick_multiply_by_15_rule";
"trick_multiply_by_15_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 15 = 540</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 10 দ্বারা গুণ করুন: <br><b><font color=#c27171>36</font> × 10 = <font color=#7875fd>360</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - ১ম ধাপ হতে প্রাপ্ত গুণফলকে 2 দ্বারা ভাগ করুন: <br><b><font color=#7875fd>360</font> / 2 = <font color=#008800>180</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ১ম ও ২য় ধাপ হতে প্রাপ্ত ফলাফলগুলোকে যোগ করুন: <br><b><font color=#7875fd>360</font> + <font color=#008800>180</font> = 540</b>";
"trick_multiply_by_15_text" = "১৫ দ্বারা গুণ করা";
"trick_multiply_by_16_rule" = "trick_multiply_by_16_rule";
"trick_multiply_by_16_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>16</font> = 224</b>\n        <br>\n        <br><b><font color=#7875fd>16</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>1</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 10 দ্বারা গুণ করুন: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - সংখ্যাটি 5 দ্বারা গুণ করুন: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - সংখ্যাটি 1 দ্বারা গুণ করুন: <br><b><font color=#c27171>14</font> × <font color=#b265cf>1</font> = <font color=#c27171>14</font></b>\n        <br>\n        <br><font color=#666666><b>৪র্থ ধাপ</b></font> - <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#c27171>14</font> = 224</b>";
"trick_multiply_by_16_text" = "১৬ দ্বারা গুণ";
"trick_multiply_by_17_rule" = "trick_multiply_by_17_rule";
"trick_multiply_by_17_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>17</font> = 238</b>\n        <br>\n        <br><b><font color=#7875fd>17</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>2</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 10 দ্বারা গুণ করুন: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - সংখ্যাটি 5 দ্বারা গুণ করুন: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - সংখ্যাটি 2 দ্বারা গুণ করুন: <br><b><font color=#c27171>14</font> × <font color=#b265cf>2</font> = <font color=#008888>28</font></b>\n        <br>\n        <br><font color=#666666><b>৪র্থ ধাপ</b></font> - <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#008888>28</font> = 238</b>";
"trick_multiply_by_17_text" = "১৭ দ্বারা গুণ";
"trick_multiply_by_18_rule" = "trick_multiply_by_18_rule";
"trick_multiply_by_18_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>18</font> = 288</b>\n        <br>\n        <br><b><font color=#888800>18</font> = <font color=#7875fd>20</font> - <font color=#aa7700>2</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 20 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - সংখ্যাটি 2 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#aa7700>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ২ম ধাপ থেকে প্রাপ্ত ফলকে অন্য সংখ্যাটি থেকে বিয়োগ করুন : <br><b><font color=#008888>320</font> - <font color=#6a379a>32</font> = 288</b>";
"trick_multiply_by_18_text" = "১৮ দ্বারা গুণ";
"trick_multiply_by_19_rule" = "trick_multiply_by_19_rule";
"trick_multiply_by_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>19</font> = 304</b>\n        <br>\n        <br><b><font color=#888800>19</font> = <font color=#7875fd>20</font> - <font color=#aa7700>1</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 20 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - সংখ্যাটি 1 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#aa7700>1</font> = <font color=#6a379a>16</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ২ম ধাপ থেকে প্রাপ্ত ফলকে অন্য সংখ্যাটি থেকে বিয়োগ করুন : <br><b><font color=#008888>320</font> - <font color=#6a379a>16</font> = 304</b>";
"trick_multiply_by_19_text" = "১৯ দ্বারা গুণ";
"trick_multiply_by_20_rule" = "trick_multiply_by_20_rule";
"trick_multiply_by_20_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 20 = 720</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা গুণ করুন: <br><b><font color=#c27171>36</font> × 2 = <font color=#7875fd>72</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - ১ম ধাপ হহে প্রাপ্ত গুণফলকে 10 দ্বারা গুণ করুন: <br><b><font color=#7875fd>72</font> × 10 = 720</b>";
"trick_multiply_by_20_text" = "২০ দ্বারা গুণ করা";
"trick_multiply_by_250_rule" = "trick_multiply_by_250_rule";
"trick_multiply_by_250_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 250 = 6250</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 4 দ্বারা ভাগ করুন: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 1000 দ্বারা গুণ করুন: <br><b><font color=#7875fd>6.25</font> × 1000 = 6250</b>";
"trick_multiply_by_250_text" = "২৫০ দ্বারা গুণ";
"trick_multiply_by_25_rule" = "trick_multiply_by_25_rule";
"trick_multiply_by_25_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 25 = 450</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 4 দ্বারা ভাগ করুন: <br><b><font color=#c27171>18</font> / 4 = <font color=#7875fd>4.5</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 100 দ্বারা গুণ করুন: <br><b><font color=#7875fd>4.5</font> × 100 = 450</b>";
"trick_multiply_by_25_text" = "২৫ দ্বারা গুণ করা";
"trick_multiply_by_2_rule" = "trick_multiply_by_2_rule";
"trick_multiply_by_2_rule_text" = "-1";
"trick_multiply_by_2_text" = "২ দ্বারা গুণ";
"trick_multiply_by_3_rule" = "trick_multiply_by_3_rule";
"trick_multiply_by_3_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>32</font> × <font color=#888800>3</font> = 96</b>\n        <br>\n        <br><b><font color=#888800>3</font> = <font color=#7875fd>2</font> + <font color=#008800>1</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 2 দ্বারা গুণ করুন: <br><b><font color=#c27171>32</font> × <font color=#7875fd>2</font> = <font color=#aa7700>64</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - সংখ্যাটি 1 দ্বারা গুণ করুন: <br><b><font color=#c27171>32</font> × <font color=#008800>1</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ১ম ধাপ ও ২য় ধাপ যোগ করুন: <br><b><font color=#aa7700>64</font> + <font color=#6a379a>32</font> = 96</b>";
"trick_multiply_by_3_text" = "৩ দ্বারা গুণ";
"trick_multiply_by_4_rule" = "trick_multiply_by_4_rule";
"trick_multiply_by_4_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>58</font> × 4 = 232</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা গুণ করুন: <br><b><font color=#c27171>58</font> × 2 = <font color=#7875fd>116</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত গুণফলকে আবার 2 দ্বারা গুণ করুন: <br><b><font color=#7875fd>116</font> × 2 = 232</b>";
"trick_multiply_by_4_text" = "৪ দ্বারা গুণ";
"trick_multiply_by_500_rule" = "trick_multiply_by_500_rule";
"trick_multiply_by_500_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 500 = 12500</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা ভাগ করুন: <br><b><font color=#c27171>25</font> / 2 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 1000 দ্বারা গুণ করুন: <br><b><font color=#7875fd>12.5</font> × 1000 = 12500</b>";
"trick_multiply_by_500_text" = "৫০০ দ্বারা গুণ";
"trick_multiply_by_50_rule" = "trick_multiply_by_50_rule";
"trick_multiply_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 50 = 900</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা ভাগ করুন: <br><b><font color=#c27171>18</font> / 2 = <font color=#7875fd>9</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 100 দ্বারা গুণ করুন: <br><b><font color=#7875fd>9</font> × 100 = 900</b>";
"trick_multiply_by_50_text" = "৫০ দ্বারা গুণ করা";
"trick_multiply_by_5_rule" = "trick_multiply_by_5_rule";
"trick_multiply_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1234</font> × 5 = 6170</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 2 দ্বারা ভাগ করুন: <br><b><font color=#c27171>1234</font> / 2 = <font color=#7875fd>617</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - ১ম ধাপ থেকে প্রাপ্ত ভাগফলকে 10 দ্বারা গুণ করুন: <br><b><font color=#7875fd>617</font> × 10 = 6170</b>";
"trick_multiply_by_5_text" = "৫ দ্বারা গুণ";
"trick_multiply_by_6_rule" = "trick_multiply_by_6_rule";
"trick_multiply_by_6_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>6</font> = 96</b>\n        <br>\n        <br><b><font color=#888800>6</font> = 5 + 1 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>1</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা ভাগ দিন: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 10 দ্বারা গুণ দিন: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - সংখ্যাটি 1 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#008800>1</font> = <font color=#c27171>16</font></b>\n        <br>\n        <br><font color=#666666><b>৪র্থ ধাপ</b></font> - ২য় ধাপ হতে প্রাপ্ত গুণফলের সাথে ৩য় ধাপ হতে প্রাপ্ত বর্গ যোগ করুন: <br><b><font color=#008888>80</font> + <font color=#c27171>16</font> = 96</b>";
"trick_multiply_by_6_text" = "৬ দ্বারা গুণ";
"trick_multiply_by_750_rule" = "trick_multiply_by_750_rule";
"trick_multiply_by_750_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 750 = 18750</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 4 দ্বারা ভাগ করুন: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 3 দ্বারা গুণ করুন: <br><b><font color=#7875fd>6.25</font> × 3 = <font color=#aa7700>18.75</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 1000 দ্বারা গুণ করুন: <br><b><font color=#aa7700>18.75</font> × 1000 = 18750</b>";
"trick_multiply_by_750_text" = "৭৫০ দ্বারা গুণ";
"trick_multiply_by_75_rule" = "trick_multiply_by_75_rule";
"trick_multiply_by_75_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>68</font> × 75 = 5100</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 4 দ্বারা ভাগ করুন: <br><b><font color=#c27171>68</font> / 4 = <font color=#7875fd>17</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 3 দ্বারা গুণ করুন: <br><b><font color=#7875fd>17</font> × 3 = <font color=#aa7700>51</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 100 দ্বারা গুণ করুন: <br><b><font color=#aa7700>51</font> × 100 = 5100</b>";
"trick_multiply_by_75_text" = "৭৫ দ্বারা গুণ";
"trick_multiply_by_7_rule" = "trick_multiply_by_7_rule";
"trick_multiply_by_7_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>7</font> = 112</b>\n        <br>\n        <br><b><font color=#888800>7</font> = 5 + 2 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা ভাগ দিন: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 10 দ্বারা গুণ দিন: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - সংখ্যাটি 2 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#8c6745>32</font></b>\n        <br>\n        <br><font color=#666666><b>৪র্থ ধাপ</b></font> - ২য় ধাপ হতে প্রাপ্ত গুণফলের সাথে ৩য় ধাপ হতে প্রাপ্ত বর্গ যোগ করুন: <br><b><font color=#008888>80</font> + <font color=#8c6745>32</font> = 112</b>";
"trick_multiply_by_7_text" = "৭ দ্বারা গুণ";
"trick_multiply_by_8_rule" = "trick_multiply_by_8_rule";
"trick_multiply_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>8</font> = 128</b>\n        <br>\n        <br><b><font color=#888800>8</font> = <font color=#7875fd>10</font> - <font color=#aa7700>2</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 10 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#008888>160</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - সংখ্যাটি 2 দ্বারা গুণ করুন: <br><b><font color=#c27171>16</font> × <font color=#aa7700>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ২ম ধাপ থেকে প্রাপ্ত ফলকে অন্য সংখ্যাটি থেকে বিয়োগ করুন : <br><b><font color=#008888>160</font> - <font color=#6a379a>32</font> = 128</b>";
"trick_multiply_by_8_text" = "৮ দ্বারা গুণ";
"trick_multiply_by_999_rule" = "trick_multiply_by_999_rule";
"trick_multiply_by_999_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 999 = 24975</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 1000 দ্বারা গুণ করুন: <br><b><font color=#c27171>25</font> × 1000 = <font color=#7875fd>25000</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত গুণফল থেকে সংখ্যাটি একবার বিয়োগ করুন: <br><b><font color=#7875fd>25000</font> - <font color=#c27171>25</font> = 24975</b>";
"trick_multiply_by_999_text" = "৯৯৯ দ্বারা গুণ";
"trick_multiply_by_99_rule" = "trick_multiply_by_99_rule";
"trick_multiply_by_99_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>15</font> × 99 = 1485</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 100 দ্বারা গুণ করুন: <br><b><font color=#c27171>15</font> × 100 = <font color=#7875fd>1500</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত গুণফল থেকে সংখ্যাটি একবার বিয়োগ করুন: <br><b><font color=#7875fd>1500</font> - <font color=#c27171>15</font> = 1485</b>";
"trick_multiply_by_99_text" = "৯৯ দ্বারা গুণ করা";
"trick_multiply_by_9_rule" = "trick_multiply_by_9_rule";
"trick_multiply_by_9_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>56</font> × 9 = 504</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 10 দ্বারা গুণ করুন: <br><b><font color=#c27171>56</font> × 10 = <font color=#7875fd>560</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত গুণফল থেকে সংখ্যাটি 1 বার বিয়োগ করুন: <br><b><font color=#7875fd>560</font> - <font color=#c27171>56</font> = 504</b>";
"trick_multiply_by_9_text" = "৯ দ্বারা গুণ";
"trick_multiply_numbers_between_11_and_19_rule" = "trick_multiply_numbers_between_11_and_19_rule";
"trick_multiply_numbers_between_11_and_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>1<font color=#c27171>4</font> × <font color=#7875fd>1</font><font color=#008800>8</font> = 252</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - বড় সংখ্যাটিকে অন্য সংখ্যাটির ডানের অঙ্কটির সাথে যোগ করুন: <br><b><font color=#7875fd>1</font><font color=#008800>8</font> + <font color=#c27171>4</font> = <font color=#6a379a>22</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত যোগফলের শেষে 0 বসিয়ে দিন বা 10 দিয়ে গুণ করুন: <br><b><font color=#6a379a>22</font> × 10 = <font color=#888800>220</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - দুটি সংখ্যারই ডানের অঙ্কের একটিকে অন্যটি দ্বারা গুণ করুন: <br><b><font color=#008800>8</font> x <font color=#c27171>4</font> = <font color=#aa7700>32</font></b>\n        <br>\n        <br><font color=#666666><b>৪র্থ ধাপ</b></font> - ২য় ধাপের গুণফলের সাথে ৩য় ধাপের গুণফল যোগ করুন: <br><b><font color=#888800>220</font> + <font color=#aa7700>32</font> = 252</b>";
"trick_multiply_numbers_between_11_and_19_text" = "১১ থেকে ১৯ এর মধ্যবর্তী সংখ্যাকে গুণ করা";
"trick_multiply_two_digit_numbers_editing_in_1_rule" = "trick_multiply_two_digit_numbers_editing_in_1_rule";
"trick_multiply_two_digit_numbers_editing_in_1_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>5</font>1 × <font color=#7875fd>3</font>1 = 1581</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - বামের অঙ্কগুলোকে গুণ করুন: <br><b><font color=#c27171>5</font> × <font color=#7875fd>3</font> = <font color=#008800>15</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - বামের অঙ্কগুলোকে যোগ করুন: <br><b><font color=#c27171>5</font> + <font color=#7875fd>3</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ১ম ধাপ হতে প্রাপ্ত গুণফলের পরে ২য় ধাপ হতে প্রাপ্ত যোগফল বসিয়ে দিন: <br><b><font color=#008800>15</font>_<font color=#888800>8</font> = 158</b>\n        <br>\n        <br><font color=#666666><b>৪র্থ ধাপ</b></font> - ৩য় ধাপ হতে প্রাপ্ত ফলাফরের পর 1 বসিয়ে দিন: <br><b><font color=#008800>15</font>_<font color=#888800>8</font>_1 = 1581</b>";
"trick_multiply_two_digit_numbers_editing_in_1_text" = "শেষে ১ যুক্ত দুটি সংখ্যা গুণ করা";
"trick_multiply_two_digit_numbers_having_same_tens_rule" = "trick_multiply_two_digit_numbers_having_same_tens_rule";
"trick_multiply_two_digit_numbers_having_same_tens_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>2</font><font color=#7875fd>3</font> × <font color=#c27171>2</font><font color=#008800>7</font> = 621</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - ১ম অঙ্কটি ও ১ এর যোগফলকে ১ম অঙ্কটি দ্বারা গুণ করুন: <br><b><font color=#c27171>2</font> × (<font color=#c27171>2</font> + 1) = <font color=#6a379a>6</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - ডানের অঙ্ক দুটিকে গুণ করুন(যদি গুণফলটি সিংগেল হয় তবে তার পূর্বে 0 বসিয়ে দিন): <br><b><font color=#7875fd>3</font> × <font color=#008800>7</font> = <font color=#888800>21</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ১মম ধাপ হতে প্রাপ্ত গুণফলের পরে ২য় ধাপ হতে প্রাপ্ত গুণফল বসিয়ে দিন: <br><b><font color=#6a379a>6</font>_<font color=#888800>21</font> = 621</b>";
"trick_multiply_two_digit_numbers_having_same_tens_text" = "একই দশকের ঘরের দুটি সংখ্যা গুণ করুন (ab*ac, b+c=10)";
"trick_percent_2_rule" = "trick_percent_2_rule";
"trick_percent_2_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>6</font>% → 350 = 21</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - 100 এর <font color=#c27171>6</font>% হচ্ছে <b><font color=#c27171>6</font></b> (প্রতি 100 এর জন্য <font color=#c27171>6</font>)\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - 300 এর <font color=#c27171>6</font>% হচ্ছে <b><font color=#6a379a>18</font></b> (১ম ধাপ হতে প্রাপ্ত ফলাফলকে <font color=#7875fd>3</font> দ্বারা গুণ করুন)\n        <br>\n        <br><i>[100 × <font color=#7875fd>3</font> = 300] → [<font color=#c27171>6</font> × <font color=#7875fd>3</font> = <font color=#6a379a>18</font>]</i>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - 50 এর <font color=#c27171>6</font>% হচ্ছে <b><font color=#aa7700>3</font></b> (১ম ধাপ হতে প্রাপ্ত ফলাফলকে <font color=#888800>2</font> দ্বারা ভাগ করুন)\n        <br>\n        <br><i>[100 / <font color=#888800>2</font> = 50] → [<font color=#c27171>6</font> / <font color=#888800>2</font> = <font color=#aa7700>3</font>]</i>\n        <br>\n        <br><font color=#666666><b>৪র্থ ধাপ</b></font> - ২য় ও ৩য় ধাপ হতে প্রাপ্ত ফলাফলগুলোকে যোগ করুন: <br><b><font color=#6a379a>18</font> + <font color=#aa7700>3</font> = 21</b>";
"trick_percent_2_text" = "একটি হিসাব করুন -2-";
"trick_percent_rule" = "trick_percent_rule";
"trick_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>15% → <font color=#c27171>300</font> = 45</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটির 10% এর মান বের করুন (সংখ্যাটিকে 10 দিয়ে ভাগ করুন): <br><b><font color=#c27171>300</font> / 10 = <font color=#7875fd>30</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - সংখ্যাটির 5% এর মান বের করুন (১ম ধাপ হতে প্রাপ্ত ফলাফলকে 2 দ্বারা ভাগ করুন): <br><b><font color=#7875fd>30</font> / 2 = <font color=#008800>15</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ১ম ও ২য় ধাপ হতে প্রাপ্ত ফলাফলগুলোকে যোগ করুন: <br><b><font color=#7875fd>30</font> + <font color=#008800>15</font> = 45</b>";
"trick_percent_text" = "একটি হিসাব করুন -1-";
