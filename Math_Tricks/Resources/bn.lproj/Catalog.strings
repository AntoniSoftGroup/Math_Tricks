"trick_tough_multiplication_rule" = "trick_tough_multiplication_rule";
"trick_tough_multiplication_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>32 × 125</b> এর সমান:\n \t\t<br><b>16 × 250</b> এর সমান:\n \t\t<br><b>8 × 500</b> এর সমান:\n \t\t<br><b>4 × 1000 = 4000</b>";
