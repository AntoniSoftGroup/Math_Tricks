"trick_adding_numbers_close_to_hundreds_rule" = "trick_adding_numbers_close_to_hundreds_rule";
"trick_adding_numbers_close_to_hundreds_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>159</font> + <font color=#7875fd>192</font> = 351</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটির সাথে কোনো সংখ্যা যোগ বা বিয়োগ করে কাছাকাছি কোনো শ'য়ের ঘরে নিয়ে আসুন: <br><b><font color=#7875fd>192</font> + <font color=#008800>8</font> = <font color=#aa7700>200</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - ১ম ধাপ থেকে প্রাপ্ত ফলকে অন্য সংখ্যাটির সাথে যোগ করুন: <br><b><font color=#aa7700>200</font> + <font color=#c27171>159</font> = <font color=#6a379a>359</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ২য় ধাপ থেকে প্রাপ্ত যোগফল থেকে সেই সংখ্যাটি যোগ বা বিয়োগ করুন, যে সংখ্যাটি যোগ বা বিয়োগ করে আপনি ১ম সংখ্যাটিকে শ'য়ের ঘরে নিয়েছিলেন: <br><b><font color=#6a379a>359</font> - <font color=#008800>8</font> = 351</b>";
"trick_adding_numbers_close_to_hundreds_text" = "শত এর কাছাকাছি সংখ্যাকে যোগ করা";
"trick_addition_rule" = "trick_addition_rule";
"trick_addition_rule_text" = "-1";
"trick_addition_text" = "যোগ";
"trick_dividing_by_025_rule" = "trick_dividing_by_025_rule";
"trick_dividing_by_025_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>20</font> / 0.25 = 80</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 4 দ্বারা গুণ করুন: <br><b><font color=#c27171>20</font> × 4 = 80</b>";
"trick_dividing_by_025_text" = "০.২৫ দ্বারা ভাগ করা";
"trick_dividing_by_02_rule" = "trick_dividing_by_02_rule";
"trick_dividing_by_02_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> / 0.2 = 90</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 2 দ্বারা ভাগ করুন: <br><b><font color=#c27171>18</font> / 2 = <font color=#7875fd>9</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 10 দ্বারা গুণ করুন: <br><b><font color=#7875fd>9</font> × 10 = 90</b>";
"trick_dividing_by_02_text" = "০.২ দ্বারা ভাগ করা";
"trick_dividing_by_05_rule" = "trick_dividing_by_05_rule";
"trick_dividing_by_05_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> / 0.5 = 36</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটি 2 দ্বারা গুণ করুন: <br><b><font color=#c27171>18</font> × 2 = 36</b>";
"trick_dividing_by_05_text" = "০.৫ দ্বারা ভাগ করা";
"trick_dividing_by_15_rule" = "trick_dividing_by_15_rule";
"trick_dividing_by_15_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>315</font> / <font color=#7875fd>15</font> = 21</b>\n        <br>\n        <br><b><font color=#7875fd>15</font> = <font color=#008800>10</font> × <font color=#888800>3</font> / <font color=#b265cf>2</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 10 দ্বারা ভাগ করুন: <br><b><font color=#c27171>315</font> / <font color=#008800>10</font> = <font color=#aa7700>31.5</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলটি আবার 3 দ্বারা ভাগ করুন: <br><b><font color=#aa7700>31.5</font> / <font color=#888800>3</font> = <font color=#8c6745>10.5</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 2 দ্বারা গুণ করুন: <br><b><font color=#8c6745>10.5</font> × <font color=#b265cf>2</font> = 21</b>";
"trick_dividing_by_15_text" = "১৫ দ্বারা ভাগ";
"trick_dividing_by_20_rule" = "trick_dividing_by_20_rule";
"trick_dividing_by_20_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1260</font> / 20 = 63</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 10 দ্বারা ভাগ করুন: <br><b><font color=#c27171>1260</font> / 10 = <font color=#7875fd>126</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 2 দ্বারা ভাগ করুন: <br><b><font color=#7875fd>126</font> / 2 = 63</b>";
"trick_dividing_by_20_text" = "২০ দ্বারা ভাগ করা";
"trick_dividing_by_25_rule" = "trick_dividing_by_25_rule";
"trick_dividing_by_25_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1250</font> / 25 = 50</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটিকে 100 দ্বারা ভাগ করুন: <br><b><font color=#c27171>1250</font> / 100 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - প্রাপ্ত ভাগফলকে 4 দ্বারা গুণ করুন: <br><b><font color=#7875fd>12.5</font> × 4 = 50</b>";
"trick_dividing_by_25_text" = "২৫ দ্বারা ভাগ করা";
