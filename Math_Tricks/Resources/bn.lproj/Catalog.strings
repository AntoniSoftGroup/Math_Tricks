"trick_subtracting_from_1000_rule" = "trick_subtracting_from_1000_rule";
"trick_subtracting_from_1000_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>1000 - <font color=#c27171>5</font><font color=#7875fd>6</font><font color=#888800>7</font> = <font color=#008800>4</font><font color=#6a379a>3</font><font color=#aa7700>3</font></b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - 9 থেকে <font color=#c27171>5</font> বিয়োগ করুন: <b><font color=#008800>4</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - 9 থেকে <font color=#7875fd>6</font> বিয়োগ করুন: <b><font color=#6a379a>3</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - 10 থেকে <font color=#888800>7</font> বিয়োগ করুন: <b><font color=#aa7700>3</font></b>";
"trick_subtracting_from_1000_text" = "১০০০ থেকে বিয়োগ করা";
"trick_subtracting_numbers_close_to_hundreds_rule" = "trick_subtracting_numbers_close_to_hundreds_rule";
"trick_subtracting_numbers_close_to_hundreds_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>259</font> - <font color=#7875fd>192</font> = 67</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটির সাথে কোনো সংখ্যা যোগ বা বিয়োগ করে কাছাকাছি কোনো শ'য়ের ঘরে নিয়ে আসুন : <br><b><font color=#7875fd>192</font> + <font color=#008800>8</font> = <font color=#aa7700>200</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - ১ম ধাপ থেকে প্রাপ্ত ফলকে অন্য সংখ্যাটি থেকে বিয়োগ করুন : <br><b><font color=#c27171>259</font> - <font color=#aa7700>200</font> = <font color=#6a379a>59</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ২য় ধাপ থেকে প্রাপ্ত যোগফল থেকে সেই সংখ্যাটি যোগ বা বিয়োগ করুন, যে সংখ্যাটি যোগ বা বিয়োগ করে আপনি ১ম সংখ্যাটিকে শ'য়ের ঘরে নিয়েছিলেন : <br><b><font color=#6a379a>59</font> + <font color=#008800>8</font> = 67</b>";
"trick_subtracting_numbers_close_to_hundreds_text" = "শত এর কাছাকাছি সংখ্যাকে বিয়োগ করা";
