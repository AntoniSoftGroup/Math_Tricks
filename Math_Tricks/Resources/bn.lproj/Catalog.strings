"trick_square_number_between_100_and_109_rule" = "trick_square_number_between_100_and_109_rule";
"trick_square_number_between_100_and_109_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>10</font><font color=#7875fd>3</font><small><sup>2</sup></small> = 10609</b>\n        <br>\n        <br><font color=#666666><b>১ম ধাপ</b></font> - সংখ্যাটির সাথে সর্বডানের অঙ্কটি যোগ করুন: <br><b><font color=#c27171>10</font><font color=#7875fd>3</font> + <font color=#7875fd>3</font> = <font color=#888800>106</font></b>\n        <br>\n        <br><font color=#666666><b>২য় ধাপ</b></font> - সর্বডানের অঙ্কটির বর্গ নির্ণয় করুন (বর্গটি যদি সিংগেল হয় তবে এর পূর্বে 0 বসিয়ে দিন): <br><b><font color=#7875fd>3</font><small><sup>2</sup></small> = 0<font color=#008800>9</font></b>\n        <br>\n        <br><font color=#666666><b>৩য় ধাপ</b></font> - ১ম ধাপ হতে প্রাপ্ত যোগফলের পরে ২য় ধাপ হতে প্রাপ্ত বর্গ বসিয়ে দিন: <br><b><font color=#888800>106</font>_0<font color=#008800>9</font> = 10609</b>";
