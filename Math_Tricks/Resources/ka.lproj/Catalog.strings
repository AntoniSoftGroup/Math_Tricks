"trick_dividing_by_15_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>315</font> / <font color=#7875fd>15</font> = 21</b>\n        <br>\n        <br><b><font color=#7875fd>15</font> = <font color=#008800>10</font> × <font color=#888800>3</font> / <font color=#b265cf>2</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 10-ზე: <br><b><font color=#c27171>315</font> / <font color=#008800>10</font> = <font color=#aa7700>31.5</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაყავით 3-ზე: <br><b><font color=#aa7700>31.5</font> / <font color=#888800>3</font> = <font color=#8c6745>10.5</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 2-ზე: <br><b><font color=#8c6745>10.5</font> × <font color=#b265cf>2</font> = 21</b>";
"trick_dividing_by_15_text" = "გაყოფა 15-ზე";
"trick_dividing_by_20_rule" = "trick_dividing_by_20_rule";
"trick_dividing_by_20_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1260</font> / 20 = 63</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 10-ზე: <br><b><font color=#c27171>1260</font> / 10 = <font color=#7875fd>126</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაყავით 2-ზე: <br><b><font color=#7875fd>126</font> / 2 = 63</b>";
"trick_dividing_by_20_text" = "გაყოფა 20-ზე";
"trick_dividing_by_25_rule" = "trick_dividing_by_25_rule";
"trick_dividing_by_25_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1250</font> / 25 = 50</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 100-ზე: <br><b><font color=#c27171>1250</font> / 100 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 4-ზე: <br><b><font color=#7875fd>12.5</font> × 4 = 50</b>";
"trick_dividing_by_25_text" = "გაყოფა 25-ზე";
"trick_dividing_by_2_rule" = "trick_dividing_by_2_rule";
"trick_dividing_by_2_rule_text" = "-1";
"trick_dividing_by_2_text" = "გაყოფა 2-ზე";
"trick_dividing_by_3_rule" = "trick_dividing_by_3_rule";
"trick_dividing_by_3_rule_text" = "-1";
"trick_dividing_by_3_text" = "გაყოფა 3-ზე";
"trick_dividing_by_40_rule" = "trick_dividing_by_40_rule";
"trick_dividing_by_40_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1280</font> / 40 = 32</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 10-ზე: <br><b><font color=#c27171>1280</font> / 10 = <font color=#7875fd>128</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაყავით 4-ზე: <br><b><font color=#7875fd>128</font> / 4 = 32</b>";
"trick_dividing_by_40_text" = "გაყოფა 40-ზე";
"trick_dividing_by_4_rule" = "trick_dividing_by_4_rule";
"trick_dividing_by_4_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>64</font> / 4 = 16</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 2-ზე: <br><b><font color=#c27171>64</font> / 2 = <font color=#7875fd>32</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაყავით 2-ზე: <br><b><font color=#7875fd>32</font> / 2 = 16</b>";
"trick_dividing_by_4_text" = "გაყოფა 4-ზე";
"trick_dividing_by_50_rule" = "trick_dividing_by_50_rule";
"trick_dividing_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1250</font> / 50 = 25</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 100-ზე: <br><b><font color=#c27171>1250</font> / 100 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 2-ზე: <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
"trick_dividing_by_50_text" = "გაყოფა 50-ზე";
"trick_dividing_by_5_rule" = "trick_dividing_by_5_rule";
"trick_dividing_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1235</font> / 5 = 247</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 10-ზე: <br><b><font color=#c27171>1235</font> / 10 = <font color=#7875fd>123.5</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 2-ზე: <br><b><font color=#7875fd>123.5</font> × 2 = 247</b>";
"trick_dividing_by_5_text" = "გაყოფა 5-ზე";
"trick_dividing_by_6_rule" = "trick_dividing_by_6_rule";
"trick_dividing_by_6_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>126</font> / <font color=#7875fd>6</font> = 21</b>\n        <br>\n        <br><b><font color=#7875fd>6</font> = <font color=#008800>3</font> × <font color=#888800>2</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 2-ზე: <br><b><font color=#c27171>126</font> / <font color=#888800>2</font> = <font color=#aa7700>63</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაყავით 3-ზე: <br><b><font color=#aa7700>63</font> / <font color=#008800>3</font> = 21";
"trick_dividing_by_6_text" = "გაყოფა 6-ზე";
"trick_dividing_by_7_rule" = "trick_dividing_by_7_rule";
"trick_dividing_by_7_rule_text" = "-1";
"trick_dividing_by_7_text" = "გაყოფა 7-ზე";
"trick_dividing_by_8_rule" = "trick_dividing_by_8_rule";
"trick_dividing_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>128</font> / <font color=#7875fd>8</font> = 16</b>\n        <br>\n        <br><b><font color=#7875fd>8</font> = <font color=#008800>2</font> × <font color=#888800>2</font> × <font color=#6a379a>2</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 2-ზე: <br><b><font color=#c27171>128</font> / <font color=#008800>2</font> = <font color=#aa7700>64</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემული რიცხვი გაყავით 2-ზე: <br><b><font color=#aa7700>64</font> / <font color=#888800>2</font> = <font color=#008888>32</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - მოცემული რიცხვი გაყავით 2-ზე: <br><b><font color=#008888>32</font> / <font color=#6a379a>2</font> = 16";
"trick_dividing_by_8_text" = "გაყოფა 8-ზე";
"trick_dividing_by_9_rule" = "trick_dividing_by_9_rule";
"trick_dividing_by_9_rule_text" = "-1";
"trick_dividing_by_9_text" = "გაყოფა 9-ზე";
"trick_division_rule" = "trick_division_rule";
"trick_division_rule_text" = "-1";
"trick_division_text" = "გაყოფა";
"trick_multiplication_rule" = "trick_multiplication_rule";
"trick_multiplication_rule_text" = "-1";
"trick_multiplication_text" = "გამრავლების ტაბულა";
"trick_multiply_by_025_rule" = "trick_multiply_by_025_rule";
"trick_multiply_by_025_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>20</font> × 0.25 = 5</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 4-ზე: <br><b><font color=#c27171>20</font> / 4 = 5</b>";
"trick_multiply_by_025_text" = "გამრავლება 0.25-ზე";
"trick_multiply_by_02_rule" = "trick_multiply_by_02_rule";
"trick_multiply_by_02_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>125</font> × 0.2 = 25</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 10-ზე: <br><b><font color=#c27171>125</font> / 10 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 2-ზე: <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
"trick_multiply_by_02_text" = "გამრავლება 0.2-ზე";
"trick_multiply_by_05_rule" = "trick_multiply_by_05_rule";
"trick_multiply_by_05_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 0.5 = 9</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 2-ზე: <br><b><font color=#c27171>18</font> / 2 = 9</b>";
"trick_multiply_by_05_text" = "გამრავლება 0.5-ზე";
"trick_multiply_by_11_2digit_rule" = "trick_multiply_by_11_2digit_rule";
"trick_multiply_by_11_2digit_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>3</font><font color=#7875fd>5</font> × 11 = 385</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - რიცხვში შემავალი ციფრები შეკრიბეთ: <br><b><font color=#c27171>3</font> + <font color=#7875fd>5</font> = <font color=#008800>8</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - შედეგი ჩასვით მოცემული რიცხვის ციფრებს შორის: <br><b><font color=#c27171>3</font>_<font color=#008800>8</font>_<font color=#7875fd>5</font> = 385</b>\n        <br>\n        <br>\n        <br><b><u>-2-</u></b>\n        <br>\n        <br><b><font color=#c27171>7</font><font color=#7875fd>8</font> × 11 = 858</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - რიცხვში შემავალი ციფრები შეკრიბეთ: <br><b><font color=#c27171>7</font> + <font color=#7875fd>8</font> = <font color=#6a379a>1</font><font color=#aa7700>5</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - თუ შედეგი მეტია 9-ზე, გადაიტანეთ 1: <br><b><font color=#c27171>7</font> + <font color=#6a379a>1</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - შედეგი ჩასვით მოცემული რიცხვის ციფრებს შორის: <br><b><font color=#888800>8</font>_<font color=#aa7700>5</font>_<font color=#7875fd>8</font> = 858</b>";
"trick_multiply_by_11_2digit_text" = "ორნიშნა ციფრის გამრავლება 11-ზე";
"trick_multiply_by_125_rule" = "trick_multiply_by_125_rule";
"trick_multiply_by_125_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 125 = 3125</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 8-ზე: <br><b><font color=#c27171>25</font> / 8 = <font color=#7875fd>3.125</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 1000-ზე: <br><b><font color=#7875fd>3.125</font> × 1000 = 3125</b>";
"trick_multiply_by_125_text" = "გამრავლება 125-ზე";
"trick_multiply_by_12_rule" = "trick_multiply_by_12_rule";
"trick_multiply_by_12_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>12</font> = 192</b>\n        <br>\n        <br><b><font color=#888800>12</font> = <font color=#7875fd>10</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 10-ზე: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემული რიცხვი გაამრავლეთ 2-ზე: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - 1 და 2 ნაბიჯის შედეგები შეკრიბეთ: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>32</font> = 192</b>";
"trick_multiply_by_12_text" = "გამრავლება 12-ზე";
"trick_multiply_by_13_rule" = "trick_multiply_by_13_rule";
"trick_multiply_by_13_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>13</font> = 208</b>\n        <br>\n        <br><b><font color=#888800>13</font> = <font color=#7875fd>10</font> + <font color=#008800>3</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 10-ზე: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემული რიცხვი გაამრავლეთ 3-ზე: <br><b><font color=#c27171>16</font> × <font color=#008800>3</font> = <font color=#6a379a>48</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - 1 და 2 ნაბიჯის შედეგები შეკრიბეთ: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>48</font> = 208</b>";
"trick_multiply_by_13_text" = "გამრავლება 13-ზე";
"trick_multiply_by_14_rule" = "trick_multiply_by_14_rule";
"trick_multiply_by_14_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>14</font> = 224</b>\n        <br>\n        <br><b><font color=#888800>14</font> = <font color=#7875fd>10</font> + <font color=#008800>4</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 10-ზე: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემული რიცხვი გაამრავლეთ 4-ზე: <br><b><font color=#c27171>16</font> × <font color=#008800>4</font> = <font color=#6a379a>64</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - 1 და 2 ნაბიჯის შედეგები შეკრიბეთ: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>64</font> = 224</b>";
"trick_multiply_by_14_text" = "გამრავლება 14-ზე";
"trick_multiply_by_15_rule" = "trick_multiply_by_15_rule";
"trick_multiply_by_15_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 15 = 540</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გადაამრავლეთ 10-ზე: <br><b><font color=#c27171>36</font> × 10 = <font color=#7875fd>360</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაყავით 2-ზე: <br><b><font color=#7875fd>360</font> / 2 = <font color=#008800>180</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - პირველი და მეორე ნაბიჯის შედეგები შეკრიბეთ: <br><b><font color=#7875fd>360</font> + <font color=#008800>180</font> = 540</b>";
"trick_multiply_by_15_text" = "გამრავლება 15-ზე";
"trick_multiply_by_16_rule" = "trick_multiply_by_16_rule";
"trick_multiply_by_16_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>16</font> = 224</b>\n        <br>\n        <br><b><font color=#7875fd>16</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>1</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 10-ზე: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემული რიცხვი გაამრავლეთ 5-ზე: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - მოცემული რიცხვი გაამრავლეთ 1-ზე: <br><b><font color=#c27171>14</font> × <font color=#b265cf>1</font> = <font color=#c27171>14</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 4</b></font> - 1, 2 და 3 ნაბიჯის შედეგები შეკრიბეთ: <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#c27171>14</font> = 224</b>";
"trick_multiply_by_16_text" = "გამრავლება 16-ზე";
"trick_multiply_by_17_rule" = "trick_multiply_by_17_rule";
"trick_multiply_by_17_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>17</font> = 238</b>\n        <br>\n        <br><b><font color=#7875fd>17</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>2</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 10-ზე: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემული რიცხვი გაამრავლეთ 5-ზე: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - მოცემული რიცხვი გაამრავლეთ 2-ზე: <br><b><font color=#c27171>14</font> × <font color=#b265cf>2</font> = <font color=#008888>28</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 4</b></font> - 1, 2 და 3 ნაბიჯის შედეგები შეკრიბეთ: <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#008888>28</font> = 238</b>";
"trick_multiply_by_17_text" = "გამრავლება 17-ზე";
"trick_multiply_by_18_rule" = "trick_multiply_by_18_rule";
"trick_multiply_by_18_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>18</font> = 288</b>\n        <br>\n        <br><b><font color=#888800>18</font> = <font color=#7875fd>20</font> - <font color=#aa7700>2</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 20-ზე: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემული რიცხვი გაამრავლეთ 2-ზე: <br><b><font color=#c27171>16</font> × <font color=#aa7700>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - საკლებს გამოაკელით მეორე ეტაპი მიღებული შედეგი: <br><b><font color=#008888>320</font> - <font color=#6a379a>32</font> = 288</b>";
"trick_multiply_by_18_text" = "გამრავლება 18-ზე";
"trick_multiply_by_19_rule" = "trick_multiply_by_19_rule";
"trick_multiply_by_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>19</font> = 304</b>\n        <br>\n        <br><b><font color=#888800>19</font> = <font color=#7875fd>20</font> - <font color=#aa7700>1</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 20-ზე: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემული რიცხვი გაამრავლეთ 1-ზე: <br><b><font color=#c27171>16</font> × <font color=#aa7700>1</font> = <font color=#6a379a>16</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - საკლებს გამოაკელით მეორე ეტაპი მიღებული შედეგი: <br><b><font color=#008888>320</font> - <font color=#6a379a>16</font> = 304</b>";
"trick_multiply_by_19_text" = "გამრავლება 19-ზე";
"trick_multiply_by_20_rule" = "trick_multiply_by_20_rule";
"trick_multiply_by_20_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 20 = 720</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 2-ზე: <br><b><font color=#c27171>36</font> × 2 = <font color=#7875fd>72</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 10-ზე: <br><b><font color=#7875fd>72</font> × 10 = 720</b>";
"trick_multiply_by_20_text" = "გამრავლება 20-ზე";
"trick_multiply_by_250_rule" = "trick_multiply_by_250_rule";
"trick_multiply_by_250_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 250 = 6250</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 4-ზე: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 1000-ზე: <br><b><font color=#7875fd>6.25</font> × 1000 = 6250</b>";
"trick_multiply_by_250_text" = "გამრავლება 250-ზე";
"trick_multiply_by_25_rule" = "trick_multiply_by_25_rule";
"trick_multiply_by_25_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 25 = 450</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 4-ზე: <br><b><font color=#c27171>18</font> / 4 = <font color=#7875fd>4.5</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 100-ზე: <br><b><font color=#7875fd>4.5</font> × 100 = 450</b>";
"trick_multiply_by_25_text" = "გამრავლება 25-ზე";
"trick_multiply_by_2_rule" = "trick_multiply_by_2_rule";
"trick_multiply_by_2_rule_text" = "-1";
"trick_multiply_by_2_text" = "გამრავლება 2-ზე";
"trick_multiply_by_3_rule" = "trick_multiply_by_3_rule";
"trick_multiply_by_3_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>32</font> × <font color=#888800>3</font> = 96</b>\n        <br>\n        <br><b><font color=#888800>3</font> = <font color=#7875fd>2</font> + <font color=#008800>1</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 2-ზე: <br><b><font color=#c27171>32</font> × <font color=#7875fd>2</font> = <font color=#aa7700>64</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემული რიცხვი გაამრავლეთ 1-ზე: <br><b><font color=#c27171>32</font> × <font color=#008800>1</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - 1 და 2 ნაბიჯის შედეგები შეკრიბეთ: <br><b><font color=#aa7700>64</font> + <font color=#6a379a>32</font> = 96</b>";
"trick_multiply_by_3_text" = "გამრავლება 3-ზე";
"trick_multiply_by_4_rule" = "trick_multiply_by_4_rule";
"trick_multiply_by_4_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>58</font> × 4 = 232</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 2-ზე: <br><b><font color=#c27171>58</font> × 2 = <font color=#7875fd>116</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 2-ზე: <br><b><font color=#7875fd>116</font> × 2 = 232</b>";
"trick_multiply_by_4_text" = "გამრავლება 4-ზე";
"trick_multiply_by_500_rule" = "trick_multiply_by_500_rule";
"trick_multiply_by_500_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 500 = 12500</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 2-ზე: <br><b><font color=#c27171>25</font> / 2 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 1000-ზე: <br><b><font color=#7875fd>12.5</font> × 1000 = 12500</b>";
"trick_multiply_by_500_text" = "გამრავლება 500-ზე";
"trick_multiply_by_50_rule" = "trick_multiply_by_50_rule";
"trick_multiply_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 50 = 900</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 2-ზე: <br><b><font color=#c27171>18</font> / 2 = <font color=#7875fd>9</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 100-ზე: <br><b><font color=#7875fd>9</font> × 100 = 900</b>";
"trick_multiply_by_50_text" = "გამრავლება 50-ზე";
"trick_multiply_by_5_rule" = "trick_multiply_by_5_rule";
"trick_multiply_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1234</font> × 5 = 6170</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით ორზე: <br><b><font color=#c27171>1234</font> / 2 = <font color=#7875fd>617</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 10-ზე: <br><b><font color=#7875fd>617</font> × 10 = 6170</b>";
"trick_multiply_by_5_text" = "გამრავლება 5-ზე";
"trick_multiply_by_6_rule" = "trick_multiply_by_6_rule";
"trick_multiply_by_6_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>6</font> = 96</b>\n        <br>\n        <br><b><font color=#888800>6</font> = 5 + 1 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>1</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 2-ზე: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემული რიცხვი გაამრავლეთ 10-ზე: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - მოცემული რიცხვი გაამრავლეთ 1-ზე: <br><b><font color=#c27171>16</font> × <font color=#008800>1</font> = <font color=#c27171>16</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 4</b></font> - 2 და 3 ნაბიჯის შედეგები შეკრიბეთ: <br><b><font color=#008888>80</font> + <font color=#c27171>16</font> = 96</b>";
"trick_multiply_by_6_text" = "გამრავლება 6-ზე";
"trick_multiply_by_750_rule" = "trick_multiply_by_750_rule";
"trick_multiply_by_750_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 750 = 18750</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 4-ზე: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 3-ზე: <br><b><font color=#7875fd>6.25</font> × 3 = <font color=#aa7700>18.75</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 1000-ზე: <br><b><font color=#aa7700>18.75</font> × 1000 = 18750</b>";
"trick_multiply_by_750_text" = "გამრავლება 750-ზე";
"trick_multiply_by_75_rule" = "trick_multiply_by_75_rule";
"trick_multiply_by_75_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>68</font> × 75 = 5100</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 4-ზე: <br><b><font color=#c27171>68</font> / 4 = <font color=#7875fd>17</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 3-ზე: <br><b><font color=#7875fd>17</font> × 3 = <font color=#aa7700>51</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 100-ზე: <br><b><font color=#aa7700>51</font> × 100 = 5100</b>";
"trick_multiply_by_75_text" = "გამრავლება 75-ზე";
"trick_multiply_by_7_rule" = "trick_multiply_by_7_rule";
"trick_multiply_by_7_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>7</font> = 112</b>\n        <br>\n        <br><b><font color=#888800>7</font> = 5 + 2 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაყავით 2-ზე: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემული რიცხვი გაამრავლეთ 10-ზე: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - მოცემული რიცხვი გაამრავლეთ 2-ზე: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#8c6745>32</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 4</b></font> - 2 და 3 ნაბიჯის შედეგები შეკრიბეთ: <br><b><font color=#008888>80</font> + <font color=#8c6745>32</font> = 112</b>";
"trick_multiply_by_7_text" = "გამრავლება 7-ზე";
"trick_multiply_by_8_rule" = "trick_multiply_by_8_rule";
"trick_multiply_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>8</font> = 128</b>\n        <br>\n        <br><b><font color=#888800>8</font> = <font color=#7875fd>10</font> - <font color=#aa7700>2</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 10-ზე: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#008888>160</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემული რიცხვი გაამრავლეთ 2-ზე: <br><b><font color=#c27171>16</font> × <font color=#aa7700>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - საკლებს გამოაკელით მეორე ეტაპი მიღებული შედეგი: <br><b><font color=#008888>160</font> - <font color=#6a379a>32</font> = 128</b>";
"trick_multiply_by_8_text" = "გამრავლება 8-ზე";
"trick_multiply_by_999_rule" = "trick_multiply_by_999_rule";
"trick_multiply_by_999_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 999 = 24975</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 1000-ზე: <br><b><font color=#c27171>25</font> × 1000 = <font color=#7875fd>25000</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგს გამოაკელით მოცემული რიცხვი: <br><b><font color=#7875fd>25000</font> - <font color=#c27171>25</font> = 24975</b>";
"trick_multiply_by_999_text" = "გამრავლება 999-ზე";
"trick_multiply_by_99_rule" = "trick_multiply_by_99_rule";
"trick_multiply_by_99_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>15</font> × 99 = 1485</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 100-ზე: <br><b><font color=#c27171>15</font> × 100 = <font color=#7875fd>1500</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგს გამოაკელით მოცემული რიცხვი: <br><b><font color=#7875fd>1500</font> - <font color=#c27171>15</font> = 1485</b>";
"trick_multiply_by_99_text" = "გამრავლება 99-ზე";
"trick_multiply_by_9_rule" = "trick_multiply_by_9_rule";
"trick_multiply_by_9_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>56</font> × 9 = 504</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გაამრავლეთ 10-ზე: <br><b><font color=#c27171>56</font> × 10 = <font color=#7875fd>560</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგს გამოაკელით მოცემული რიცხვი: <br><b><font color=#7875fd>560</font> - <font color=#c27171>56</font> = 504</b>";
"trick_multiply_by_9_text" = "გამრავლება 9-ზე";
"trick_multiply_numbers_between_11_and_19_rule" = "trick_multiply_numbers_between_11_and_19_rule";
"trick_multiply_numbers_between_11_and_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>1<font color=#c27171>4</font> × <font color=#7875fd>1</font><font color=#008800>8</font> = 252</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - თანამამრავლებიდან უდიდესს მივუმატოთ უმცირესის მარჯვენა ციფრი: <br><b><font color=#7875fd>1</font><font color=#008800>8</font> + <font color=#c27171>4</font> = <font color=#6a379a>22</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველ ნაბიჯზე მიღებულ შედეგს ბოლოში დავუმატოთ 0: <br><b><font color=#6a379a>22</font> × 10 = <font color=#888800>220</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - გადავამრავლოთ მოცემული თანამამრავლების მარჯვენა ციფრები ერთმანეთზე: <br><b><font color=#008800>8</font> x <font color=#c27171>4</font> = <font color=#aa7700>32</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 4</b></font> - მეორე და მესამე ნაბიჯებზე მიღებული შედეგები შევკრიბოთ: <br><b><font color=#888800>220</font> + <font color=#aa7700>32</font> = 252</b>";
"trick_multiply_numbers_between_11_and_19_text" = "11 და 19 შორის ციფრების გადამარავლება";
"trick_multiply_two_digit_numbers_editing_in_1_rule" = "trick_multiply_two_digit_numbers_editing_in_1_rule";
"trick_multiply_two_digit_numbers_editing_in_1_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>5</font>1 × <font color=#7875fd>3</font>1 = 1581</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - გადაამრავლეთ თანამამრავლების პირველი ციფრები: <br><b><font color=#c27171>5</font> × <font color=#7875fd>3</font> = <font color=#008800>15</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - შეკრიბეთ თანამამრავლების პირველი ციფრები: <br><b><font color=#c27171>5</font> + <font color=#7875fd>3</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - მეორე ნაბიჯზე მიღებული შედეგი დასვით პირველ ნაბიჯზე მიღებული შედეგის მარჯვნივ: <br><b><font color=#008800>15</font>_<font color=#888800>8</font> = 158</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 4</b></font> - დასვით 1-იანი მესამე ნაბიჯზე მიღებული შედეგის ბოლოში: <br><b><font color=#008800>15</font>_<font color=#888800>8</font>_1 = 1581</b>";
"trick_multiply_two_digit_numbers_editing_in_1_text" = "1-ზე დაბოლოებული ორნიშნა ციფრების გადამრავლება";
"trick_multiply_two_digit_numbers_having_same_tens_rule" = "trick_multiply_two_digit_numbers_having_same_tens_rule";
"trick_multiply_two_digit_numbers_having_same_tens_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>2</font><font color=#7875fd>3</font> × <font color=#c27171>2</font><font color=#008800>7</font> = 621</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - რიცხვის პირველი ციფრის და 1-ის ჯამი გადავამრავლოთ რიცხვის პირველ ციფრზე: <br><b><font color=#c27171>2</font> × (<font color=#c27171>2</font> + 1) = <font color=#6a379a>6</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - გადაამრავლეთ მარჯვენა ციფრები ერთმანეთზე (თუ შედეგად მიიღეთ ერთნიშნა რიცხვი, წინ დაუმატეთ 0): <br><b><font color=#7875fd>3</font> × <font color=#008800>7</font> = <font color=#888800>21</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - მეორე ნაბიჯზე მიღებული შედეგი, პირველ ნაბიჯზე მიღებულ შედეგს დაუსვით მარჯვნიდან: <br><b><font color=#6a379a>6</font>_<font color=#888800>21</font> = 621</b>";
"trick_multiply_two_digit_numbers_having_same_tens_text" = "ორნიშნა ციფრების გადამრავლება, რომლებსაც ერთნაირი ათობითი ციფრი აქვთ, და რომელთა ათობითი ციფრის ჯამი 10-ის ტოლია";
"trick_percent_2_rule" = "trick_percent_2_rule";
"trick_percent_2_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>6</font>% → 350 = 21</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - <font color=#c27171>6</font>% → 100 = <b><font color=#c27171>6</font></b> (<font color=#c27171>6</font> თითოეული ასეულისთვის)\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - <font color=#c27171>6</font>% → 300 = <b><font color=#6a379a>18</font></b> (გაამრავლეთ პირველი ნაბიჯის შედეგი <font color=#7875fd>3</font>-ზე)\n        <br>\n        <br><i>[100 × <font color=#7875fd>3</font> = 300] → [<font color=#c27171>6</font> × <font color=#7875fd>3</font> = <font color=#6a379a>18</font>]</i>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - <font color=#c27171>6</font>% → 50 = <b><font color=#aa7700>3</font></b> (გაყავით პირველი ნაბიჯის შედეგი <font color=#888800>2</font>-ზე)\n        <br>\n        <br><i>[100 / <font color=#888800>2</font> = 50] → [<font color=#c27171>6</font> / <font color=#888800>2</font> = <font color=#aa7700>3</font>]</i>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 4</b></font> - მეორე და მესამე ნაბიჯის შედეგები შეკრიბეთ: <br><b><font color=#6a379a>18</font> + <font color=#aa7700>3</font> = 21</b>";
"trick_percent_2_text" = "რიცხვის პროცენტი -2-";
"trick_percent_rule" = "trick_percent_rule";
"trick_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>15% → <font color=#c27171>300</font> = 45</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - გამოითვალეთ 10% (გაყავით ციფრი 10-ზე): <br><b><font color=#c27171>300</font> / 10 = <font color=#7875fd>30</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - გამოითვალეთ 5% (გაყავით პირველი ნაბიჯის შედეგი 2-ზე: <br><b><font color=#7875fd>30</font> / 2 = <font color=#008800>15</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - პირველი და მეორე ნაბიჯის შედეგები შეკრიბეთ: <br><b><font color=#7875fd>30</font> + <font color=#008800>15</font> = 45</b>";
