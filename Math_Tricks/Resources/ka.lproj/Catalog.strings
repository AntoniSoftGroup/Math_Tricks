"trick_square_number_between_100_and_109_rule" = "trick_square_number_between_100_and_109_rule";
"trick_square_number_between_100_and_109_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>10</font><font color=#7875fd>3</font><small><sup>2</sup></small> = 10609</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემულ რიცხვს მიუმატეთ მოცემულ რიცხვის ბოლო ციფრი: <br><b><font color=#c27171>10</font><font color=#7875fd>3</font> + <font color=#7875fd>3</font> = <font color=#888800>106</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - მოცემულ რიცხვის ბოლო ციფრი აიყვანეთ კვადრატში (თუ შედეგად მიიღეთ ერთნიშნა ციფრი, წინ დაუმატეთ 0): <br><b><font color=#7875fd>3</font><small><sup>2</sup></small> = 0<font color=#008800>9</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - მეორე ნაბიჯის შედეგი დასვით პირველი ნაბიჯის შედეგის მარჯვნივ: <br><b><font color=#888800>106</font>_0<font color=#008800>9</font> = 10609</b>";
"trick_square_number_between_100_and_109_text" = "100 და 109 შორის ციფრების ახარისხება კვადრატში";
"trick_square_number_between_10_and_19_rule" = "trick_square_number_between_10_and_19_rule";
"trick_square_number_between_10_and_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1</font><font color=#7875fd>4</font><small><sup>2</sup></small> = 196</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემულ რიცხვს მიუმატეთ მოცემულ რიცხვის ბოლო ციფრი: <br><b><font color=#c27171>1</font><font color=#7875fd>4</font> + <font color=#7875fd>4</font> = <font color=#008800>18</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველი ნაბიჯის შედეგი გაამრავლეთ 10-ზე: <br><b><font color=#008800>18</font> × 10 = <font color=#888800>180</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - მოცემულ რიცხვის ბოლო ციფრი აიყვანეთ კვადრატში: <br><b><font color=#7875fd>4</font><small><sup>2</sup></small> = <font color=#6a379a>16</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 4</b></font> - 2 და 3 ნაბიჯის შედეგები შეკრიბეთ: <br><b><font color=#888800>180</font> + <font color=#6a379a>16</font> = 196</b>";
"trick_square_number_between_10_and_19_text" = "10 და 19 შორის ციფრების ახარისხება კვადრატში";
"trick_square_number_between_11_and_99_rule" = "trick_square_number_between_11_and_99_rule";
"trick_square_number_between_11_and_99_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>97</font><small><sup>2</sup></small> = 9409</b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 1</b></font> - მოცემული რიცხვი გამოვაკლოთ 100-ს: <br><b>100 - <font color=#c27171>97</font> = <font color=#7875fd>3</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 2</b></font> - პირველ ნაბიჯზე მიღებული შედეგი გამოვაკლოთ მოცემულ რიცხვს: <br><b><font color=#c27171>97</font> - <font color=#7875fd>3</font> = <font color=#008800>94</font></b>\n        <br>\n        <br><font color=#666666><b>ნაბიჯი 3</b></font> - აიყვანეთ კვადრატში, პირველი ნაბიჯის შედეგი (თუ შედეგად მიიღეთ ერთნიშნა რიცხვი, წინ დაუმატეთ 0): <br><b><font color=#7875fd>3</font><small><sup>2</sup></small> = <font color=#6a379a>09</font></b>\n\t\t<br>\n        <br><font color=#666666><b>ნაბიჯი 4</b></font> - მესამე ნაბიჯზე მიღებული შედეგი, მეორე ნაბიჯზე მიღებულ შედეგს დავუსვათ მარჯვნიდან: <br><b><font color=#008800>94</font>_<font color=#6a379a>09</font> = 9409</b>";
