"trick_multiply_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1234</font> × 5 = 6170</b>\n        <br>\n        <br><font color=#666666><b>שלב 1</b></font> - <br>חלק את המספר ב-2: <br><b><font color=#c27171>1234</font> / 2 = <font color=#7875fd>617</font></b>\n        <br>\n        <br><font color=#666666><b>שלב 2</b></font> - <br>הכפל את התוצאה משלב 1 ב-10: <br><b><font color=#7875fd>617</font> × 10 = 6170</b>";
"trick_multiply_by_5_text" = "הכפלה ב-5";
"trick_multiply_by_6_rule" = "trick_multiply_by_6_rule";
"trick_multiply_by_6_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>6</font> = 96</b>\n        <br>\n        <br><b><font color=#888800>6</font> = 5 + 1 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>1</font></b>\n        <br>\n        <br><font color=#666666><b>שלב 1</b></font> - <br>חלק את המספר ב-2: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>שלב 2</b></font> - <br>הכפל את התוצאה משלב 1 ב-10: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>שלב 3</b></font> - <br>הכפל את המספר ב-1: <br><b><font color=#c27171>16</font> × <font color=#008800>1</font> = <font color=#c27171>16</font></b>\n        <br>\n        <br><font color=#666666><b>שלב 4</b></font> - <br>חבר את שלב 2 ושלב 3: <br><b><font color=#008888>80</font> + <font color=#c27171>16</font> = 96</b>";
"trick_multiply_by_6_text" = "הכפלה ב-6";
"trick_multiply_by_750_rule" = "trick_multiply_by_750_rule";
"trick_multiply_by_750_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 750 = 18750</b>\n        <br>\n        <br><font color=#666666><b>שלב 1</b></font> - <br>חלק את המספר ב-4: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>שלב 2</b></font> - <br>הכפל את התוצאה משלב 1 ב-3: <br><b><font color=#7875fd>6.25</font> × 3 = <font color=#aa7700>18.75</font></b>\n        <br>\n        <br><font color=#666666><b>שלב 3</b></font> - <br>הכפל את התוצאה משלב 2 ב-1000: <br><b><font color=#aa7700>18.75</font> × 1000 = 18750</b>";
