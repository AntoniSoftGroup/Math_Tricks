"trick_multiply_by_500_text" = "הכפלה ב-500";
"trick_multiply_by_50_rule" = "trick_multiply_by_50_rule";
"trick_multiply_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 50 = 900</b>\n        <br>\n        <br><font color=#666666><b>שלב 1</b></font> - <br>חלק את המספר ב-2: <br><b><font color=#c27171>18</font> / 2 = <font color=#7875fd>9</font></b>\n        <br>\n        <br><font color=#666666><b>שלב 2</b></font> - <br>הכפל את התוצאה משלב 1 ב-100: <br><b><font color=#7875fd>9</font> × 100 = 900</b>";
