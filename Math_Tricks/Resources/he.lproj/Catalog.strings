"trick_multiply_by_3_text" = "הכפלה ב-3";
"trick_multiply_by_4_rule" = "trick_multiply_by_4_rule";
"trick_multiply_by_4_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>58</font> × 4 = 232</b>\n        <br>\n        <br><font color=#666666><b>שלב 1</b></font> - <br>הכפל את המספר ב-2: <br><b><font color=#c27171>58</font> × 2 = <font color=#7875fd>116</font></b>\n        <br>\n        <br><font color=#666666><b>שלב 2</b></font> - <br>הכפל את התוצאה משלב 1 ב-2: <br><b><font color=#7875fd>116</font> × 2 = 232</b>";
