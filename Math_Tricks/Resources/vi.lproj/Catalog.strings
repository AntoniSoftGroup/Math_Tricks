"trick_multiply_by_02_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>125</font> × 0.2 = 25</b>\n        <br>\n        <br><font color=#666666><b>Bước 1</b></font> - Chia số này cho 10: <br><b><font color=#c27171>125</font> / 10 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>Bước 2</b></font> - Nhân kết quả từ Bước 1 với 2: <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
