<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>results_share_clean_intro</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Посмотри на мои лучшие результаты: %1$lld пример! Суммарное время — %2$@, среднее на один пример — %3$@.</string>
			<key>few</key>
			<string>Посмотри на мои лучшие результаты: %1$lld примера! Суммарное время — %2$@, среднее на один пример — %3$@.</string>
			<key>many</key>
			<string>Посмотри на мои лучшие результаты: %1$lld примеров! Суммарное время — %2$@, среднее на один пример — %3$@.</string>
			<key>other</key>
			<string>Посмотри на мои лучшие результаты: %1$lld примера! Суммарное время — %2$@, среднее на один пример — %3$@.</string>
		</dict>
	</dict>
	<key>results_share_tricks_intro</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@count@</string>
		<key>count</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Я решил %1$lld пример!</string>
			<key>few</key>
			<string>Я решил %1$lld примера!</string>
			<key>many</key>
			<string>Я решил %1$lld примеров!</string>
			<key>other</key>
			<string>Я решил %1$lld примера!</string>
		</dict>
	</dict>
</dict>
</plist>
