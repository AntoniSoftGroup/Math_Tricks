"trick_adding_numbers_close_to_hundreds_rule" = "trick_adding_numbers_close_to_hundreds_rule";
"trick_adding_numbers_close_to_hundreds_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>159</font> + <font color=#7875fd>192</font> = 351</b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Arotondare il secondo numero: <br><b><font color=#7875fd>192</font> + <font color=#008800>8</font> = <font color=#aa7700>200</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Somma il primo numero con il numero arrotondato: <br><b><font color=#aa7700>200</font> + <font color=#c27171>159</font> = <font color=#6a379a>359</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 3</b></font> - Sottrare (o sommare) numero (con il quale e stato arrotondato il secondo numero) con (da) il risultante dal secondo passo: <br><b><font color=#6a379a>359</font> - <font color=#008800>8</font> = 351</b>";
