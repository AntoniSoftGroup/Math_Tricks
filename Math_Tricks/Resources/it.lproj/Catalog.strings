"trick_multiplication_text" = "Tabelline";
"trick_multiply_by_025_rule" = "trick_multiply_by_025_rule";
"trick_multiply_by_025_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>20</font> × 0.25 = 5</b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Dividere il numero iniziale a 4: <br><b><font color=#c27171>20</font> / 4 = 5</b>";
"trick_multiply_by_025_text" = "Moltiplicare per 0.25";
"trick_multiply_by_02_rule" = "trick_multiply_by_02_rule";
"trick_multiply_by_02_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>125</font> × 0.2 = 25</b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Dividere il numero iniziale a 10: <br><b><font color=#c27171>125</font> / 10 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Moltiplicare il risultato del primo passo a 2: <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
"trick_multiply_by_02_text" = "Moltiplicare per 0.2";
"trick_multiply_by_05_rule" = "trick_multiply_by_05_rule";
"trick_multiply_by_05_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 0.5 = 9</b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Dividere il numero iniziale a 2: <br><b><font color=#c27171>18</font> / 2 = 9</b>";
"trick_multiply_by_05_text" = "Moltiplicare per 0.5";
"trick_multiply_by_11_2digit_rule" = "trick_multiply_by_11_2digit_rule";
"trick_multiply_by_11_2digit_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>3</font><font color=#7875fd>5</font> × 11 = 385</b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Somma le cifre che compongono il numero a due cifre: <br><b><font color=#c27171>3</font> + <font color=#7875fd>5</font> = <font color=#008800>8</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Aggiunge il risultato tra le due cifre: <br><b><font color=#c27171>3</font>_<font color=#008800>8</font>_<font color=#7875fd>5</font> = 385</b>\n        <br>\n        <br>\n        <br><b><u>-2-</u></b>\n        <br>\n        <br><b><font color=#c27171>7</font><font color=#7875fd>8</font> × 11 = 858</b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Somma le cifre che compongono il numero a due cifre: <br><b><font color=#c27171>7</font> + <font color=#7875fd>8</font> = <font color=#6a379a>1</font><font color=#aa7700>5</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Aggiunge 1, se il risultato è maggiore, di 9: <br><b><font color=#c27171>7</font> + <font color=#6a379a>1</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 3</b></font> - Scrivere il risultato tra le due cifre: <br><b><font color=#888800>8</font>_<font color=#aa7700>5</font>_<font color=#7875fd>8</font> = 858</b>";
"trick_multiply_by_11_2digit_text" = "Moltiplicare numero di due cifre da 11";
"trick_multiply_by_125_rule" = "trick_multiply_by_125_rule";
"trick_multiply_by_125_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 125 = 3125</b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Dividere il numero iniziale a 8: <br><b><font color=#c27171>25</font> / 8 = <font color=#7875fd>3.125</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Moltiplicare il risultato del primo passo a 1000: <br><b><font color=#7875fd>3.125</font> × 1000 = 3125</b>";
"trick_multiply_by_125_text" = "Moltiplicare per 125";
"trick_multiply_by_12_rule" = "trick_multiply_by_12_rule";
"trick_multiply_by_12_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>12</font> = 192</b>\n        <br>\n        <br><b><font color=#888800>12</font> = <font color=#7875fd>10</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Moltiplicare il numero iniziale a 10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Moltiplicare il numero iniziale a 2: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 3</b></font> - Sommare i resultati dei passi 1 e 2: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>32</font> = 192</b>";
"trick_multiply_by_12_text" = "Moltiplicare per 12";
"trick_multiply_by_13_rule" = "trick_multiply_by_13_rule";
"trick_multiply_by_13_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>13</font> = 208</b>\n        <br>\n        <br><b><font color=#888800>13</font> = <font color=#7875fd>10</font> + <font color=#008800>3</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Moltiplicare il numero iniziale a 10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Moltiplicare il numero iniziale a 3: <br><b><font color=#c27171>16</font> × <font color=#008800>3</font> = <font color=#6a379a>48</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 3</b></font> - Sommare i resultati dei passi 1 e 2: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>48</font> = 208</b>";
"trick_multiply_by_13_text" = "Moltiplicare per 13";
"trick_multiply_by_14_rule" = "trick_multiply_by_14_rule";
"trick_multiply_by_14_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>14</font> = 224</b>\n        <br>\n        <br><b><font color=#888800>14</font> = <font color=#7875fd>10</font> + <font color=#008800>4</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Moltiplicare il numero iniziale a 10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Moltiplicare il numero iniziale a 4: <br><b><font color=#c27171>16</font> × <font color=#008800>4</font> = <font color=#6a379a>64</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 3</b></font> - Sommare i resultati dei passi 1 e 2: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>64</font> = 224</b>";
"trick_multiply_by_14_text" = "Moltiplicare per 14";
"trick_multiply_by_15_rule" = "trick_multiply_by_15_rule";
"trick_multiply_by_15_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 15 = 540</b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Moltiplicare il numero iniziale a 10: <br><b><font color=#c27171>36</font> × 10 = <font color=#7875fd>360</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Dividere il risultato del primo passo a 2: <br><b><font color=#7875fd>360</font> / 2 = <font color=#008800>180</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 3</b></font> - Sommare i risultati del 1 e 2 passo: <br><b><font color=#7875fd>360</font> + <font color=#008800>180</font> = 540</b>";
"trick_multiply_by_15_text" = "Moltiplicare per 15";
"trick_multiply_by_16_rule" = "trick_multiply_by_16_rule";
"trick_multiply_by_16_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>16</font> = 224</b>\n        <br>\n        <br><b><font color=#7875fd>16</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>1</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Moltiplicare il numero iniziale a 10: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Moltiplicare il numero iniziale a 5: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 3</b></font> - Moltiplicare il numero iniziale a 1: <br><b><font color=#c27171>14</font> × <font color=#b265cf>1</font> = <font color=#c27171>14</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 4</b></font> - Sommare i resultati dei passi 1, 2 e 3: <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#c27171>14</font> = 224</b>";
"trick_multiply_by_16_text" = "Moltiplicare per 16";
"trick_multiply_by_17_rule" = "trick_multiply_by_17_rule";
"trick_multiply_by_17_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>17</font> = 238</b>\n        <br>\n        <br><b><font color=#7875fd>17</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>2</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Moltiplicare il numero iniziale a 10: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Moltiplicare il numero iniziale a 5: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 3</b></font> - Moltiplicare il numero iniziale a 2: <br><b><font color=#c27171>14</font> × <font color=#b265cf>2</font> = <font color=#008888>28</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 4</b></font> - Sommare i resultati dei passi 1, 2 e 3: <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#008888>28</font> = 238</b>";
"trick_multiply_by_17_text" = "Moltiplicare per 17";
"trick_multiply_by_18_rule" = "trick_multiply_by_18_rule";
"trick_multiply_by_18_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>18</font> = 288</b>\n        <br>\n        <br><b><font color=#888800>18</font> = <font color=#7875fd>20</font> - <font color=#aa7700>2</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Moltiplicare il numero iniziale a 20: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Moltiplicare il numero iniziale a 2: <br><b><font color=#c27171>16</font> × <font color=#aa7700>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 3</b></font> - Sottrarre il risultato del 2 passo dal 1 passo: <br><b><font color=#008888>320</font> - <font color=#6a379a>32</font> = 288</b>";
"trick_multiply_by_18_text" = "Moltiplicare per 18";
"trick_multiply_by_19_rule" = "trick_multiply_by_19_rule";
"trick_multiply_by_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>19</font> = 304</b>\n        <br>\n        <br><b><font color=#888800>19</font> = <font color=#7875fd>20</font> - <font color=#aa7700>1</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Moltiplicare il numero iniziale a 20: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Moltiplicare il numero iniziale a 1: <br><b><font color=#c27171>16</font> × <font color=#aa7700>1</font> = <font color=#6a379a>16</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 3</b></font> - Sottrarre il risultato del 2 passo dal 1 passo: <br><b><font color=#008888>320</font> - <font color=#6a379a>16</font> = 304</b>";
"trick_multiply_by_19_text" = "Moltiplicare per 19";
"trick_multiply_by_20_rule" = "trick_multiply_by_20_rule";
"trick_multiply_by_20_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 20 = 720</b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Moltiplicare il numero iniziale a 2: <br><b><font color=#c27171>36</font> × 2 = <font color=#7875fd>72</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Moltiplicare il risultato del primo passo a 10: <br><b><font color=#7875fd>72</font> × 10 = 720</b>";
"trick_multiply_by_20_text" = "Moltiplicare per 20";
"trick_multiply_by_250_rule" = "trick_multiply_by_250_rule";
"trick_multiply_by_250_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 250 = 6250</b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Dividere il numero iniziale a 4: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Moltiplicare il risultato del primo passo a 1000: <br><b><font color=#7875fd>6.25</font> × 1000 = 6250</b>";
"trick_multiply_by_250_text" = "Moltiplicare per 250";
"trick_multiply_by_25_rule" = "trick_multiply_by_25_rule";
"trick_multiply_by_25_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 25 = 450</b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Dividere il numero iniziale a 4: <br><b><font color=#c27171>18</font> / 4 = <font color=#7875fd>4.5</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Moltiplicare il risultato del primo passo a 100: <br><b><font color=#7875fd>4.5</font> × 100 = 450</b>";
"trick_multiply_by_25_text" = "Moltiplicare per 25";
