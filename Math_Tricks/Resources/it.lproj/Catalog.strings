"trick_05_percent_rule" = "trick_05_percent_rule";
"trick_05_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>0.5</font>% → <font color=#7875fd>600</font> = 3</b>\n        <br>\n        <br><font color=#666666><b>Passo 1</b></font> - Dividere il numero iniziale a 100: <br><b><font color=#7875fd>600</font> / 100 = <font color=#008800>6</font></b>\n        <br>\n        <br><font color=#666666><b>Passo 2</b></font> - Dividere il risultato del primo passo a 2: <br><b><font color=#008800>6</font> / 2 = 3";
