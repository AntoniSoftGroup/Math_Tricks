"trick_square_number_between_10_and_19_rule" = "trick_square_number_between_10_and_19_rule";
"trick_square_number_between_10_and_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1</font><font color=#7875fd>4</font><small><sup>2</sup></small> = 196</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - เพิ่มจำนวนเข้าไปที่หลักหน่วย: <br><b><font color=#c27171>1</font><font color=#7875fd>4</font> + <font color=#7875fd>4</font> = <font color=#008800>18</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 10: <br><b><font color=#008800>18</font> × 10 = <font color=#888800>180</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - ยกกำลังสองของจำนวนหลักหน่วย: <br><b><font color=#7875fd>4</font><small><sup>2</sup></small> = <font color=#6a379a>16</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 4</b></font> - บวกเพิ่มขั้นตอนที่ 2 และขั้นตอนที่ 3: <br><b><font color=#888800>180</font> + <font color=#6a379a>16</font> = 196</b>";
"trick_square_number_between_10_and_19_text" = "เลขยกกำลังระหว่าง 10 และ 19";
"trick_square_number_between_11_and_99_rule" = "trick_square_number_between_11_and_99_rule";
"trick_square_number_between_11_and_99_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>97</font><small><sup>2</sup></small> = 9409</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - ลบจำนวนด้วย 100: <br><b>100 - <font color=#c27171>97</font> = <font color=#7875fd>3</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - ลบจำนวน (จากขั้นตอนที่ 1) ออกจากจำนวนเริ่มต้น: <br><b><font color=#c27171>97</font> - <font color=#7875fd>3</font> = <font color=#008800>94</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - ยกกำลังสองของผลลัพธ์จากขั้นตอนที่ 1 (ถ้าผลลัพธ์ที่ได้คือตัวเลขหลักเดียว ให้ใส่ 0 ที่ด้านหน้าของมัน): <br><b><font color=#7875fd>3</font><small><sup>2</sup></small> = <font color=#6a379a>09</font></b>\n\t\t<br>\n        <br><font color=#666666><b>ขั้นตอนที่ 4</b></font> - วางผลลัพธ์ที่ได้จากขั้นตอนที่ 3 ถัดจากผลลัพธ์ที่ได้จากขั้นตอนที่ 2: <br><b><font color=#008800>94</font>_<font color=#6a379a>09</font> = 9409</b>";
"trick_square_number_between_11_and_99_text" = "เลขยกกำลังระหว่าง 90 และ 99";
"trick_square_number_between_20_and_29_rule" = "trick_square_number_between_20_and_29_rule";
"trick_square_number_between_20_and_29_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>23</font><small><sup>2</sup></small> = 529</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - <b><font color=#c27171>23</font> = 20 + 3 => <font color=#008888>20</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - <b><font color=#c27171>23</font> = 20 + 3 => <font color=#7875fd>3</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - ยกกำลังสองของผลลัพธ์จากขั้นตอนที่ 1: <br><b><font color=#008888>20</font><small><sup>2</sup></small> = <font color=#008800>400</font></b>\n\t\t<br>\n\t\t<br><font color=#666666><b>ขั้นตอนที่ 4</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 2 ด้วย 40: <br><b><font color=#7875fd>3</font> × 40 = <font color=#888800>120</font></b>\n\t\t<br>\t\t\n        <br><font color=#666666><b>ขั้นตอนที่ 5</b></font> - ยกกำลังสองของผลลัพธ์จากขั้นตอนที่ 2: <br><b><font color=#7875fd>3</font><small><sup>2</sup></small> = <font color=#6a379a>9</font></b>\t\t\n\t\t<br>\n\t\t<br><font color=#666666><b>ขั้นตอนที่ 6</b></font> - บวกเพิ่มขั้นตอนที่ 3 และขั้นตอนที่ 4: <br><b><font color=#008800>400</font> + <font color=#888800>120</font> = <font color=#aa7700>520</font></b>\n\t\t<br>\t\t\n        <br><font color=#666666><b>ขั้นตอนที่ 7</b></font> - บวกเพิ่มขั้นตอนที่ 5 และขั้นตอนที่ 6: <br><b><font color=#aa7700>520</font> + <font color=#6a379a>9</font> = 529</b>";
"trick_square_number_between_20_and_29_text" = "เลขยกกำลังระหว่าง 20 และ  29";
"trick_square_number_between_30_and_39_rule" = "trick_square_number_between_30_and_39_rule";
"trick_square_number_between_30_and_39_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>34</font><small><sup>2</sup></small> = 1156</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - <b><font color=#c27171>34</font> = 30 + 4 => <font color=#008888>30</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - <b><font color=#c27171>34</font> = 30 + 4 => <font color=#7875fd>4</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - ยกกำลังสองของผลลัพธ์จากขั้นตอนที่ 1: <br><b><font color=#008888>30</font><small><sup>2</sup></small> = <font color=#008800>900</font></b>\n\t\t<br>\n\t\t<br><font color=#666666><b>ขั้นตอนที่ 4</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 2 ด้วย 60: <br><b><font color=#7875fd>4</font> × 60 = <font color=#888800>240</font></b>\n\t\t<br>\t\t\n        <br><font color=#666666><b>ขั้นตอนที่ 5</b></font> - ยกกำลังสองของผลลัพธ์จากขั้นตอนที่ 2: <br><b><font color=#7875fd>4</font><small><sup>2</sup></small> = <font color=#6a379a>16</font></b>\t\t\n\t\t<br>\n\t\t<br><font color=#666666><b>ขั้นตอนที่ 6</b></font> - บวกเพิ่มขั้นตอนที่ 3 และขั้นตอนที่ 4: <br><b><font color=#008800>900</font> + <font color=#888800>240</font> = <font color=#aa7700>1140</font></b>\n\t\t<br>\t\t\n        <br><font color=#666666><b>ขั้นตอนที่ 7</b></font> - บวกเพิ่มขั้นตอนที่ 5 และขั้นตอนที่ 6: <br><b><font color=#aa7700>1140</font> + <font color=#6a379a>16</font> = 1156</b>";
