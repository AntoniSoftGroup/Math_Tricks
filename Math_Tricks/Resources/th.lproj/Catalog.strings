"trick_dividing_by_05_text" = "หารด้วย 0.5";
"trick_dividing_by_15_rule" = "trick_dividing_by_15_rule";
"trick_dividing_by_15_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>315</font> / <font color=#7875fd>15</font> = 21</b>\n        <br>\n        <br><b><font color=#7875fd>15</font> = <font color=#008800>10</font> × <font color=#888800>3</font> / <font color=#b265cf>2</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 10: <br><b><font color=#c27171>315</font> / <font color=#008800>10</font> = <font color=#aa7700>31.5</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - หารผลลัพธ์ที่ได้จากขั้นตอนที่ 1 ด้วย 3: <br><b><font color=#aa7700>31.5</font> / <font color=#888800>3</font> = <font color=#8c6745>10.5</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 2 ด้วย 2: <br><b><font color=#8c6745>10.5</font> × <font color=#b265cf>2</font> = 21</b>";
"trick_dividing_by_15_text" = "หารด้วย 15";
"trick_dividing_by_20_rule" = "trick_dividing_by_20_rule";
"trick_dividing_by_20_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1260</font> / 20 = 63</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 10: <br><b><font color=#c27171>1260</font> / 10 = <font color=#7875fd>126</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - หารผลลัพธ์ที่ได้จากขั้นตอนที่ 1 ด้วย 2: <br><b><font color=#7875fd>126</font> / 2 = 63</b>";
"trick_dividing_by_20_text" = "หารด้วย 20";
"trick_dividing_by_25_rule" = "trick_dividing_by_25_rule";
"trick_dividing_by_25_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1250</font> / 25 = 50</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 100: <br><b><font color=#c27171>1250</font> / 100 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 4: <br><b><font color=#7875fd>12.5</font> × 4 = 50</b>";
"trick_dividing_by_25_text" = "หารด้วย 25";
"trick_dividing_by_2_rule" = "trick_dividing_by_2_rule";
"trick_dividing_by_2_rule_text" = "-1";
"trick_dividing_by_2_text" = "หารด้วย 2";
"trick_dividing_by_3_rule" = "trick_dividing_by_3_rule";
"trick_dividing_by_3_rule_text" = "-1";
"trick_dividing_by_3_text" = "หารด้วย 3";
"trick_dividing_by_40_rule" = "trick_dividing_by_40_rule";
"trick_dividing_by_40_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1280</font> / 40 = 32</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 10: <br><b><font color=#c27171>1280</font> / 10 = <font color=#7875fd>128</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - หารผลลัพธ์ที่ได้จากขั้นตอนที่ 1 ด้วย 4: <br><b><font color=#7875fd>128</font> / 4 = 32</b>";
"trick_dividing_by_40_text" = "หารด้วย 40";
"trick_dividing_by_4_rule" = "trick_dividing_by_4_rule";
"trick_dividing_by_4_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>64</font> / 4 = 16</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 2: <br><b><font color=#c27171>64</font> / 2 = <font color=#7875fd>32</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - หารผลลัพธ์ที่ได้จากขั้นตอนที่ 1 ด้วย 2: <br><b><font color=#7875fd>32</font> / 2 = 16</b>";
"trick_dividing_by_4_text" = "หารด้วย 4";
"trick_dividing_by_50_rule" = "trick_dividing_by_50_rule";
"trick_dividing_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1250</font> / 50 = 25</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 100: <br><b><font color=#c27171>1250</font> / 100 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 2: <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
"trick_dividing_by_50_text" = "หารด้วย 50";
"trick_dividing_by_5_rule" = "trick_dividing_by_5_rule";
"trick_dividing_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1235</font> / 5 = 247</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 10: <br><b><font color=#c27171>1235</font> / 10 = <font color=#7875fd>123.5</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 2: <br><b><font color=#7875fd>123.5</font> × 2 = 247</b>";
"trick_dividing_by_5_text" = "หารด้วย 5";
"trick_dividing_by_6_rule" = "trick_dividing_by_6_rule";
"trick_dividing_by_6_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>126</font> / <font color=#7875fd>6</font> = 21</b>\n        <br>\n        <br><b><font color=#7875fd>6</font> = <font color=#008800>3</font> × <font color=#888800>2</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 2: <br><b><font color=#c27171>126</font> / <font color=#888800>2</font> = <font color=#aa7700>63</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - หารผลลัพธ์ที่ได้จากขั้นตอนที่ 1 ด้วย 3: <br><b><font color=#aa7700>63</font> / <font color=#008800>3</font> = 21";
"trick_dividing_by_6_text" = "หารด้วย 6";
"trick_dividing_by_7_rule" = "trick_dividing_by_7_rule";
"trick_dividing_by_7_rule_text" = "-1";
"trick_dividing_by_7_text" = "หารด้วย 7";
"trick_dividing_by_8_rule" = "trick_dividing_by_8_rule";
"trick_dividing_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>128</font> / <font color=#7875fd>8</font> = 16</b>\n        <br>\n        <br><b><font color=#7875fd>8</font> = <font color=#008800>2</font> × <font color=#888800>2</font> × <font color=#6a379a>2</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 2: <br><b><font color=#c27171>128</font> / <font color=#008800>2</font> = <font color=#aa7700>64</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - หารผลลัพธ์ที่ได้จากขั้นตอนที่ 1 ด้วย 2: <br><b><font color=#aa7700>64</font> / <font color=#888800>2</font> = <font color=#008888>32</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - หารผลลัพธ์ที่ได้จากขั้นตอนที่ 2 ด้วย 2: <br><b><font color=#008888>32</font> / <font color=#6a379a>2</font> = 16";
"trick_dividing_by_8_text" = "หารด้วย 8";
"trick_dividing_by_9_rule" = "trick_dividing_by_9_rule";
"trick_dividing_by_9_rule_text" = "-1";
"trick_dividing_by_9_text" = "หารด้วย 9";
"trick_division_rule" = "trick_division_rule";
"trick_division_rule_text" = "-1";
"trick_division_text" = "การหาร";
"trick_multiplication_rule" = "trick_multiplication_rule";
"trick_multiplication_rule_text" = "-1";
"trick_multiplication_text" = "ตารางสูตรคูณ";
"trick_multiply_by_025_rule" = "trick_multiply_by_025_rule";
"trick_multiply_by_025_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>20</font> × 0.25 = 5</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 4: <br><b><font color=#c27171>20</font> / 4 = 5</b>";
"trick_multiply_by_025_text" = "คูณด้วย 0.25";
"trick_multiply_by_02_rule" = "trick_multiply_by_02_rule";
"trick_multiply_by_02_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>125</font> × 0.2 = 25</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 10: <br><b><font color=#c27171>125</font> / 10 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 2: <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
"trick_multiply_by_02_text" = "คูณด้วย 0.2";
"trick_multiply_by_05_rule" = "trick_multiply_by_05_rule";
"trick_multiply_by_05_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 0.5 = 9</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 2: <br><b><font color=#c27171>18</font> / 2 = 9</b>";
"trick_multiply_by_05_text" = "คูณด้วย 0.5";
"trick_multiply_by_11_2digit_rule" = "trick_multiply_by_11_2digit_rule";
"trick_multiply_by_11_2digit_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>3</font><font color=#7875fd>5</font> × 11 = 385</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - บวกเพิ่มตัวเลขสองหลักทั้งสอง: <br><b><font color=#c27171>3</font> + <font color=#7875fd>5</font> = <font color=#008800>8</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - วางผลลัพธ์ไว้ระหว่างตัวเลขสองหลัก: <br><b><font color=#c27171>3</font>_<font color=#008800>8</font>_<font color=#7875fd>5</font> = 385</b>\n        <br>\n        <br>\n        <br><b><u>-2-</u></b>\n        <br>\n        <br><b><font color=#c27171>7</font><font color=#7875fd>8</font> × 11 = 858</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - บวกเพิ่มตัวเลขสองหลักทั้งสอง: <br><b><font color=#c27171>7</font> + <font color=#7875fd>8</font> = <font color=#6a379a>1</font><font color=#aa7700>5</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - ทดตัวเลข 1 ไว้เมื่อผลที่ได้มากกว่า 9: <br><b><font color=#c27171>7</font> + <font color=#6a379a>1</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - วางผลลัพธ์ไว้ระหว่างตัวเลขสองหลัก: <br><b><font color=#888800>8</font>_<font color=#aa7700>5</font>_<font color=#7875fd>8</font> = 858</b>";
"trick_multiply_by_11_2digit_text" = "คูณเลขสองหลักโดย 11";
"trick_multiply_by_125_rule" = "trick_multiply_by_125_rule";
"trick_multiply_by_125_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 125 = 3125</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 8: <br><b><font color=#c27171>25</font> / 8 = <font color=#7875fd>3.125</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 1000: <br><b><font color=#7875fd>3.125</font> × 1000 = 3125</b>";
"trick_multiply_by_125_text" = "คูณด้วย 125";
"trick_multiply_by_12_rule" = "trick_multiply_by_12_rule";
"trick_multiply_by_12_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>12</font> = 192</b>\n        <br>\n        <br><b><font color=#888800>12</font> = <font color=#7875fd>10</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณจำนวนด้วย 2: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - บวกเพิ่มขั้นตอนที่ 1 และขั้นตอนที่ 2: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>32</font> = 192</b>";
"trick_multiply_by_12_text" = "คูณด้วย 12";
"trick_multiply_by_13_rule" = "trick_multiply_by_13_rule";
"trick_multiply_by_13_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>13</font> = 208</b>\n        <br>\n        <br><b><font color=#888800>13</font> = <font color=#7875fd>10</font> + <font color=#008800>3</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณจำนวนด้วย 3: <br><b><font color=#c27171>16</font> × <font color=#008800>3</font> = <font color=#6a379a>48</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - บวกเพิ่มขั้นตอนที่ 1 และขั้นตอนที่ 2: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>48</font> = 208</b>";
"trick_multiply_by_13_text" = "คูณด้วย 13";
"trick_multiply_by_14_rule" = "trick_multiply_by_14_rule";
"trick_multiply_by_14_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>14</font> = 224</b>\n        <br>\n        <br><b><font color=#888800>14</font> = <font color=#7875fd>10</font> + <font color=#008800>4</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณจำนวนด้วย 4: <br><b><font color=#c27171>16</font> × <font color=#008800>4</font> = <font color=#6a379a>64</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - บวกเพิ่มขั้นตอนที่ 1 และขั้นตอนที่ 2: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>64</font> = 224</b>";
"trick_multiply_by_14_text" = "คูณด้วย 14";
"trick_multiply_by_15_rule" = "trick_multiply_by_15_rule";
"trick_multiply_by_15_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 15 = 540</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 10: <br><b><font color=#c27171>36</font> × 10 = <font color=#7875fd>360</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - หารผลลัพธ์ที่ได้จากขั้นตอนที่ 1 ด้วย 2: <br><b><font color=#7875fd>360</font> / 2 = <font color=#008800>180</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - บวกเพิ่มขั้นตอนที่ 1 และขั้นตอนที่ 2: <br><b><font color=#7875fd>360</font> + <font color=#008800>180</font> = 540</b>";
"trick_multiply_by_15_text" = "คูณด้วย 15";
"trick_multiply_by_16_rule" = "trick_multiply_by_16_rule";
"trick_multiply_by_16_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>16</font> = 224</b>\n        <br>\n        <br><b><font color=#7875fd>16</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>1</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 10: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณจำนวนด้วย 5: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - คูณจำนวนด้วย 1: <br><b><font color=#c27171>14</font> × <font color=#b265cf>1</font> = <font color=#c27171>14</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 4</b></font> - <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#c27171>14</font> = 224</b>";
"trick_multiply_by_16_text" = "คูณด้วย 16";
"trick_multiply_by_17_rule" = "trick_multiply_by_17_rule";
"trick_multiply_by_17_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>17</font> = 238</b>\n        <br>\n        <br><b><font color=#7875fd>17</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>2</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 10: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณจำนวนด้วย 5: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - คูณจำนวนด้วย 2: <br><b><font color=#c27171>14</font> × <font color=#b265cf>2</font> = <font color=#008888>28</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 4</b></font> - <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#008888>28</font> = 238</b>";
"trick_multiply_by_17_text" = "คูณด้วย 17";
"trick_multiply_by_18_rule" = "trick_multiply_by_18_rule";
"trick_multiply_by_18_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>18</font> = 288</b>\n        <br>\n        <br><b><font color=#888800>18</font> = <font color=#7875fd>20</font> - <font color=#aa7700>2</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 20: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณจำนวนด้วย 2: <br><b><font color=#c27171>16</font> × <font color=#aa7700>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - ลบ (ขั้นตอนที่ 2) ออกจาก (ขั้นตอนที่ 1): <br><b><font color=#008888>320</font> - <font color=#6a379a>32</font> = 288</b>";
"trick_multiply_by_18_text" = "คูณด้วย 18";
"trick_multiply_by_19_rule" = "trick_multiply_by_19_rule";
"trick_multiply_by_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>19</font> = 304</b>\n        <br>\n        <br><b><font color=#888800>19</font> = <font color=#7875fd>20</font> - <font color=#aa7700>1</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 20: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณจำนวนด้วย 1: <br><b><font color=#c27171>16</font> × <font color=#aa7700>1</font> = <font color=#6a379a>16</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - ลบ (ขั้นตอนที่ 2) ออกจาก (ขั้นตอนที่ 1): <br><b><font color=#008888>320</font> - <font color=#6a379a>16</font> = 304</b>";
"trick_multiply_by_19_text" = "คูณด้วย 19";
"trick_multiply_by_20_rule" = "trick_multiply_by_20_rule";
"trick_multiply_by_20_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 20 = 720</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 2: <br><b><font color=#c27171>36</font> × 2 = <font color=#7875fd>72</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 10: <br><b><font color=#7875fd>72</font> × 10 = 720</b>";
"trick_multiply_by_20_text" = "คูณด้วย 20";
"trick_multiply_by_250_rule" = "trick_multiply_by_250_rule";
"trick_multiply_by_250_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 250 = 6250</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 4: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 1000: <br><b><font color=#7875fd>6.25</font> × 1000 = 6250</b>";
"trick_multiply_by_250_text" = "คูณด้วย 250";
"trick_multiply_by_25_rule" = "trick_multiply_by_25_rule";
"trick_multiply_by_25_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 25 = 450</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 4: <br><b><font color=#c27171>18</font> / 4 = <font color=#7875fd>4.5</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 100: <br><b><font color=#7875fd>4.5</font> × 100 = 450</b>";
"trick_multiply_by_25_text" = "คูณด้วย 25";
"trick_multiply_by_2_rule" = "trick_multiply_by_2_rule";
"trick_multiply_by_2_rule_text" = "-1";
"trick_multiply_by_2_text" = "คูณด้วย 2";
"trick_multiply_by_3_rule" = "trick_multiply_by_3_rule";
"trick_multiply_by_3_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>32</font> × <font color=#888800>3</font> = 96</b>\n        <br>\n        <br><b><font color=#888800>3</font> = <font color=#7875fd>2</font> + <font color=#008800>1</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 2: <br><b><font color=#c27171>32</font> × <font color=#7875fd>2</font> = <font color=#aa7700>64</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณจำนวนด้วย 1: <br><b><font color=#c27171>32</font> × <font color=#008800>1</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - บวกเพิ่มขั้นตอนที่ 1 และขั้นตอนที่ 2: <br><b><font color=#aa7700>64</font> + <font color=#6a379a>32</font> = 96</b>";
"trick_multiply_by_3_text" = "คูณด้วย 3";
"trick_multiply_by_4_rule" = "trick_multiply_by_4_rule";
"trick_multiply_by_4_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>58</font> × 4 = 232</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 2: <br><b><font color=#c27171>58</font> × 2 = <font color=#7875fd>116</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 2: <br><b><font color=#7875fd>116</font> × 2 = 232</b>";
"trick_multiply_by_4_text" = "คูณด้วย 4";
"trick_multiply_by_500_rule" = "trick_multiply_by_500_rule";
"trick_multiply_by_500_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 500 = 12500</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 2: <br><b><font color=#c27171>25</font> / 2 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 1000: <br><b><font color=#7875fd>12.5</font> × 1000 = 12500</b>";
"trick_multiply_by_500_text" = "คูณด้วย 500";
"trick_multiply_by_50_rule" = "trick_multiply_by_50_rule";
"trick_multiply_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 50 = 900</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 2: <br><b><font color=#c27171>18</font> / 2 = <font color=#7875fd>9</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 100: <br><b><font color=#7875fd>9</font> × 100 = 900</b>";
"trick_multiply_by_50_text" = "คูณด้วย 50";
"trick_multiply_by_5_rule" = "trick_multiply_by_5_rule";
"trick_multiply_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1234</font> × 5 = 6170</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 2: <br><b><font color=#c27171>1234</font> / 2 = <font color=#7875fd>617</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 10: <br><b><font color=#7875fd>617</font> × 10 = 6170</b>";
"trick_multiply_by_5_text" = "คูณด้วย 5";
"trick_multiply_by_6_rule" = "trick_multiply_by_6_rule";
"trick_multiply_by_6_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>6</font> = 96</b>\n        <br>\n        <br><b><font color=#888800>6</font> = 5 + 1 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>1</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 2: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 10: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - คูณจำนวนด้วย 1: <br><b><font color=#c27171>16</font> × <font color=#008800>1</font> = <font color=#c27171>16</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 4</b></font> - บวกเพิ่มขั้นตอนที่ 2 และขั้นตอนที่ 3: <br><b><font color=#008888>80</font> + <font color=#c27171>16</font> = 96</b>";
"trick_multiply_by_6_text" = "คูณด้วย 6";
"trick_multiply_by_750_rule" = "trick_multiply_by_750_rule";
"trick_multiply_by_750_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 750 = 18750</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 4: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 3: <br><b><font color=#7875fd>6.25</font> × 3 = <font color=#aa7700>18.75</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 2 ด้วย 1000: <br><b><font color=#aa7700>18.75</font> × 1000 = 18750</b>";
"trick_multiply_by_750_text" = "คูณด้วย 750";
"trick_multiply_by_75_rule" = "trick_multiply_by_75_rule";
"trick_multiply_by_75_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>68</font> × 75 = 5100</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 4: <br><b><font color=#c27171>68</font> / 4 = <font color=#7875fd>17</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 3: <br><b><font color=#7875fd>17</font> × 3 = <font color=#aa7700>51</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 2 ด้วย 100: <br><b><font color=#aa7700>51</font> × 100 = 5100</b>";
"trick_multiply_by_75_text" = "คูณด้วย 75";
"trick_multiply_by_7_rule" = "trick_multiply_by_7_rule";
"trick_multiply_by_7_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>7</font> = 112</b>\n        <br>\n        <br><b><font color=#888800>7</font> = 5 + 2 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - หารจำนวนนั้นด้วย 2: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 10: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - คูณจำนวนด้วย 2: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#8c6745>32</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 4</b></font> - บวกเพิ่มขั้นตอนที่ 2 และขั้นตอนที่ 3: <br><b><font color=#008888>80</font> + <font color=#8c6745>32</font> = 112</b>";
"trick_multiply_by_7_text" = "คูณด้วย 7";
"trick_multiply_by_8_rule" = "trick_multiply_by_8_rule";
"trick_multiply_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>8</font> = 128</b>\n        <br>\n        <br><b><font color=#888800>8</font> = <font color=#7875fd>10</font> - <font color=#aa7700>2</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#008888>160</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณจำนวนด้วย 2: <br><b><font color=#c27171>16</font> × <font color=#aa7700>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - ลบ (ขั้นตอนที่ 2) ออกจาก (ขั้นตอนที่ 1): <br><b><font color=#008888>160</font> - <font color=#6a379a>32</font> = 128</b>";
"trick_multiply_by_8_text" = "คูณด้วย 8";
"trick_multiply_by_999_rule" = "trick_multiply_by_999_rule";
"trick_multiply_by_999_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 999 = 24975</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 1000: <br><b><font color=#c27171>25</font> × 1000 = <font color=#7875fd>25000</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - ลบด้วยตัวเลขเริ่มต้นจากขั้นตอนที่ 1: <br><b><font color=#7875fd>25000</font> - <font color=#c27171>25</font> = 24975</b>";
"trick_multiply_by_999_text" = "คูณด้วย 999";
"trick_multiply_by_99_rule" = "trick_multiply_by_99_rule";
"trick_multiply_by_99_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>15</font> × 99 = 1485</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 100: <br><b><font color=#c27171>15</font> × 100 = <font color=#7875fd>1500</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - ลบด้วยตัวเลขเริ่มต้นจากขั้นตอนที่ 1: <br><b><font color=#7875fd>1500</font> - <font color=#c27171>15</font> = 1485</b>";
"trick_multiply_by_99_text" = "คูณด้วย 99";
"trick_multiply_by_9_rule" = "trick_multiply_by_9_rule";
"trick_multiply_by_9_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>56</font> × 9 = 504</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณจำนวนด้วย 10: <br><b><font color=#c27171>56</font> × 10 = <font color=#7875fd>560</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - ลบด้วยตัวเลขเริ่มต้นจากขั้นตอนที่ 1: <br><b><font color=#7875fd>560</font> - <font color=#c27171>56</font> = 504</b>";
"trick_multiply_by_9_text" = "คูณด้วย 9";
"trick_multiply_numbers_between_11_and_19_rule" = "trick_multiply_numbers_between_11_and_19_rule";
"trick_multiply_numbers_between_11_and_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>1<font color=#c27171>4</font> × <font color=#7875fd>1</font><font color=#008800>8</font> = 252</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - บวกเพิ่มจำนวนที่มากกว่าไปยังหลักด้านขวาสุดของตัวเลขอื่น: <br><b><font color=#7875fd>1</font><font color=#008800>8</font> + <font color=#c27171>4</font> = <font color=#6a379a>22</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - ใส่ 0 ในตอนท้ายสุดของผลลัพธ์ที่ได้จากขั้นตอนที่ 1: <br><b><font color=#6a379a>22</font> × 10 = <font color=#888800>220</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - คูณตัวเลขขวาสุดของตัวเลขเริ่มต้นทั้งสอง: <br><b><font color=#008800>8</font> x <font color=#c27171>4</font> = <font color=#aa7700>32</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 4</b></font> - บวกเพิ่มขั้นตอนที่ 2 และขั้นตอนที่ 3: <br><b><font color=#888800>220</font> + <font color=#aa7700>32</font> = 252</b>";
"trick_multiply_numbers_between_11_and_19_text" = "ลขคูณระหว่าง 11 และ 19";
"trick_multiply_two_digit_numbers_editing_in_1_rule" = "trick_multiply_two_digit_numbers_editing_in_1_rule";
"trick_multiply_two_digit_numbers_editing_in_1_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>5</font>1 × <font color=#7875fd>3</font>1 = 1581</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณตัวเลขด้านซ้ายสุด: <br><b><font color=#c27171>5</font> × <font color=#7875fd>3</font> = <font color=#008800>15</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - บวกเพิ่มตัวเลขซ้ายสุด: <br><b><font color=#c27171>5</font> + <font color=#7875fd>3</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - วางผลลัพธ์ที่ได้จากขั้นตอนที่ 2 ถัดจากผลลัพธ์ที่ได้จากขั้นตอนที่ 1: <br><b><font color=#008800>15</font>_<font color=#888800>8</font> = 158</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 4</b></font> - <br><b><font color=#008800>15</font>_<font color=#888800>8</font>_1 = 1581</b>";
"trick_multiply_two_digit_numbers_editing_in_1_text" = "คูณเลขสองหลักที่สิ้นสุดใน 1";
"trick_multiply_two_digit_numbers_having_same_tens_rule" = "trick_multiply_two_digit_numbers_having_same_tens_rule";
"trick_multiply_two_digit_numbers_having_same_tens_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>2</font><font color=#7875fd>3</font> × <font color=#c27171>2</font><font color=#008800>7</font> = 621</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คูณตัวเลขหลักแรกด้วยหลักแรกบวกด้วยหนึ่ง: <br><b><font color=#c27171>2</font> × (<font color=#c27171>2</font> + 1) = <font color=#6a379a>6</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คูณตัวเลขขวาสุด (ถ้าผลลัพธ์ที่ได้คือตัวเลขหลักเดียว ให้ใส่ 0 ที่ด้านหน้าของมัน): <br><b><font color=#7875fd>3</font> × <font color=#008800>7</font> = <font color=#888800>21</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - วางผลลัพธ์ที่ได้จากขั้นตอนที่ 2 ถัดจากผลลัพธ์ที่ได้จากขั้นตอนที่ 1: <br><b><font color=#6a379a>6</font>_<font color=#888800>21</font> = 621</b>";
"trick_multiply_two_digit_numbers_having_same_tens_text" = "คูณตัวเลขสองหลัก มีตัวเลขหลักสิบเหมือนกัน และตัวเลขที่เพิ่มขึ้นถึงสิบ";
"trick_percent_2_rule" = "trick_percent_2_rule";
"trick_percent_2_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>6</font>% → 350 = 21</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - <font color=#c27171>6</font>% → 100 = <b><font color=#c27171>6</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - <font color=#c27171>6</font>% → 300 = <b><font color=#6a379a>18</font></b> (คูณผลลัพธ์จากขั้นตอนที่ 1 ด้วย 3)\n        <br>\n        <br><i>[100 × <font color=#7875fd>3</font> = 300] → [<font color=#c27171>6</font> × <font color=#7875fd>3</font> = <font color=#6a379a>18</font>]</i>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - <font color=#c27171>6</font>% → 50 = <b><font color=#aa7700>3</font></b> (หารผลลัพธ์ที่ได้จากขั้นตอนที่ 1 ด้วย <font color=#888800>2</font>)\n        <br>\n        <br><i>[100 / <font color=#888800>2</font> = 50] → [<font color=#c27171>6</font> / <font color=#888800>2</font> = <font color=#aa7700>3</font>]</i>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 4</b></font> - บวกเพิ่มขั้นตอนที่ 2 และขั้นตอนที่ 3: <br><b><font color=#6a379a>18</font> + <font color=#aa7700>3</font> = 21</b>";
"trick_percent_2_text" = "เคล็ดลับในการคำนวณ -2-";
"trick_percent_rule" = "trick_percent_rule";
"trick_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>15% → <font color=#c27171>300</font> = 45</b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 1</b></font> - คำนวณ 10% (หารจำนวนนั้นด้วย 10): <br><b><font color=#c27171>300</font> / 10 = <font color=#7875fd>30</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 2</b></font> - คำนวณ 5% (หารผลลัพธ์ที่ได้จากขั้นตอนที่ 1 ด้วย 2): <br><b><font color=#7875fd>30</font> / 2 = <font color=#008800>15</font></b>\n        <br>\n        <br><font color=#666666><b>ขั้นตอนที่ 3</b></font> - บวกเพิ่มขั้นตอนที่ 1 และขั้นตอนที่ 2: <br><b><font color=#7875fd>30</font> + <font color=#008800>15</font> = 45</b>";
