"trick_multiplication_rule" = "trick_multiplication_rule";
"trick_multiplication_rule_text" = "-1";
"trick_multiplication_text" = "掛け算";
"trick_multiply_by_025_rule" = "trick_multiply_by_025_rule";
"trick_multiply_by_025_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>20</font> × 0.25 = 5</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を4で割る： <br><b><font color=#c27171>20</font> / 4 = 5</b>";
"trick_multiply_by_025_text" = "0.25を掛ける";
"trick_multiply_by_02_rule" = "trick_multiply_by_02_rule";
"trick_multiply_by_02_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>125</font> × 0.2 = 25</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を10で割る： <br><b><font color=#c27171>125</font> / 10 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に2を掛ける： <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
"trick_multiply_by_02_text" = "0.2を掛ける";
"trick_multiply_by_05_rule" = "trick_multiply_by_05_rule";
"trick_multiply_by_05_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 0.5 = 9</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を2で割る： <br><b><font color=#c27171>18</font> / 2 = 9</b>";
"trick_multiply_by_05_text" = "0.5を掛ける";
"trick_multiply_by_11_2digit_rule" = "trick_multiply_by_11_2digit_rule";
"trick_multiply_by_11_2digit_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>3</font><font color=#7875fd>5</font> × 11 = 385</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 二桁の数の両方の数を足す： <br><b><font color=#c27171>3</font> + <font color=#7875fd>5</font> = <font color=#008800>8</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 両方の数の間に得られた数を入力する： <br><b><font color=#c27171>3</font>_<font color=#008800>8</font>_<font color=#7875fd>5</font> = 385</b>\n        <br>\n        <br>\n        <br><b><u>-2-</u></b>\n        <br>\n        <br><b><font color=#c27171>7</font><font color=#7875fd>8</font> × 11 = 858</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 二桁の数の両方の数を足す： <br><b><font color=#c27171>7</font> + <font color=#7875fd>8</font> = <font color=#6a379a>1</font><font color=#aa7700>5</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 得られた数が9より大きい場合、1を繰り上げる： <br><b><font color=#c27171>7</font> + <font color=#6a379a>1</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - 両方の数の間に得られた数を入力する： <br><b><font color=#888800>8</font>_<font color=#aa7700>5</font>_<font color=#7875fd>8</font> = 858</b>";
"trick_multiply_by_11_2digit_text" = "二桁の数に11を掛ける";
"trick_multiply_by_125_rule" = "trick_multiply_by_125_rule";
"trick_multiply_by_125_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 125 = 3125</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を8で割る: <br><b><font color=#c27171>25</font> / 8 = <font color=#7875fd>3.125</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に1000を掛ける: <br><b><font color=#7875fd>3.125</font> × 1000 = 3125</b>";
"trick_multiply_by_125_text" = "125を掛ける";
"trick_multiply_by_12_rule" = "trick_multiply_by_12_rule";
"trick_multiply_by_12_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>12</font> = 192</b>\n        <br>\n        <br><b><font color=#888800>12</font> = <font color=#7875fd>10</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を10を掛ける: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を2を掛ける: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - ステップ1とステップ2の数を足す: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>32</font> = 192</b>";
"trick_multiply_by_12_text" = "12を掛ける";
"trick_multiply_by_13_rule" = "trick_multiply_by_13_rule";
"trick_multiply_by_13_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>13</font> = 208</b>\n        <br>\n        <br><b><font color=#888800>13</font> = <font color=#7875fd>10</font> + <font color=#008800>3</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を10を掛ける: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を3を掛ける: <br><b><font color=#c27171>16</font> × <font color=#008800>3</font> = <font color=#6a379a>48</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - ステップ1とステップ2の数を足す: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>48</font> = 208</b>";
"trick_multiply_by_13_text" = "13を掛ける";
"trick_multiply_by_14_rule" = "trick_multiply_by_14_rule";
"trick_multiply_by_14_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>14</font> = 224</b>\n        <br>\n        <br><b><font color=#888800>14</font> = <font color=#7875fd>10</font> + <font color=#008800>4</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を10を掛ける: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を4を掛ける: <br><b><font color=#c27171>16</font> × <font color=#008800>4</font> = <font color=#6a379a>64</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - ステップ1とステップ2の数を足す: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>64</font> = 224</b>";
"trick_multiply_by_14_text" = "14を掛ける";
"trick_multiply_by_15_rule" = "trick_multiply_by_15_rule";
"trick_multiply_by_15_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 15 = 540</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を10を掛ける： <br><b><font color=#c27171>36</font> × 10 = <font color=#7875fd>360</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を2で割る： <br><b><font color=#7875fd>360</font> / 2 = <font color=#008800>180</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - ステップ1とステップ2の数を足す： <br><b><font color=#7875fd>360</font> + <font color=#008800>180</font> = 540</b>";
"trick_multiply_by_15_text" = "15を掛ける";
"trick_multiply_by_16_rule" = "trick_multiply_by_16_rule";
"trick_multiply_by_16_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>16</font> = 224</b>\n        <br>\n        <br><b><font color=#7875fd>16</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>1</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を10を掛ける: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を5を掛ける: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - 数を1を掛ける: <br><b><font color=#c27171>14</font> × <font color=#b265cf>1</font> = <font color=#c27171>14</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ4</b></font> - <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#c27171>14</font> = 224</b>";
"trick_multiply_by_16_text" = "16を掛ける";
"trick_multiply_by_17_rule" = "trick_multiply_by_17_rule";
"trick_multiply_by_17_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>17</font> = 238</b>\n        <br>\n        <br><b><font color=#7875fd>17</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>2</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を10を掛ける: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を5を掛ける: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - 数を2を掛ける: <br><b><font color=#c27171>14</font> × <font color=#b265cf>2</font> = <font color=#008888>28</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ4</b></font> - <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#008888>28</font> = 238</b>";
"trick_multiply_by_17_text" = "17を掛ける";
"trick_multiply_by_18_rule" = "trick_multiply_by_18_rule";
"trick_multiply_by_18_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>18</font> = 288</b>\n        <br>\n        <br><b><font color=#888800>18</font> = <font color=#7875fd>20</font> - <font color=#aa7700>2</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を20を掛ける: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を2を掛ける: <br><b><font color=#c27171>16</font> × <font color=#aa7700>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - もう一つの数から（ステップ2で得られた）数を引く: <br><b><font color=#008888>320</font> - <font color=#6a379a>32</font> = 288</b>";
"trick_multiply_by_18_text" = "18を掛ける";
"trick_multiply_by_19_rule" = "trick_multiply_by_19_rule";
"trick_multiply_by_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>19</font> = 304</b>\n        <br>\n        <br><b><font color=#888800>19</font> = <font color=#7875fd>20</font> - <font color=#aa7700>1</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を20を掛ける: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を1を掛ける: <br><b><font color=#c27171>16</font> × <font color=#aa7700>1</font> = <font color=#6a379a>16</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - もう一つの数から（ステップ2で得られた）数を引く: <br><b><font color=#008888>320</font> - <font color=#6a379a>16</font> = 304</b>";
"trick_multiply_by_19_text" = "19を掛ける";
"trick_multiply_by_20_rule" = "trick_multiply_by_20_rule";
"trick_multiply_by_20_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 20 = 720</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を2を掛ける： <br><b><font color=#c27171>36</font> × 2 = <font color=#7875fd>72</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に10を掛ける： <br><b><font color=#7875fd>72</font> × 10 = 720</b>";
"trick_multiply_by_20_text" = "20を掛ける";
"trick_multiply_by_250_rule" = "trick_multiply_by_250_rule";
"trick_multiply_by_250_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 250 = 6250</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を4で割る: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に1000を掛ける: <br><b><font color=#7875fd>6.25</font> × 1000 = 6250</b>";
"trick_multiply_by_250_text" = "250を掛ける";
"trick_multiply_by_25_rule" = "trick_multiply_by_25_rule";
"trick_multiply_by_25_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 25 = 450</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を4で割る： <br><b><font color=#c27171>18</font> / 4 = <font color=#7875fd>4.5</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に100を掛ける： <br><b><font color=#7875fd>4.5</font> × 100 = 450</b>";
"trick_multiply_by_25_text" = "25を掛ける";
"trick_multiply_by_2_rule" = "trick_multiply_by_2_rule";
"trick_multiply_by_2_rule_text" = "-1";
"trick_multiply_by_2_text" = "2を掛ける";
"trick_multiply_by_3_rule" = "trick_multiply_by_3_rule";
"trick_multiply_by_3_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>32</font> × <font color=#888800>3</font> = 96</b>\n        <br>\n        <br><b><font color=#888800>3</font> = <font color=#7875fd>2</font> + <font color=#008800>1</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を2を掛ける: <br><b><font color=#c27171>32</font> × <font color=#7875fd>2</font> = <font color=#aa7700>64</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を1を掛ける: <br><b><font color=#c27171>32</font> × <font color=#008800>1</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - ステップ1とステップ2の数を足す: <br><b><font color=#aa7700>64</font> + <font color=#6a379a>32</font> = 96</b>";
"trick_multiply_by_3_text" = "3を掛ける";
"trick_multiply_by_4_rule" = "trick_multiply_by_4_rule";
"trick_multiply_by_4_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>58</font> × 4 = 232</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を2を掛ける： <br><b><font color=#c27171>58</font> × 2 = <font color=#7875fd>116</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に2を掛ける： <br><b><font color=#7875fd>116</font> × 2 = 232</b>";
"trick_multiply_by_4_text" = "4を掛ける";
"trick_multiply_by_500_rule" = "trick_multiply_by_500_rule";
"trick_multiply_by_500_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 500 = 12500</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を2で割る: <br><b><font color=#c27171>25</font> / 2 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に1000を掛ける: <br><b><font color=#7875fd>12.5</font> × 1000 = 12500</b>";
"trick_multiply_by_500_text" = "500を掛ける";
"trick_multiply_by_50_rule" = "trick_multiply_by_50_rule";
"trick_multiply_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 50 = 900</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を2で割る： <br><b><font color=#c27171>18</font> / 2 = <font color=#7875fd>9</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に100を掛ける： <br><b><font color=#7875fd>9</font> × 100 = 900</b>";
"trick_multiply_by_50_text" = "50を掛ける";
"trick_multiply_by_5_rule" = "trick_multiply_by_5_rule";
"trick_multiply_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1234</font> × 5 = 6170</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を2で割る： <br><b><font color=#c27171>1234</font> / 2 = <font color=#7875fd>617</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に10を掛ける： <br><b><font color=#7875fd>617</font> × 10 = 6170</b>";
"trick_multiply_by_5_text" = "5を掛ける";
"trick_multiply_by_6_rule" = "trick_multiply_by_6_rule";
"trick_multiply_by_6_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>6</font> = 96</b>\n        <br>\n        <br><b><font color=#888800>6</font> = 5 + 1 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>1</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を2で割る: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に10を掛ける: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - 数を1を掛ける: <br><b><font color=#c27171>16</font> × <font color=#008800>1</font> = <font color=#c27171>16</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ4</b></font> - ステップ2とステップ3の数を足す: <br><b><font color=#008888>80</font> + <font color=#c27171>16</font> = 96</b>";
"trick_multiply_by_6_text" = "6を掛ける";
"trick_multiply_by_750_rule" = "trick_multiply_by_750_rule";
"trick_multiply_by_750_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 750 = 18750</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を4で割る: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に3を掛ける: <br><b><font color=#7875fd>6.25</font> × 3 = <font color=#aa7700>18.75</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - ステップ2で得られた数に1000を掛ける: <br><b><font color=#aa7700>18.75</font> × 1000 = 18750</b>";
"trick_multiply_by_750_text" = "750を掛ける";
"trick_multiply_by_75_rule" = "trick_multiply_by_75_rule";
"trick_multiply_by_75_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>68</font> × 75 = 5100</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を4で割る: <br><b><font color=#c27171>68</font> / 4 = <font color=#7875fd>17</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に3を掛ける: <br><b><font color=#7875fd>17</font> × 3 = <font color=#aa7700>51</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - ステップ2で得られた数に100を掛ける: <br><b><font color=#aa7700>51</font> × 100 = 5100</b>";
"trick_multiply_by_75_text" = "75を掛ける";
"trick_multiply_by_7_rule" = "trick_multiply_by_7_rule";
"trick_multiply_by_7_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>7</font> = 112</b>\n        <br>\n        <br><b><font color=#888800>7</font> = 5 + 2 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を2で割る: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に10を掛ける: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - 数を2を掛ける: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#8c6745>32</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ4</b></font> - ステップ2とステップ3の数を足す: <br><b><font color=#008888>80</font> + <font color=#8c6745>32</font> = 112</b>";
"trick_multiply_by_7_text" = "7を掛ける";
"trick_multiply_by_8_rule" = "trick_multiply_by_8_rule";
"trick_multiply_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>8</font> = 128</b>\n        <br>\n        <br><b><font color=#888800>8</font> = <font color=#7875fd>10</font> - <font color=#aa7700>2</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を10を掛ける: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#008888>160</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を2を掛ける: <br><b><font color=#c27171>16</font> × <font color=#aa7700>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - もう一つの数から（ステップ2で得られた）数を引く: <br><b><font color=#008888>160</font> - <font color=#6a379a>32</font> = 128</b>";
"trick_multiply_by_8_text" = "8を掛ける";
"trick_multiply_by_999_rule" = "trick_multiply_by_999_rule";
"trick_multiply_by_999_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 999 = 24975</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を1000を掛ける: <br><b><font color=#c27171>25</font> × 1000 = <font color=#7875fd>25000</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1から元の数を引く: <br><b><font color=#7875fd>25000</font> - <font color=#c27171>25</font> = 24975</b>";
"trick_multiply_by_999_text" = "999を掛ける";
"trick_multiply_by_99_rule" = "trick_multiply_by_99_rule";
"trick_multiply_by_99_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>15</font> × 99 = 1485</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を100を掛ける： <br><b><font color=#c27171>15</font> × 100 = <font color=#7875fd>1500</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1から元の数を引く： <br><b><font color=#7875fd>1500</font> - <font color=#c27171>15</font> = 1485</b>";
"trick_multiply_by_99_text" = "99を掛ける";
"trick_multiply_by_9_rule" = "trick_multiply_by_9_rule";
"trick_multiply_by_9_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>56</font> × 9 = 504</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を10を掛ける： <br><b><font color=#c27171>56</font> × 10 = <font color=#7875fd>560</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1から元の数を引く： <br><b><font color=#7875fd>560</font> - <font color=#c27171>56</font> = 504</b>";
"trick_multiply_by_9_text" = "9を掛ける";
"trick_multiply_numbers_between_11_and_19_rule" = "trick_multiply_numbers_between_11_and_19_rule";
"trick_multiply_numbers_between_11_and_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>1<font color=#c27171>4</font> × <font color=#7875fd>1</font><font color=#008800>8</font> = 252</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - より大きい数をもう一つの数の右端の桁に足す： <br><b><font color=#7875fd>1</font><font color=#008800>8</font> + <font color=#c27171>4</font> = <font color=#6a379a>22</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数の最後に0を入力する： <br><b><font color=#6a379a>22</font> × 10 = <font color=#888800>220</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - 両方の元の数の右端にある数を掛ける： <br><b><font color=#008800>8</font> x <font color=#c27171>4</font> = <font color=#aa7700>32</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ4</b></font> - ステップ2とステップ3の数を足す： <br><b><font color=#888800>220</font> + <font color=#aa7700>32</font> = 252</b>";
"trick_multiply_numbers_between_11_and_19_text" = "11と19の間の数を掛ける";
"trick_multiply_two_digit_numbers_editing_in_1_rule" = "trick_multiply_two_digit_numbers_editing_in_1_rule";
"trick_multiply_two_digit_numbers_editing_in_1_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>5</font>1 × <font color=#7875fd>3</font>1 = 1581</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 左端の数を掛ける： <br><b><font color=#c27171>5</font> × <font color=#7875fd>3</font> = <font color=#008800>15</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 左端の数を足す： <br><b><font color=#c27171>5</font> + <font color=#7875fd>3</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - ステップ2で得られた数をステップ1で得られた数の隣に入力する： <br><b><font color=#008800>15</font>_<font color=#888800>8</font> = 158</b>\n        <br>\n        <br><font color=#666666><b>ステップ4</b></font> - ステップ3で得られた数の隣に1を書く： <br><b><font color=#008800>15</font>_<font color=#888800>8</font>_1 = 1581</b>";
"trick_multiply_two_digit_numbers_editing_in_1_text" = "1で終わる二桁の数を掛ける";
"trick_multiply_two_digit_numbers_having_same_tens_rule" = "trick_multiply_two_digit_numbers_having_same_tens_rule";
"trick_multiply_two_digit_numbers_having_same_tens_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>2</font><font color=#7875fd>3</font> × <font color=#c27171>2</font><font color=#008800>7</font> = 621</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 一の位の数に一の位+1を掛ける： <br><b><font color=#c27171>2</font> × (<font color=#c27171>2</font> + 1) = <font color=#6a379a>6</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 右端の数を掛ける (得られた数が一桁の場合、0を前に入力する)： <br><b><font color=#7875fd>3</font> × <font color=#008800>7</font> = <font color=#888800>21</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - ステップ2で得られた数をステップ1で得られた数の隣に入力する： <br><b><font color=#6a379a>6</font>_<font color=#888800>21</font> = 621</b>";
"trick_multiply_two_digit_numbers_having_same_tens_text" = "同じ十の位と一の位の数を10まで足し算した二桁の数を掛ける";
"trick_percent_2_rule" = "trick_percent_2_rule";
"trick_percent_2_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>6</font>% → 350 = 21</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - <font color=#c27171>6</font>% → 100 = <b><font color=#c27171>6</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - <font color=#c27171>6</font>% → 300 = <b><font color=#6a379a>18</font></b> (ステップ1で得られた数に<font color=#7875fd>3</font>を掛ける)\n        <br>\n        <br><i>[100 × <font color=#7875fd>3</font> = 300] → [<font color=#c27171>6</font> × <font color=#7875fd>3</font> = <font color=#6a379a>18</font>]</i>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - <font color=#c27171>6</font>% → 50 = <b><font color=#aa7700>3</font></b> (数を<font color=#888800>2</font>で割る)\n        <br>\n        <br><i>[100 / <font color=#888800>2</font> = 50] → [<font color=#c27171>6</font> / <font color=#888800>2</font> = <font color=#aa7700>3</font>]</i>\n        <br>\n        <br><font color=#666666><b>ステップ4</b></font> - ステップ2とステップ3の数を足す： <br><b><font color=#6a379a>18</font> + <font color=#aa7700>3</font> = 21</b>";
"trick_percent_2_text" = "ヒント -2- を計算";
"trick_percent_rule" = "trick_percent_rule";
"trick_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>15% → <font color=#c27171>300</font> = 45</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 10%の割合を算出する (数を10で割る)： <br><b><font color=#c27171>300</font> / 10 = <font color=#7875fd>30</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 5%の割合を算出する (数を2で割る)： <br><b><font color=#7875fd>30</font> / 2 = <font color=#008800>15</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - ステップ1とステップ2の数を足す： <br><b><font color=#7875fd>30</font> + <font color=#008800>15</font> = 45</b>";
"trick_percent_text" = "ヒント -1- を計算";
