"trick_dividing_by_4_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>64</font> / 4 = 16</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を2で割る： <br><b><font color=#c27171>64</font> / 2 = <font color=#7875fd>32</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を2で割る： <br><b><font color=#7875fd>32</font> / 2 = 16</b>";
"trick_dividing_by_4_text" = "4で割る";
"trick_dividing_by_50_rule" = "trick_dividing_by_50_rule";
"trick_dividing_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1250</font> / 50 = 25</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を100で割る： <br><b><font color=#c27171>1250</font> / 100 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に2を掛ける： <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
"trick_dividing_by_50_text" = "50で割る";
"trick_dividing_by_5_rule" = "trick_dividing_by_5_rule";
"trick_dividing_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1235</font> / 5 = 247</b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を10で割る： <br><b><font color=#c27171>1235</font> / 10 = <font color=#7875fd>123.5</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - ステップ1で得られた数に2を掛ける： <br><b><font color=#7875fd>123.5</font> × 2 = 247</b>";
"trick_dividing_by_5_text" = "5で割る";
"trick_dividing_by_6_rule" = "trick_dividing_by_6_rule";
"trick_dividing_by_6_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>126</font> / <font color=#7875fd>6</font> = 21</b>\n        <br>\n        <br><b><font color=#7875fd>6</font> = <font color=#008800>3</font> × <font color=#888800>2</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を2で割る: <br><b><font color=#c27171>126</font> / <font color=#888800>2</font> = <font color=#aa7700>63</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を3で割る: <br><b><font color=#aa7700>63</font> / <font color=#008800>3</font> = 21";
"trick_dividing_by_6_text" = "6で割る";
"trick_dividing_by_7_rule" = "trick_dividing_by_7_rule";
"trick_dividing_by_7_rule_text" = "-1";
"trick_dividing_by_7_text" = "7で割る";
"trick_dividing_by_8_rule" = "trick_dividing_by_8_rule";
"trick_dividing_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>128</font> / <font color=#7875fd>8</font> = 16</b>\n        <br>\n        <br><b><font color=#7875fd>8</font> = <font color=#008800>2</font> × <font color=#888800>2</font> × <font color=#6a379a>2</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ1</b></font> - 数を2で割る: <br><b><font color=#c27171>128</font> / <font color=#008800>2</font> = <font color=#aa7700>64</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ2</b></font> - 数を2で割る: <br><b><font color=#aa7700>64</font> / <font color=#888800>2</font> = <font color=#008888>32</font></b>\n        <br>\n        <br><font color=#666666><b>ステップ3</b></font> - 数を2で割る: <br><b><font color=#008888>32</font> / <font color=#6a379a>2</font> = 16";
"trick_dividing_by_8_text" = "8で割る";
"trick_dividing_by_9_rule" = "trick_dividing_by_9_rule";
"trick_dividing_by_9_rule_text" = "-1";
