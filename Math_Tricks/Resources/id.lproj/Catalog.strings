"trick_dividing_by_50_text" = "Membaginya dengan 50";
"trick_dividing_by_5_rule" = "trick_dividing_by_5_rule";
"trick_dividing_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1235</font> / 5 = 247</b>\n        <br>\n        <br><font color=#666666><b>Langkah 1</b></font> - Bagi angka dengan 10: <br><b><font color=#c27171>1235</font> / 10 = <font color=#7875fd>123.5</font></b>\n        <br>\n        <br><font color=#666666><b>Langkah 2</b></font> - Kalikan hasil dari Langkah 1 hingga 2: <br><b><font color=#7875fd>123.5</font> × 2 = 247</b>";
"trick_dividing_by_5_text" = "Membaginya dengan 5";
"trick_dividing_by_6_rule" = "trick_dividing_by_6_rule";
