"trick_multiply_by_19_rule" = "trick_multiply_by_19_rule";
"trick_multiply_by_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>19</font> = 304</b>\n        <br>\n        <br><b><font color=#888800>19</font> = <font color=#7875fd>20</font> - <font color=#aa7700>1</font></b>\n        <br>\n        <br><font color=#666666><b>Langkah 1</b></font> - Kalikan angka dengan 20: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>Langkah 2</b></font> - Kalikan angka dengan 1: <br><b><font color=#c27171>16</font> × <font color=#aa7700>1</font> = <font color=#6a379a>16</font></b>\n        <br>\n        <br><font color=#666666><b>Langkah 3</b></font> - Kurangi angka (dari Langkah 2) dari Langkah 1: <br><b><font color=#008888>320</font> - <font color=#6a379a>16</font> = 304</b>";
"trick_multiply_by_19_text" = "Kalikan dengan 19";
"trick_multiply_by_20_rule" = "trick_multiply_by_20_rule";
"trick_multiply_by_20_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 20 = 720</b>\n        <br>\n        <br><font color=#666666><b>Langkah 1</b></font> - Kalikan angka dengan 2: <br><b><font color=#c27171>36</font> × 2 = <font color=#7875fd>72</font></b>\n        <br>\n        <br><font color=#666666><b>Langkah 2</b></font> - Kalikan hasil dari Langkah 1 hingga 10: <br><b><font color=#7875fd>72</font> × 10 = 720</b>";
"trick_multiply_by_20_text" = "Kalikan dengan 20";
