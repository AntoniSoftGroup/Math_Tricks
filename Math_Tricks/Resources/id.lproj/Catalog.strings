"trick_square_number_between_10_and_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1</font><font color=#7875fd>4</font><small><sup>2</sup></small> = 196</b>\n        <br>\n        <br><font color=#666666><b>Langkah 1</b></font> - Tambahkan ke angka satu digit: <br><b><font color=#c27171>1</font><font color=#7875fd>4</font> + <font color=#7875fd>4</font> = <font color=#008800>18</font></b>\n        <br>\n        <br><font color=#666666><b>Langkah 2</b></font> - Kalikan hasil dari Langkah 1 hingga 10: <br><b><font color=#008800>18</font> × 10 = <font color=#888800>180</font></b>\n        <br>\n        <br><font color=#666666><b>Langkah 3</b></font> - Kotakkan satu digit angka: <br><b><font color=#7875fd>4</font><small><sup>2</sup></small> = <font color=#6a379a>16</font></b>\n        <br>\n        <br><font color=#666666><b>Langkah 4</b></font> - Tambahkan Langkah 2 dan Langkah 3: <br><b><font color=#888800>180</font> + <font color=#6a379a>16</font> = 196</b>";
