"trick_multiply_by_250_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 250 = 6250</b>\n        <br>\n        <br><font color=#666666><b>Langkah 1</b></font> - Bagi angka dengan 4: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>Langkah 2</b></font> - Kalikan hasil dari Langkah 1 hingga 1000: <br><b><font color=#7875fd>6.25</font> × 1000 = 6250</b>";
