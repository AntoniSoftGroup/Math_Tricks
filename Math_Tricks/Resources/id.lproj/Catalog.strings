"trick_square_number_between_100_and_109_rule" = "trick_square_number_between_100_and_109_rule";
"trick_square_number_between_100_and_109_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>10</font><font color=#7875fd>3</font><small><sup>2</sup></small> = 10609</b>\n        <br>\n        <br><font color=#666666><b>Langkah 1</b></font> - Tambahkan ke angka satu digit: <br><b><font color=#c27171>10</font><font color=#7875fd>3</font> + <font color=#7875fd>3</font> = <font color=#888800>106</font></b>\n        <br>\n        <br><font color=#666666><b>Langkah 2</b></font> - Pangkatkan angka satu digit (jika hasilnya adalah satu digit letakkan 0 di depannya): <br><b><font color=#7875fd>3</font><small><sup>2</sup></small> = 0<font color=#008800>9</font></b>\n        <br>\n        <br><font color=#666666><b>Langkah 3</b></font> - Letakkan hasil dari Langkah 2 sebelah hasil dari Langkah 1: <br><b><font color=#888800>106</font>_0<font color=#008800>9</font> = 10609</b>";
