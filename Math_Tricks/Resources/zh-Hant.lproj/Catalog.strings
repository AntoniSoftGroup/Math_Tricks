"trick_05_percent_rule" = "trick_05_percent_rule";
"trick_05_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>0.5</font>% → <font color=#7875fd>600</font> = 3</b>\n        <br>\n        <br><font color=#666666><b>步驟一</b></font> - 將數字除以100：<br><b><font color=#7875fd>600</font> / 100 = <font color=#008800>6</font></b>\n        <br>\n        <br><font color=#666666><b>步驟二</b></font> - 將<font color=#666666><b>步驟一</b></font>的結果除以2：<br><b><font color=#008800>6</font> / 2 = 3";
