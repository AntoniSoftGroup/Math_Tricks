"trick_150_percent_rule" = "trick_150_percent_rule";
"trick_150_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>150</font>% → <font color=#888800>60</font> = 90</b>\n        <br><b><font color=#c27171>150</font>% = <font color=#7875fd>100</font>% + <font color=#008800>50</font>%</b>\n        <br>\n        <br><font color=#666666><b>步驟一</b></font> - <b><font color=#7875fd>100</font>% → <font color=#888800>60</font> = <font color=#6a379a>60</font></b>\n        <br>\n        <br><font color=#666666><b>步驟二</b></font> - <b><font color=#008800>50</font>% = <font color=#7875fd>100</font>% / <font color=#aa7700>2</font></b>\n        <br> 將數字除以2：<br><b><font color=#6a379a>60</font> / <font color=#aa7700>2</font> = <font color=#008888>30</font></b>\n        <br>\n        <br><font color=#666666><b>步驟三</b></font> - 將<font color=#666666><b>步驟一</b></font>與<font color=#666666><b>步驟二</b></font>的結果相加：<br><b><font color=#6a379a>60</font> + <font color=#008888>30</font> = 90</b>";
"trick_150_percent_text" = "150%";
"trick_15_percent_rule" = "trick_15_percent_rule";
"trick_15_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>15</font>% → <font color=#7875fd>60</font> = 9</b>\n        <br>\n        <br><font color=#666666><b>步驟一</b></font> - 將數字除以10：<br><b><font color=#7875fd>60</font> / 10 = <font color=#008800>6</font></b>\n        <br>\n        <br><font color=#666666><b>步驟二</b></font> - 將<font color=#666666><b>步驟一</b></font>的結果除以2：<br><b><font color=#008800>6</font> / 2 = <font color=#888800>3</font></b>\n        <br>\n        <br><font color=#666666><b>步驟三</b></font> - 將<font color=#666666><b>步驟一</b></font>與<font color=#666666><b>步驟二</b></font>的結果相加：<br><b><font color=#008800>6</font> + <font color=#888800>3</font> = 9</b>";
"trick_15_percent_text" = "15%";
"trick_200_percent_rule" = "trick_200_percent_rule";
