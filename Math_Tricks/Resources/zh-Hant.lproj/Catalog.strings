"trick_subtracting_from_1000_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>1000 - <font color=#c27171>5</font><font color=#7875fd>6</font><font color=#888800>7</font> = <font color=#008800>4</font><font color=#6a379a>3</font><font color=#aa7700>3</font></b>\n        <br>\n        <br><font color=#666666><b>步驟一</b></font> - 9減去百位數字<font color=#c27171>5</font>：<b><font color=#008800>4</font></b>\n        <br>\n        <br><font color=#666666><b>步驟二</b></font> - 9減去十位數字<font color=#7875fd>6</font>：<b><font color=#6a379a>3</font></b>\n        <br>\n        <br><font color=#666666><b>步驟三</b></font> - 10減去個位數字<font color=#888800>7</font>：<b><font color=#aa7700>3</font></b>";
