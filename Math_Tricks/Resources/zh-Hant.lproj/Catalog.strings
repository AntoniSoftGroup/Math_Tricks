"trick_square_numbers_editing_in_25_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>325</font><small><sup>2</sup></small> = 105625</b>\n        <br>\n        <br><font color=#666666><b>步驟一</b></font> - <b><font color=#c27171>325</font> = <font color=#7875fd>3</font>_25 => <font color=#7875fd>3</font></b>\n        <br>\n        <br><font color=#666666><b>步驟二</b></font> - 將<font color=#666666><b>步驟一</b></font>的結果平方：<br><b><font color=#7875fd>3</font><small><sup>2</sup></small> = <font color=#008800>9</font></b>\n        <br>\n        <br><font color=#666666><b>步驟三</b></font> - 將<font color=#666666><b>步驟一</b></font>的結果除以2：<br><b><font color=#7875fd>3</font> / 2 = <font color=#888800>1.5</font></b>\n        <br>\n        <br><font color=#666666><b>步驟四</b></font> - 將<font color=#666666><b>步驟二</b></font>與<font color=#666666><b>步驟三</b></font>的結果相加：<br><b><font color=#008800>9</font> + <font color=#888800>1.5</font> = <font color=#6a379a>10.5</font></b>\n        <br>\n        <br><font color=#666666><b>步驟五</b></font> - 將<font color=#666666><b> 步驟四</b></font>的結果乘以10：<br><b><font color=#6a379a>10.5</font> × 10 = <font color=#aa7700>105</font></b>\n        <br>\n        <br><font color=#666666><b>步驟六</b></font> - 在<font color=#666666><b>步驟五</b></font>的結果後面放上625：<br><b><font color=#aa7700>105</font>_625 = 105625</b>";
"trick_square_numbers_editing_in_25_text" = "尾數為25的數的平方";
"trick_square_numbers_editing_in_5_rule" = "trick_square_numbers_editing_in_5_rule";
"trick_square_numbers_editing_in_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>3</font>5<small><sup>2</sup></small> = 1225</b>\n        <br>\n        <br><font color=#666666><b>步驟一</b></font> - 將待平方數十位數的數字與十位數的數字加1相乘：<br><b><font color=#c27171>3</font> × (<font color=#c27171>3</font> + 1) = <font color=#7875fd>12</font></b>\n        <br>\n        <br><font color=#666666><b>步驟二</b></font> - 在<font color=#666666><b>步驟一</b></font>的結果後面放上25：<br><b><font color=#7875fd>12</font>_25 = 1225</b>";
