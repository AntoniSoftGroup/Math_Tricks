"trick_adding_numbers_close_to_hundreds_rule" = "trick_adding_numbers_close_to_hundreds_rule";
"trick_adding_numbers_close_to_hundreds_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>159</font> + <font color=#7875fd>192</font> = 351</b>\n        <br>\n        <br><font color=#666666><b>步驟一</b></font> - 將接近一百倍數的數四捨五入至一百的倍數：<br><b><font color=#7875fd>192</font> + <font color=#008800>8</font> = <font color=#aa7700>200</font></b>\n        <br>\n        <br><font color=#666666><b>步驟二</b></font> - 將<font color=#666666><b>步驟一</b></font>的結果與另一數相加：<br><b><font color=#aa7700>200</font> + <font color=#c27171>159</font> = <font color=#6a379a>359</font></b>\n        <br>\n        <br><font color=#666666><b>步驟三</b></font> - 將<font color=#666666><b>步驟二</b></font>的結果加上或減去四捨五入的差平衡：<br><b><font color=#6a379a>359</font> - <font color=#008800>8</font> = 351</b>";
"trick_adding_numbers_close_to_hundreds_text" = "接近100倍數的加法";
