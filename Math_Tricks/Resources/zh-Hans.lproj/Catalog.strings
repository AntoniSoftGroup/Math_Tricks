"trick_multiplication_text" = "乘法";
"trick_multiply_by_025_rule" = "trick_multiply_by_025_rule";
"trick_multiply_by_025_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>20</font> × 0.25 = 5</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被除数除以4: <br><b><font color=#c27171>20</font> / 4 = 5</b>";
"trick_multiply_by_025_text" = "任意数乘以0.25";
"trick_multiply_by_02_rule" = "trick_multiply_by_02_rule";
"trick_multiply_by_02_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>125</font> × 0.2 = 25</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被除数除以10: <br><b><font color=#c27171>125</font> / 10 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将上一步的结果再乘以2: <br><b><font color=#7875fd>12.5</font> × 2 = 25</b>";
"trick_multiply_by_02_text" = "任意数乘以0.2";
"trick_multiply_by_05_rule" = "trick_multiply_by_05_rule";
"trick_multiply_by_05_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 0.5 = 9</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被除数除以2: <br><b><font color=#c27171>18</font> / 2 = 9</b>";
"trick_multiply_by_05_text" = "任意数乘以0.5";
"trick_multiply_by_11_2digit_rule" = "trick_multiply_by_11_2digit_rule";
"trick_multiply_by_11_2digit_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>3</font><font color=#7875fd>5</font> × 11 = 385</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数的十位数和个位数相加: <br><b><font color=#c27171>3</font> + <font color=#7875fd>5</font> = <font color=#008800>8</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将第一步的数字放到被乘数的十位数与个位数之间: <br><b><font color=#c27171>3</font>_<font color=#008800>8</font>_<font color=#7875fd>5</font> = 385</b>\n        <br>\n        <br>\n        <br><b><u>-2-</u></b>\n        <br>\n        <br><b><font color=#c27171>7</font><font color=#7875fd>8</font> × 11 = 858</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数的十位数和个位数相加: <br><b><font color=#c27171>7</font> + <font color=#7875fd>8</font> = <font color=#6a379a>1</font><font color=#aa7700>5</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 如果上一步的结果大于9就向被乘数的十位数加1以进一位: <br><b><font color=#c27171>7</font> + <font color=#6a379a>1</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将第一步的数字放到被乘数的新十位数与个位数之间: <br><b><font color=#888800>8</font>_<font color=#aa7700>5</font>_<font color=#7875fd>8</font> = 858</b>";
"trick_multiply_by_11_2digit_text" = "任意2位数乘11";
"trick_multiply_by_125_rule" = "trick_multiply_by_125_rule";
"trick_multiply_by_125_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 125 = 3125</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被除数除以8: <br><b><font color=#c27171>25</font> / 8 = <font color=#7875fd>3.125</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将上一步的结果再乘以1000: <br><b><font color=#7875fd>3.125</font> × 1000 = 3125</b>";
"trick_multiply_by_125_text" = "任意数乘以125";
"trick_multiply_by_12_rule" = "trick_multiply_by_12_rule";
"trick_multiply_by_12_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>12</font> = 192</b>\n        <br>\n        <br><b><font color=#888800>12</font> = <font color=#7875fd>10</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以2: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将第1步的结果与第2步的结果相加: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>32</font> = 192</b>";
"trick_multiply_by_12_text" = "任意数乘以12";
"trick_multiply_by_13_rule" = "trick_multiply_by_13_rule";
"trick_multiply_by_13_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>13</font> = 208</b>\n        <br>\n        <br><b><font color=#888800>13</font> = <font color=#7875fd>10</font> + <font color=#008800>3</font></b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以3: <br><b><font color=#c27171>16</font> × <font color=#008800>3</font> = <font color=#6a379a>48</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将第1步的结果与第2步的结果相加: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>48</font> = 208</b>";
"trick_multiply_by_13_text" = "任意数乘以13";
"trick_multiply_by_14_rule" = "trick_multiply_by_14_rule";
"trick_multiply_by_14_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>14</font> = 224</b>\n        <br>\n        <br><b><font color=#888800>14</font> = <font color=#7875fd>10</font> + <font color=#008800>4</font></b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#aa7700>160</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以4: <br><b><font color=#c27171>16</font> × <font color=#008800>4</font> = <font color=#6a379a>64</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将第1步的结果与第2步的结果相加: <br><b><font color=#aa7700>160</font> + <font color=#6a379a>64</font> = 224</b>";
"trick_multiply_by_14_text" = "任意数乘以14";
"trick_multiply_by_15_rule" = "trick_multiply_by_15_rule";
"trick_multiply_by_15_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 15 = 540</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以10: <br><b><font color=#c27171>36</font> × 10 = <font color=#7875fd>360</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将第1步的结果除以2: <br><b><font color=#7875fd>360</font> / 2 = <font color=#008800>180</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将第1步与第2步的结果相加: <br><b><font color=#7875fd>360</font> + <font color=#008800>180</font> = 540</b>";
"trick_multiply_by_15_text" = "任意数乘以15";
"trick_multiply_by_16_rule" = "trick_multiply_by_16_rule";
"trick_multiply_by_16_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>16</font> = 224</b>\n        <br>\n        <br><b><font color=#7875fd>16</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>1</font></b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以10: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以5: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将被乘数乘以1: <br><b><font color=#c27171>14</font> × <font color=#b265cf>1</font> = <font color=#c27171>14</font></b>\n        <br>\n        <br><font color=#666666><b>第 4 步</b></font> - <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#c27171>14</font> = 224</b>";
"trick_multiply_by_16_text" = "任意数乘以16";
"trick_multiply_by_17_rule" = "trick_multiply_by_17_rule";
"trick_multiply_by_17_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>14</font> × <font color=#7875fd>17</font> = 238</b>\n        <br>\n        <br><b><font color=#7875fd>17</font> = <font color=#888800>10</font> + <font color=#008800>5</font> + <font color=#b265cf>2</font></b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以10: <br><b><font color=#c27171>14</font> × <font color=#888800>10</font> = <font color=#aa7700>140</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以5: <br><b><font color=#c27171>14</font> × <font color=#008800>5</font> = <font color=#8c6745>70</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将被乘数乘以2: <br><b><font color=#c27171>14</font> × <font color=#b265cf>2</font> = <font color=#008888>28</font></b>\n        <br>\n        <br><font color=#666666><b>第 4 步</b></font> - <br><b><font color=#aa7700>140</font> + <font color=#8c6745>70</font> + <font color=#008888>28</font> = 238</b>";
"trick_multiply_by_17_text" = "任意数乘以17";
"trick_multiply_by_18_rule" = "trick_multiply_by_18_rule";
"trick_multiply_by_18_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>18</font> = 288</b>\n        <br>\n        <br><b><font color=#888800>18</font> = <font color=#7875fd>20</font> - <font color=#aa7700>2</font></b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以20: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以2: <br><b><font color=#c27171>16</font> × <font color=#aa7700>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将被减数减去上一步的结果: <br><b><font color=#008888>320</font> - <font color=#6a379a>32</font> = 288</b>";
"trick_multiply_by_18_text" = "任意数乘以18";
"trick_multiply_by_19_rule" = "trick_multiply_by_19_rule";
"trick_multiply_by_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>19</font> = 304</b>\n        <br>\n        <br><b><font color=#888800>19</font> = <font color=#7875fd>20</font> - <font color=#aa7700>1</font></b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以20: <br><b><font color=#c27171>16</font> × <font color=#7875fd>20</font> = <font color=#008888>320</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以1: <br><b><font color=#c27171>16</font> × <font color=#aa7700>1</font> = <font color=#6a379a>16</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将被减数减去上一步的结果: <br><b><font color=#008888>320</font> - <font color=#6a379a>16</font> = 304</b>";
"trick_multiply_by_19_text" = "任意数乘以19";
"trick_multiply_by_20_rule" = "trick_multiply_by_20_rule";
"trick_multiply_by_20_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>36</font> × 20 = 720</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以2: <br><b><font color=#c27171>36</font> × 2 = <font color=#7875fd>72</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将上一步的结果再乘以10: <br><b><font color=#7875fd>72</font> × 10 = 720</b>";
"trick_multiply_by_20_text" = "任意数乘以20";
"trick_multiply_by_250_rule" = "trick_multiply_by_250_rule";
"trick_multiply_by_250_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 250 = 6250</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被除数除以4: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将上一步的结果再乘以1000: <br><b><font color=#7875fd>6.25</font> × 1000 = 6250</b>";
"trick_multiply_by_250_text" = "任意数乘以250";
"trick_multiply_by_25_rule" = "trick_multiply_by_25_rule";
"trick_multiply_by_25_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 25 = 450</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被除数除以4: <br><b><font color=#c27171>18</font> / 4 = <font color=#7875fd>4.5</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将上一步的结果再乘以100: <br><b><font color=#7875fd>4.5</font> × 100 = 450</b>";
"trick_multiply_by_25_text" = "任意数乘以25";
"trick_multiply_by_2_rule" = "trick_multiply_by_2_rule";
"trick_multiply_by_2_rule_text" = "-1";
"trick_multiply_by_2_text" = "任意数乘以2";
"trick_multiply_by_3_rule" = "trick_multiply_by_3_rule";
"trick_multiply_by_3_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>32</font> × <font color=#888800>3</font> = 96</b>\n        <br>\n        <br><b><font color=#888800>3</font> = <font color=#7875fd>2</font> + <font color=#008800>1</font></b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以2: <br><b><font color=#c27171>32</font> × <font color=#7875fd>2</font> = <font color=#aa7700>64</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以1: <br><b><font color=#c27171>32</font> × <font color=#008800>1</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将第1步的结果与第2步的结果相加: <br><b><font color=#aa7700>64</font> + <font color=#6a379a>32</font> = 96</b>";
"trick_multiply_by_3_text" = "任意数乘以3";
"trick_multiply_by_4_rule" = "trick_multiply_by_4_rule";
"trick_multiply_by_4_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>58</font> × 4 = 232</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以2: <br><b><font color=#c27171>58</font> × 2 = <font color=#7875fd>116</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将上一步的结果再乘以2: <br><b><font color=#7875fd>116</font> × 2 = 232</b>";
"trick_multiply_by_4_text" = "任意数乘以4";
"trick_multiply_by_500_rule" = "trick_multiply_by_500_rule";
"trick_multiply_by_500_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 500 = 12500</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被除数除以2: <br><b><font color=#c27171>25</font> / 2 = <font color=#7875fd>12.5</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将上一步的结果再乘以1000: <br><b><font color=#7875fd>12.5</font> × 1000 = 12500</b>";
"trick_multiply_by_500_text" = "任意数乘以500";
"trick_multiply_by_50_rule" = "trick_multiply_by_50_rule";
"trick_multiply_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 50 = 900</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被除数除以2: <br><b><font color=#c27171>18</font> / 2 = <font color=#7875fd>9</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将上一步的结果再乘以100: <br><b><font color=#7875fd>9</font> × 100 = 900</b>";
"trick_multiply_by_50_text" = "任意数乘以50";
"trick_multiply_by_5_rule" = "trick_multiply_by_5_rule";
"trick_multiply_by_5_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1234</font> × 5 = 6170</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数除以2: <br><b><font color=#c27171>1234</font> / 2 = <font color=#7875fd>617</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将第1步的结果乘以10: <br><b><font color=#7875fd>617</font> × 10 = 6170</b>";
"trick_multiply_by_5_text" = "任意数乘以5";
"trick_multiply_by_6_rule" = "trick_multiply_by_6_rule";
"trick_multiply_by_6_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>6</font> = 96</b>\n        <br>\n        <br><b><font color=#888800>6</font> = 5 + 1 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>1</font></b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被除数除以2: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以10: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将被乘数乘以1: <br><b><font color=#c27171>16</font> × <font color=#008800>1</font> = <font color=#c27171>16</font></b>\n        <br>\n        <br><font color=#666666><b>第 4 步</b></font> - 将第2步的结果与第3步的结果相加: <br><b><font color=#008888>80</font> + <font color=#c27171>16</font> = 96</b>";
"trick_multiply_by_6_text" = "任意数乘以6";
"trick_multiply_by_750_rule" = "trick_multiply_by_750_rule";
"trick_multiply_by_750_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 750 = 18750</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被除数除以4: <br><b><font color=#c27171>25</font> / 4 = <font color=#7875fd>6.25</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以3: <br><b><font color=#7875fd>6.25</font> × 3 = <font color=#aa7700>18.75</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将被乘数乘以1000: <br><b><font color=#aa7700>18.75</font> × 1000 = 18750</b>";
"trick_multiply_by_750_text" = "任意数乘以750";
"trick_multiply_by_75_rule" = "trick_multiply_by_75_rule";
"trick_multiply_by_75_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>68</font> × 75 = 5100</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被除数除以4: <br><b><font color=#c27171>68</font> / 4 = <font color=#7875fd>17</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以3: <br><b><font color=#7875fd>17</font> × 3 = <font color=#aa7700>51</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将被乘数乘以100: <br><b><font color=#aa7700>51</font> × 100 = 5100</b>";
"trick_multiply_by_75_text" = "任意数乘以75";
"trick_multiply_by_7_rule" = "trick_multiply_by_7_rule";
"trick_multiply_by_7_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>7</font> = 112</b>\n        <br>\n        <br><b><font color=#888800>7</font> = 5 + 2 = <font color=#7875fd>10</font> / <font color=#aa7700>2</font> + <font color=#008800>2</font></b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被除数除以2: <br><b><font color=#c27171>16</font> / <font color=#aa7700>2</font> = <font color=#6a379a>8</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以10: <br><b><font color=#6a379a>8</font> × <font color=#7875fd>10</font> = <font color=#0088888>80</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将被乘数乘以2: <br><b><font color=#c27171>16</font> × <font color=#008800>2</font> = <font color=#8c6745>32</font></b>\n        <br>\n        <br><font color=#666666><b>第 4 步</b></font> - 将第2步的结果与第3步的结果相加: <br><b><font color=#008888>80</font> + <font color=#8c6745>32</font> = 112</b>";
"trick_multiply_by_7_text" = "任意数乘以7";
"trick_multiply_by_8_rule" = "trick_multiply_by_8_rule";
"trick_multiply_by_8_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>16</font> × <font color=#888800>8</font> = 128</b>\n        <br>\n        <br><b><font color=#888800>8</font> = <font color=#7875fd>10</font> - <font color=#aa7700>2</font></b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以10: <br><b><font color=#c27171>16</font> × <font color=#7875fd>10</font> = <font color=#008888>160</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将被乘数乘以2: <br><b><font color=#c27171>16</font> × <font color=#aa7700>2</font> = <font color=#6a379a>32</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将被减数减去上一步的结果: <br><b><font color=#008888>160</font> - <font color=#6a379a>32</font> = 128</b>";
"trick_multiply_by_8_text" = "任意数乘以8";
"trick_multiply_by_999_rule" = "trick_multiply_by_999_rule";
"trick_multiply_by_999_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>25</font> × 999 = 24975</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以1000: <br><b><font color=#c27171>25</font> × 1000 = <font color=#7875fd>25000</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 再把上一步的结果减去被乘数: <br><b><font color=#7875fd>25000</font> - <font color=#c27171>25</font> = 24975</b>";
"trick_multiply_by_999_text" = "任意数乘以999";
"trick_multiply_by_99_rule" = "trick_multiply_by_99_rule";
"trick_multiply_by_99_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>15</font> × 99 = 1485</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以100: <br><b><font color=#c27171>15</font> × 100 = <font color=#7875fd>1500</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 再把上一步的结果减去被乘数: <br><b><font color=#7875fd>1500</font> - <font color=#c27171>15</font> = 1485</b>";
"trick_multiply_by_99_text" = "任意数乘以99";
"trick_multiply_by_9_rule" = "trick_multiply_by_9_rule";
"trick_multiply_by_9_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>56</font> × 9 = 504</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将被乘数乘以10: <br><b><font color=#c27171>56</font> × 10 = <font color=#7875fd>560</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 再把上一步的结果减去被乘数: <br><b><font color=#7875fd>560</font> - <font color=#c27171>56</font> = 504</b>";
"trick_multiply_by_9_text" = "任意数乘以9";
"trick_multiply_numbers_between_11_and_19_rule" = "trick_multiply_numbers_between_11_and_19_rule";
"trick_multiply_numbers_between_11_and_19_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>1<font color=#c27171>4</font> × <font color=#7875fd>1</font><font color=#008800>8</font> = 252</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将较大的一个乘数加上另一个乘数的个位数: <br><b><font color=#7875fd>1</font><font color=#008800>8</font> + <font color=#c27171>4</font> = <font color=#6a379a>22</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将上一步的结果后面加一个0: <br><b><font color=#6a379a>22</font> × 10 = <font color=#888800>220</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将两个乘数的个位数相乘: <br><b><font color=#008800>8</font> x <font color=#c27171>4</font> = <font color=#aa7700>32</font></b>\n        <br>\n        <br><font color=#666666><b>第 4 步</b></font> - 将上两步的结果相加: <br><b><font color=#888800>220</font> + <font color=#aa7700>32</font> = 252</b>";
"trick_multiply_numbers_between_11_and_19_text" = "11~19的乘法";
"trick_multiply_two_digit_numbers_editing_in_1_rule" = "trick_multiply_two_digit_numbers_editing_in_1_rule";
"trick_multiply_two_digit_numbers_editing_in_1_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>5</font>1 × <font color=#7875fd>3</font>1 = 1581</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将两个乘数的10位数相乘: <br><b><font color=#c27171>5</font> × <font color=#7875fd>3</font> = <font color=#008800>15</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将两个乘数的10位数相加: <br><b><font color=#c27171>5</font> + <font color=#7875fd>3</font> = <font color=#888800>8</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将第1步的结果放在第2步结果前: <br><b><font color=#008800>15</font>_<font color=#888800>8</font> = 158</b>\n        <br>\n        <br><font color=#666666><b>第 4 步</b></font> - 将1放在第3步结果后: <br><b><font color=#008800>15</font>_<font color=#888800>8</font>_1 = 1581</b>";
"trick_multiply_two_digit_numbers_editing_in_1_text" = "两个个位数都为1的两位数相乘";
"trick_multiply_two_digit_numbers_having_same_tens_rule" = "trick_multiply_two_digit_numbers_having_same_tens_rule";
"trick_multiply_two_digit_numbers_having_same_tens_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>2</font><font color=#7875fd>3</font> × <font color=#c27171>2</font><font color=#008800>7</font> = 621</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 将乘数的十位数乘以自身加1: <br><b><font color=#c27171>2</font> × (<font color=#c27171>2</font> + 1) = <font color=#6a379a>6</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 将两个乘数的个位数相乘 (如果结果是个位数，在结果前面添一个0): <br><b><font color=#7875fd>3</font> × <font color=#008800>7</font> = <font color=#888800>21</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将第1步的结果放在第2步结果前: <br><b><font color=#6a379a>6</font>_<font color=#888800>21</font> = 621</b>";
"trick_multiply_two_digit_numbers_having_same_tens_text" = "两个十位数相同的两位数相乘";
"trick_percent_2_rule" = "trick_percent_2_rule";
"trick_percent_2_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>6</font>% → 350 = 21</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - <font color=#c27171>6</font>% → 100 = <b><font color=#c27171>6</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - <font color=#c27171>6</font>% → 300 = <b><font color=#6a379a>18</font></b> (将上一步的结果乘以<font color=#7875fd>3</font>)\n        <br>\n        <br><i>[100 × <font color=#7875fd>3</font> = 300] → [<font color=#c27171>6</font> × <font color=#7875fd>3</font> = <font color=#6a379a>18</font>]</i>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - <font color=#c27171>6</font>% → 50 = <b><font color=#aa7700>3</font></b> (d将第1步的结果除以<font color=#888800>2</font>)\n        <br>\n        <br><i>[100 / <font color=#888800>2</font> = 50] → [<font color=#c27171>6</font> / <font color=#888800>2</font> = <font color=#aa7700>3</font>]</i>\n        <br>\n        <br><font color=#666666><b>第 4 步</b></font> - 将第2步与第3步的结果相加: <br><b><font color=#6a379a>18</font> + <font color=#aa7700>3</font> = 21</b>";
"trick_percent_2_text" = "百分比乘法技巧二";
"trick_percent_rule" = "trick_percent_rule";
"trick_percent_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>15% → <font color=#c27171>300</font> = 45</b>\n        <br>\n        <br><font color=#666666><b>第 1 步</b></font> - 计算 10% (除以10): <br><b><font color=#c27171>300</font> / 10 = <font color=#7875fd>30</font></b>\n        <br>\n        <br><font color=#666666><b>第 2 步</b></font> - 计算 5% (将第1步的结果除以2): <br><b><font color=#7875fd>30</font> / 2 = <font color=#008800>15</font></b>\n        <br>\n        <br><font color=#666666><b>第 3 步</b></font> - 将第1步的结果与第2步的结果相加: <br><b><font color=#7875fd>30</font> + <font color=#008800>15</font> = 45</b>";
"trick_percent_text" = "百分比乘法技巧一";
