"trick_multiply_by_500_text" = "Множанне на 500";
"trick_multiply_by_50_rule" = "trick_multiply_by_50_rule";
"trick_multiply_by_50_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>18</font> × 50 = 900</b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - Падзяліце лік на 2: <br><b><font color=#c27171>18</font> / 2 = <font color=#7875fd>9</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - Памножце вынік першага кроку на 100: <br><b><font color=#7875fd>9</font> × 100 = 900</b>";
