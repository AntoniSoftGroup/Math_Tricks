"trick_dividing_by_40_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>1280</font> / 40 = 32</b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - Падзяліце лік на 10: <br><b><font color=#c27171>1280</font> / 10 = <font color=#7875fd>128</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - Падзяліце вынік першага кроку на 4: <br><b><font color=#7875fd>128</font> / 4 = 32</b>";
"trick_dividing_by_40_text" = "Дзяленне на 40";
