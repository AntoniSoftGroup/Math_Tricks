"trick_subtracting_from_1000_rule" = "trick_subtracting_from_1000_rule";
"trick_subtracting_from_1000_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b>1000 - <font color=#c27171>5</font><font color=#7875fd>6</font><font color=#888800>7</font> = <font color=#008800>4</font><font color=#6a379a>3</font><font color=#aa7700>3</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - Адбярыце <font color=#c27171>5</font> ад 9: <b><font color=#008800>4</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - Адбярыце <font color=#7875fd>6</font> ад 9: <b><font color=#6a379a>3</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 3</b></font> - Адбярыце <font color=#888800>7</font> ад 10: <b><font color=#aa7700>3</font></b>";
"trick_subtracting_from_1000_text" = "Адніманне з 1000";
"trick_subtracting_numbers_close_to_hundreds_rule" = "trick_subtracting_numbers_close_to_hundreds_rule";
"trick_subtracting_numbers_close_to_hundreds_rule_text" = "<b><u>-1-</u></b>\n        <br>\n        <br><b><font color=#c27171>259</font> - <font color=#7875fd>192</font> = 67</b>\n        <br>\n        <br><font color=#666666><b>Крок 1</b></font> - Акругліце другое складнік да бліжэйшай сотні: <br><b><font color=#7875fd>192</font> + <font color=#008800>8</font> = <font color=#aa7700>200</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 2</b></font> - Адбярыце вынік першага кроку ад першага складаемага: <br><b><font color=#c27171>259</font> - <font color=#aa7700>200</font> = <font color=#6a379a>59</font></b>\n        <br>\n        <br><font color=#666666><b>Крок 3</b></font> - Дадайце лік, пры дапамозе якога акруглілі другое складнік, да выніку другога кроку: <br><b><font color=#6a379a>59</font> + <font color=#008800>8</font> = 67</b>";
"trick_subtracting_numbers_close_to_hundreds_text" = "Адніманне шляхам акруглення лікаў";
